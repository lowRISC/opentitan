name: "lowrisc:dv:nvm_otp_key_agent:0.1"
description: "UVM agent playing otp_ctrl on the NVM scrambling-key interface"
filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_utils
      - lowrisc:dv:dv_lib
      - lowrisc:ip:otp_ctrl_pkg
    files:
      - nvm_otp_key_if.sv
      - nvm_otp_key_agent_pkg.sv
      - nvm_otp_key_item.sv: {is_include_file: true}
      - nvm_otp_key_agent_cfg.sv: {is_include_file: true}
      - nvm_otp_key_agent_cov.sv: {is_include_file: true}
      - nvm_otp_key_monitor.sv: {is_include_file: true}
      - nvm_otp_key_sequencer.sv: {is_include_file: true}
      - nvm_otp_key_device_driver.sv: {is_include_file: true}
      - seq_lib/nvm_otp_key_seq_list.sv: {is_include_file: true}
      - seq_lib/nvm_otp_key_device_seq.sv: {is_include_file: true}
      - nvm_otp_key_agent.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
