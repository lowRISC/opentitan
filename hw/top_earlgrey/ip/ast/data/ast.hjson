    { struct:    "clks_osc_byp",
      type:      "uni",
      name:      "clk_osc_byp",
      act:       "rcv",
      package:   "ast_pkg",
      partition: "secondary",
      desc:      "Clocks' oscillator bypass for OS FPGA/Verilator (AST_BYPASS_CLK only)",
    },
    { struct:    "mubi4",
      type:      "uni",
      name:      "ext_freq_is_96m",
      act:       "rcv",
      package:   "prim_mubi_pkg",
      partition: "primary",
      desc:      "External clock frequency is 96MHz",
    },
    { struct:    "mubi4",
      type:      "uni",
      name:      "ext_freq_is_96m",
      act:       "rcv",
      package:   "prim_mubi_pkg",
      partition: "secondary",
      desc:      "External clock frequency is 96MHz",
    },
    { struct:    "mubi4",
      type:      "uni",
      name:      "all_clk_byp_req",
      act:       "rcv",
      package:   "prim_mubi_pkg",
      partition: "primary",
      desc:      "All clocks bypass request",
    },
    { struct:    "mubi4",
      type:      "uni",
      name:      "all_clk_byp_req",
      act:       "rcv",
      package:   "prim_mubi_pkg",
      partition: "secondary",
      desc:      "All clocks bypass request",
    },
    { struct:    "mubi4",
      type:      "uni",
      name:      "io_clk_byp_req",
      act:       "rcv",
      package:   "prim_mubi_pkg",
      partition: "primary",
      desc:      "IO clock bypass request (for OTP bootstrap)",
    },
    { struct:    "mubi4",
      type:      "uni",
      name:      "io_clk_byp_req",
      act:       "rcv",
      package:   "prim_mubi_pkg",
      partition: "secondary",
      desc:      "IO clock bypass request (for OTP bootstrap)",
    },

    //////////////////////////
    // Intra-IP connections //
    //////////////////////////
    { struct:    "s2p",
      type:      "uni",
      name:      "intraip_s2p",
      act:       "rcv",
      package:   "ast_intraip_pkg",
