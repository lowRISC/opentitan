      desc:      "Secondary-to-Primary partition communication",
    },
    { struct:    "p2s",
      type:      "uni",
      name:      "intraip_p2s",
      act:       "rcv",
      package:   "ast_intraip_pkg",
      partition: "secondary",
      desc:      "Primary-to-Secondary partition communication",
    },
  ],
  regwidth: "32",
  registers: [
    { name: "REGA0",
      desc: "AST Register 0 for OTP/ROM Write Testing",
      swaccess: "ro",
      hwaccess: "hro",
      tags: [ // don't write random data to any of the AST registers
