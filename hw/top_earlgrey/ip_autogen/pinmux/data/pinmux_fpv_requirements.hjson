        {
          name: REQ_USB_02a
          desc: '''`usb_dppullup_en` shall carry the module's pull-up enable that has the same role, unchanged and in the same cycle.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.external pinmux.usb_dppullup_en`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
