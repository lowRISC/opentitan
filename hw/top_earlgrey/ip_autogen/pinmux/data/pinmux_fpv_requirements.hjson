        }
        {
          name: REQ_USB_01d
          desc: '''`usbdev_wake_ack` shall reach the module's input that has the same role, unchanged and in the same cycle.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect usbdev.usb_aon_wake_ack`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["wake acknowledge in (assert_UsbConn_WakeAcknowledgeIn)"]
          why: '''The check compares the module's wake acknowledge port with `usbdev_wake_ack` in every cycle.'''
          milestone: "V2"
          priority: "2"
