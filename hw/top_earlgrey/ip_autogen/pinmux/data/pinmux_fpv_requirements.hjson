        {
          name: REQ_USB_02e
          desc: '''`usbdev_sense_lost` shall carry the one of the module's three events that has the same role, unchanged and in the same cycle.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect usbdev.usb_aon_sense_lost`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
