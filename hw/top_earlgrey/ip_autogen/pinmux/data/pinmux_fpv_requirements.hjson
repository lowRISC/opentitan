        {
          name: REQ_USB_02b
          desc: '''`usb_dnpullup_en` shall carry the module's pull-up enable that has the same role, unchanged and in the same cycle.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.external pinmux.usb_dnpullup_en`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
