          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_02f
          desc: '''`usbdev_wake_detect_active` shall carry the module's active state, unchanged and in the same cycle.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.usbdev_wake_detect_active`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["active out (assert_UsbConn_ActiveOut)"]
          why: '''The check compares `usbdev_wake_detect_active` with the module's `wake_detect_active_aon_o` port in every cycle. A value taken from another port, or a delayed value, fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_03
          desc: '''`usb_wkup_req` shall carry the module's wake request, unchanged and in the same cycle.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["wake request out (assert_UsbConn_WakeRequestOut)"]
          why: '''The check compares `usb_wkup_req` with the module's `wake_req_aon_o` port in every cycle. The comparison also covers a one-cycle pulse.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_04a
          desc: '''The module shall run on `clk_aon_i`.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[USB Wakeup Detection Module](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#usb-wakeup-detection-module)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["module on AON clock (assert_UsbConn_ModuleOnAonClock)"]
          why: '''The check compares the module's clock with `clk_aon_i` in every cycle. The proofs clock `clk_aon_i` slower than `clk_i`, so a module on `clk_i` fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_04b
          desc: '''The module shall be reset by `rst_aon_ni`.'''
          source: [
            '''[pinmux.hjson `clocking`](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["module on AON reset (check_UsbConn_ModuleOnAonReset)"]
          why: '''The check requires `rst_aon_ni` to drive the reset pin of every flop of the module.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_05a
          desc: '''The module's D+ input shall be the signal that the pinmux delivers to usbdev as its D+ input. That signal is the input of the USB D+ pad, which is a DIO pad.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[top_earlgrey.hjson `pinout.pads USB_P`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["bus inputs (assert_UsbConn_BusInputs)"]
          why: '''The check compares the module's D+ input with the USB D+ pad in every cycle. An input taken from the USB D- pad, from another pad or through a flop fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_05b
          desc: '''The module's D- input shall be the signal that the pinmux delivers to usbdev as its D- input. That signal is the input of the USB D- pad, which is a DIO pad.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[top_earlgrey.hjson `pinout.pads USB_N`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["bus inputs (assert_UsbConn_BusInputs)"]
          why: '''The check compares the module's D- input with the USB D- pad in every cycle. An input taken from the USB D+ pad, from another pad or through a flop fails the check.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_05c
          desc: '''The module's VBUS input shall be the signal that the pinmux delivers to usbdev as its VBUS input. That signal is the muxed input `sense` after its input select.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[top_earlgrey.hjson `pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `pinmux.signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_conn"
          checks: ["bus inputs (assert_UsbConn_BusInputs)"]
          why: '''The check compares the module's VBUS input with usbdev's sense input in every cycle. The check takes the sense input after its input select.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06a
          desc: '''While the module is inactive, a suspend request shall make it active within a bounded time.'''
          source: [
            '''[Suspending](hw/ip/usbdev/doc/wake_resume.md#suspending)'''
            '''[usbdev.hjson `wake_control.suspend_req`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the length of the bound.'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["request activates (assert_UsbModule_RequestActivates)"]
          why: '''The check requires `usbdev_wake_detect_active` to be 1 within 2 AON clock cycles of each suspend request that comes while the module is inactive.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06b
          desc: '''While the module is active, a wake acknowledge shall make it inactive within a bounded time.'''
          source: [
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[usbdev.hjson `wake_control.wake_ack`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the length of the bound.'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["acknowledge releases (assert_UsbModule_AcknowledgeReleases)"]
          why: '''The check requires `usbdev_wake_detect_active` to be 0 within 2 AON clock cycles of each wake acknowledge that comes while the module is active.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06c
          desc: '''Only a suspend request made while the module is inactive shall make the module active. Only a wake acknowledge made while the module is active shall make the module inactive.'''
          source: [
            '''[Suspending](hw/ip/usbdev/doc/wake_resume.md#suspending)'''
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[usbdev.hjson `wake_control.suspend_req`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_control.wake_ack`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["no other state change (assert_UsbModule_NoOtherStateChange)"]
          why: '''The check allows `usbdev_wake_detect_active` to rise only after a suspend request, and to fall only after a wake acknowledge.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06d
          desc: '''While the module is inactive, each pad pull-up enable (`usb_dppullup_en` and `usb_dnpullup_en`) shall equal usbdev's pull-up enable for the same line, in the same cycle.'''
          source: [
            '''[AON/Wake Interface Pins](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-interface-pins)'''
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[usbdev.hjson `wake_control.wake_ack`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["inactive passes pull-ups (assert_UsbModule_InactivePassesPullUps)"]
          why: '''In every cycle that the module is inactive, the check compares each pull-up enable to the pads with usbdev's enable of the same line.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06e
          desc: '''While the module is active and `usbdev_sense_lost` is 0, each pad pull-up enable shall keep the value that usbdev's pull-up enable for the same line had at the suspend request that made the module active.'''
          source: [
            '''[Overview](hw/ip/usbdev/doc/wake_resume.md#overview)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[chip_usbdev_testplan.hjson `chip_sw_usbdev_aon_pullup`](hw/top_earlgrey/data/ip/chip_usbdev_testplan.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["active holds pull-ups (assert_UsbModule_ActiveHoldsPullUps)", "waits: pull-ups after VBUS loss"]
          why: '''In every cycle that the module is active and `usbdev_sense_lost` is 0, the check requires each pull-up enable to the pads to equal usbdev's enable of its line at the suspend request. No specification says what the pull-ups do after VBUS is lost.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06f
          desc: '''While the module is active, each of three conditions that is held on the USB lines shall set its event within a bounded time. The three conditions are bus not idle, bus reset (D+ and D- both low) and sense lost (VBUS low).'''
          source: [
            '''[Optional external AON/Wake functionality](hw/ip/usbdev/doc/theory_of_operation.md#optional-external-aonwake-functionality)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
            '''[usbdev.hjson `wake_events.disconnected`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_reset`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_not_idle`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[usbdev_testplan.hjson `aon_wake_resume`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_reset`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_disconnect`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the length of the bound, and the idle state of the lines while no pull-up enable is 1 or both are 1.'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["held condition sets event (assert_UsbModule_HeldConditionSetsEvent)"]
          why: '''The check requires each event to be 1 once its condition has been on the USB lines in one cycle and in each of the 8 cycles after it.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06g
          desc: '''The module shall set an event only after the event's own condition has been on the USB lines, with the module active, for at least the shortest time that the module must report.'''
          source: [
            '''[usbdev.hjson `wake_events.disconnected`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_reset`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[usbdev.hjson `wake_events.bus_not_idle`](hw/ip/usbdev/data/usbdev.hjson)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[AON/Wake Clocking](hw/ip/usbdev/doc/theory_of_operation.md#aonwake-clocking)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["event only after its condition (assert_UsbModule_EventOnlyAfterItsCondition)", "waits: short condition sets no event"]
          why: '''The check allows an event to rise only on its own condition. The condition must be seen while the module is active, and the module must stay active from then until the rise. No specification gives the shortest time that a condition must last.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06h
          desc: '''An event, once set, shall stay set for as long as the module stays active.'''
          source: [
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["event holds while active (assert_UsbModule_EventHoldsWhileActive)"]
          why: '''The check requires an event that is 1 to stay 1 in the next cycle while the module stays active. The check applies at every value of the USB lines.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06i
          desc: '''A wake acknowledge made while the module is active shall clear each of the three events within a bounded time.'''
          source: [
            '''[Resuming](hw/ip/usbdev/doc/wake_resume.md#resuming)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the length of the bound.'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["acknowledge clears events (assert_UsbModule_AcknowledgeClearsEvents)"]
          why: '''After each wake acknowledge that comes while the module is active, the check requires each of the three events to be 0 in one of the next 4 AON clock cycles.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_USB_06j
          desc: '''The module's wake request shall be 1 while at least one of its three events is set, and 0 while none of them is set.'''
          source: [
            '''[Overview](hw/ip/usbdev/doc/wake_resume.md#overview)'''
            '''[usbdev_testplan.hjson `aon_wake_resume`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_reset`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[usbdev_testplan.hjson `aon_wake_disconnect`](hw/ip/usbdev/data/usbdev_testplan.hjson)'''
            '''[Inter-Module Signals](hw/ip/usbdev/doc/interfaces.md#inter-module-signals)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[Wakeup Recording](hw/top_earlgrey/ip_autogen/pwrmgr/doc/theory_of_operation.md#wakeup-recording)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_usb_wakeup`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the delay from the events to the request.'''
          ]
          kind: "spec"
          testpoint: "usb_module"
          checks: ["wake request follows events (assert_UsbModule_WakeRequestFollowsEvents)"]
          why: '''The check compares `usb_wkup_req` with the three events in every cycle. The check requires `usb_wkup_req` to be 1 when at least one event is 1, and 0 when none is.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Strap sampling'''
      conditions: [
        '''The TAP straps are seen through the TAP that is connected (TAP selection and the JTAG pads).'''
        '''Full reset and NDM reset are defined in the Terms.'''
        '''The life cycle conditions follow the table of life cycle states ([Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)), after the delay of the input synchronizers.'''
        '''The top description assigns the TAP strap 0 pad and the TAP strap 1 pad, which the table Pads by role lists.'''
      ]
      requirements: [
        {
          name: REQ_STRAP_01
          desc: '''At each `strap_en_i` pulse, TAP strap 0 shall take the value of the TAP strap 0 pad, if `dft_hold_tap_sel_i` is 0. This holds in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap0`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["pulse samples the straps (assert_Strap_PulseSamplesTheStraps)"]
          why: '''The check compares strap 0 after a strap pulse with the TAP strap 0 pad. The check accepts the value of the pad in the pulse cycle or in the cycle after it.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_02a
          desc: '''At a `strap_en_i` pulse, TAP strap 1 shall take the value of the TAP strap 1 pad, if `dft_hold_tap_sel_i` is 0 and `lc_hw_debug_en_i` is On. `REQ_STRAP_03` states the one exception.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap1`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["pulse samples the straps (assert_Strap_PulseSamplesTheStraps)"]
          why: '''When `lc_hw_debug_en_i` is steadily On at a strap pulse, the check compares strap 1 after the pulse with the TAP strap 1 pad. The check accepts the value of the pad in the pulse cycle or in the cycle after it.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_02b
          desc: '''At each `strap_en_i` pulse, TAP strap 1 shall keep its value, if `lc_hw_debug_en_i` is not On. `REQ_STRAP_03` states the one exception.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tap1`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["pulse samples the straps (assert_Strap_PulseSamplesTheStraps)"]
          why: '''When neither `lc_hw_debug_en_i` nor `lc_dft_en_i` was On before a strap pulse, the check requires strap 1 to be unchanged after the pulse.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_03
          desc: '''While `lc_dft_en_i` is On and `dft_hold_tap_sel_i` is 0, each TAP strap shall take the value that its pad had in the cycle before. TAP strap 0 is sampled from the TAP strap 0 pad, and TAP strap 1 is sampled from the TAP strap 1 pad.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps follow the pads (assert_Strap_StrapsFollowThePads)"]
          why: '''While `lc_dft_en_i` is steadily On, the check compares strap 0 with the value of the TAP strap 0 pad in the cycle before. The check compares strap 1 with the TAP strap 1 pad in the same way.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_04
          desc: '''While `dft_hold_tap_sel_i` is 1, the TAP straps shall keep their values. This holds at a `strap_en_i` pulse too.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps hold (assert_Strap_StrapsHold)"]
          why: '''While `dft_hold_tap_sel_i` is 1, the check requires both straps to be unchanged in the next cycle. The check requires this at a strap pulse too, and while `lc_dft_en_i` is On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_05
          desc: '''In a cycle without a `strap_en_i` pulse, the TAP straps shall keep their values. `REQ_STRAP_03` states the one exception, which applies while `lc_dft_en_i` is On and `dft_hold_tap_sel_i` is 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps hold (assert_Strap_StrapsHold)"]
          why: '''The check applies in a cycle without a strap pulse when `lc_dft_en_i` was On in neither of the two cycles before. In such a cycle, the check requires both straps to be unchanged and allows the pads to take any value.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_06
          desc: '''A TAP strap that has not been sampled since the last full reset shall read 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "strap"
          checks: ["unsampled strap reads 0 (assert_Strap_UnsampledStrapReads0)", "pulse samples the straps (assert_Strap_PulseSamplesTheStraps)", "straps hold (assert_Strap_StrapsHold)"]
          why: '''The check _unsampled strap reads 0_ requires both straps to be 0 from a full reset until a sample. The other two checks require a strap 1 that was never sampled to stay at 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_07
          desc: '''An NDM reset shall leave both TAP straps unchanged.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Reset Request Handling](hw/top_earlgrey/ip_autogen/pwrmgr/doc/theory_of_operation.md#reset-request-handling)'''
            '''[System Reset Tree](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#system-reset-tree)'''
            '''[Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps outside NDM reset (check_Strap_StrapsOutsideNdmReset)"]
          why: '''The check fails when `rst_ni` or `rst_aon_ni` reaches the reset pin or the input cone of a flop that holds a sampled TAP strap. An NDM reset asserts these two resets.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_STRAP_08
          desc: '''While the parameter `SecVolatileRawUnlockEn` is 0, `strap_en_override_i` shall not change the straps.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `param_list` SecVolatileRawUnlockEn](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[Volatile `RAW` -> `TEST_UNLOCKED0` Transition](hw/ip/lc_ctrl/doc/programmers_guide.md#volatile-raw---test_unlocked0-transition)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "strap"
          checks: ["straps hold (assert_Strap_StrapsHold)"]
          why: '''With `strap_en_override_i` free in every cycle, the check requires the straps to be unchanged in each cycle in which no sample is due.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Latched debug enable'''
      conditions: [
        '''The latch, On and Off are defined in the Terms.'''
      ]
      requirements: [
        {
          name: REQ_DBG_01a
          desc: '''At each `strap_en_i` pulse, the latch shall take the value On if `lc_hw_debug_en_i` is On. `REQ_DBG_09` states the one exception.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)"]
          why: '''At a strap pulse with `lc_hw_debug_en_i` steadily On and the clear inputs at Off, the check compares `pinmux_hw_debug_en_o` with On in the next cycle.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_01b
          desc: '''At each `strap_en_i` pulse, the latch shall take the value Off if `lc_hw_debug_en_i` is not On.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)", "On only at a pulse (assert_Latch_OnOnlyAtAPulse)"]
          why: '''The check _pulse samples debug enable_ requires the latch to be Off after a strap pulse with the debug enable not On. The check _On only at a pulse_ allows a rise to On only at a strap pulse with the debug enable On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_02
          desc: '''The latch shall keep its value in each cycle with no `strap_en_i` pulse, no clear and no full reset. This holds through an NDM reset too.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[System Reset Tree](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#system-reset-tree)'''
            '''[Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["latch holds (assert_Latch_LatchHolds)", "latch outside NDM reset (check_Latch_LatchOutsideNdmReset)"]
          why: '''The check _latch holds_ requires the output to keep its value. The check _latch outside NDM reset_ fails when `rst_ni` or `rst_aon_ni`, which an NDM reset asserts, reaches the reset pin or input cone of a latch flop.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_03
          desc: '''Any value other than Off on `lc_hw_debug_clr_i` shall turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[lc_ctrl.hjson `inter_signal_list` lc_hw_debug_clr](hw/ip/lc_ctrl/data/lc_ctrl.hjson)'''
            '''[HW_DEBUG_CLR](hw/ip/lc_ctrl/doc/theory_of_operation.md#hw_debug_clr)'''
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''The check requires the latch to be Off one cycle after `lc_hw_debug_clr_i` has held a value other than Off for two cycles. The value On counts as other than Off.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_04
          desc: '''Any value other than Off on `lc_check_byp_en_i` shall turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''The check requires the latch to be Off one cycle after `lc_check_byp_en_i` has held a value other than Off for two cycles. The value On counts as other than Off.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_05
          desc: '''Any value other than Off on `lc_escalate_en_i` shall turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''The check requires the latch to be Off one cycle after `lc_escalate_en_i` has held any of its 15 values other than Off for two cycles.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_06
          desc: '''The value Off on `lc_hw_debug_clr_i` and on `lc_check_byp_en_i` shall not turn the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["latch holds (assert_Latch_LatchHolds)", "pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)"]
          why: '''Both checks apply with `lc_hw_debug_clr_i` and `lc_check_byp_en_i` at Off. The checks require the output to hold outside a strap pulse (_latch holds_) and to be On after a sample of On (_pulse samples debug enable_).'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_07a
          desc: '''`pinmux_hw_debug_en_o` shall be On while the latch is On.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `countermeasures` PINMUX_HW_DEBUG_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["output On or Off (assert_Latch_OutputOnOrOff)", "pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)", "latch holds (assert_Latch_LatchHolds)"]
          why: '''The checks _pulse samples debug enable_ and _latch holds_ require the output to be On after a sample of On and while the latch holds On. The check _output On or Off_ rejects any value but On and Off.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_07b
          desc: '''`pinmux_hw_debug_en_o` shall be Off while the latch is not On.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `countermeasures` PINMUX_HW_DEBUG_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["output On or Off (assert_Latch_OutputOnOrOff)", "On only at a pulse (assert_Latch_OnOnlyAtAPulse)", "clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''The check _output On or Off_ rejects any value but On and Off. The check _On only at a pulse_ rejects an On not taken at a strap pulse. The check _clear turns Off_ rejects any value but Off after a clear.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_08
          desc: '''After a full reset, the latch shall be Off until the next `strap_en_i` pulse.'''
          source: [
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[lc_ctrl.hjson `inter_signal_list` lc_hw_debug_en](hw/ip/lc_ctrl/data/lc_ctrl.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["Off from full reset (assert_Latch_OffFromFullReset)", "On only at a pulse (assert_Latch_OnOnlyAtAPulse)"]
          why: '''The check _Off from full reset_ requires the latch to be Off in full reset. The check _On only at a pulse_ rejects any rise to On before a strap pulse at which the debug enable is On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_DBG_09
          desc: '''A clear in the same cycle as a `strap_en_i` pulse shall leave the latch Off.'''
          source: [
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "latch"
          checks: ["clear turns Off (assert_Latch_ClearTurnsOff)"]
          why: '''The check applies to a strap pulse when a clear input held a value other than Off in both of the two cycles before the pulse. The check then requires the latch to be Off in the next cycle, even with `lc_hw_debug_en_i` On.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''TAP selection and the JTAG pads'''
      conditions: [
        '''The JTAG pads are the TCK pad, the TMS pad, the TDI pad, the TRST_N pad and the TDO pad, which the top description assigns ([top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)) and the table Pads by role lists.'''
        '''The rows hold once the TAP straps and the life cycle inputs have kept their values for the delay of the input synchronizers.'''
        '''The rows do not hold for TRST_N while scan mode is on.'''
        '''Two documents disagree on the attributes of a JTAG pad that a TAP owns. The theory of operation says "all-zero" ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)), and the assertion `MioJtagAttrO_A` of the existing testplan keeps the Schmitt trigger on. REQ_TAP_08 follows the theory of operation.'''
      ]
      requirements: [
        {
          name: REQ_TAP_01a
          desc: '''While the TAP straps are 01, the TCK of `lc_jtag_o` shall carry the input of the TCK pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''The check compares the `tck` field of `lc_jtag_o` with the TCK pad in the same cycle. The check does this in every life cycle state and in scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_01b
          desc: '''While the TAP straps are 01, the TMS of `lc_jtag_o` shall carry the input of the TMS pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''The check compares the `tms` field of `lc_jtag_o` with the TMS pad in the same cycle. The check does this in every life cycle state and in scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_01c
          desc: '''While the TAP straps are 01, the TDI of `lc_jtag_o` shall carry the input of the TDI pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''The check compares the `tdi` field of `lc_jtag_o` with the TDI pad in the same cycle. The check does this in every life cycle state and in scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_01d
          desc: '''While the TAP straps are 01, the TRST_N of `lc_jtag_o` shall carry the input of the TRST_N pad, in every life cycle state.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.lc_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''Outside scan mode, the check compares the `trst_n` field of `lc_jtag_o` with the TRST_N pad in the same cycle. In scan mode, no specification names the reset that `trst_n` follows.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_02a
          desc: '''While the TAP straps are 10 and the latch is On, `rv_jtag_o` shall carry the inputs of the TCK pad, the TMS pad, the TDI pad and the TRST_N pad.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rv_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''With TAP straps 10 and `pinmux_hw_debug_en_o` On, the check compares `rv_jtag_o` with the JTAG pads in the same cycle. The check compares the `trst_n` field only outside scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_02b
          desc: '''While the TAP straps are 10 and the latch is Off, `rv_jtag_o` shall not carry the inputs of the TCK pad, the TMS pad, the TDI pad and the TRST_N pad.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rv_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''With TAP straps 10 and `pinmux_hw_debug_en_o` Off, the check requires all four fields of `rv_jtag_o` to be 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_03a
          desc: '''While the TAP straps are 11 and `lc_dft_en_i` is On, `dft_jtag_o` shall carry the inputs of the TCK pad, the TMS pad, the TDI pad and the TRST_N pad.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `countermeasures` TAP.MUX.LC_GATED](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey.hjson `inter_module.top`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)"]
          why: '''With TAP straps 11 and `lc_dft_en_i` steadily On, the check compares `dft_jtag_o` with the JTAG pads in the same cycle. The check compares the `trst_n` field only outside scan mode.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_03b
          desc: '''While the TAP straps are 11 and `lc_dft_en_i` is Off, `dft_jtag_o` shall not carry the inputs of the TCK pad, the TMS pad, the TDI pad and the TRST_N pad.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `countermeasures` TAP.MUX.LC_GATED](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey.hjson `inter_module.top`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''With TAP straps 11 and `lc_dft_en_i` On in neither of the two cycles before, the check requires `dft_jtag_o` to be all 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_04
          desc: '''The life cycle TAP, the RISC-V TAP and the DFT TAP shall each receive an all-zero request while that TAP is not connected.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `inter_module.connect`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `inter_module.top`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''The check applies to the life cycle, RISC-V and DFT TAPs in every cycle and at every scan mode value. In a cycle in which one of these TAPs is cut, the check requires all four fields of its request to be 0.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_05
          desc: '''In strap sampling, in the latch and in TAP selection, `lc_dft_en_i` and `lc_hw_debug_en_i` shall count as On only at the value 4'b0101.'''
          source: [
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[pinmux.hjson `countermeasures` LC_DFT_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["only On opens", "cut TAP gets zero (assert_Jtag_CutTapGetsZero)", "pulse samples the straps (assert_Strap_PulseSamplesTheStraps)", "straps hold (assert_Strap_StrapsHold)", "pulse samples debug enable (assert_Latch_PulseSamplesDebugEnable)"]
          why: '''Each of these checks counts an enable as On only at the value 4'b0101.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_06a
          desc: '''While a TAP is connected, the TDO pad shall drive the TDO of that TAP.'''
          source: [
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tdo`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[JTAG](hw/ip/rv_dm/doc/interfaces.md#jtag)'''
            '''[Security Countermeasures](hw/ip/lc_ctrl/doc/interfaces.md#security-countermeasures)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["TDO pad drives the TAP (assert_JtagPad_TdoPadDrivesTheTap)"]
          why: '''While the TDO pad is awake, the check compares the pad's bit of `mio_out_o` with the `tdo` of the connected TAP in the same cycle. The RRAM TAP is included.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_06b
          desc: '''While a TAP is connected, the TDO pad shall take its output enable from that TAP.'''
          source: [
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals tdo`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[JTAG](hw/ip/rv_dm/doc/interfaces.md#jtag)'''
            '''[Security Countermeasures](hw/ip/lc_ctrl/doc/interfaces.md#security-countermeasures)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["TDO pad drives the TAP (assert_JtagPad_TdoPadDrivesTheTap)"]
          why: '''While the TDO pad is awake, the check compares the pad's bit of `mio_oe_o` with the `tdo_oe` of the connected TAP in the same cycle.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_07
          desc: '''While a TAP is connected, the TCK pad, the TMS pad, the TDI pad and the TRST_N pad shall have output enable 0.'''
          source: [
            '''The TAPs' standard JTAG port takes TCK, TMS, TRST_N and TDI as pad inputs and drives only TDO and its enable ([JTAG](hw/ip/rv_dm/doc/interfaces.md#jtag); [Security Countermeasures](hw/ip/lc_ctrl/doc/interfaces.md#security-countermeasures)); the RRAM TAP's port has the same JTAG type ([Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)) and takes the JTAG IOs ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation))'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["input pads not driven (assert_JtagPad_InputPadsNotDriven)"]
          why: '''While a TAP is connected and the pads are awake, the check requires `mio_oe_o` to be 0 for the TMS, TDI, TCK and TRST_N pads. The check allows the output selects of these pads to hold any value.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_08
          desc: '''While a TAP is connected, every attribute of the five JTAG pads shall be 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["JTAG attributes zero (assert_JtagPad_JtagAttributesZero)"]
          why: '''While a TAP is connected and the pads are awake, the check requires every field of `mio_attr_o` to be 0 on the five JTAG pads. The check allows the attribute registers of these pads to hold any value.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_09
          desc: '''Connecting a TAP shall not change the JTAG pads' attribute registers.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "jtag_pad"
          checks: ["attribute registers untouched (assert_JtagPad_AttributeRegistersUntouched)"]
          why: '''In every cycle, the check allows the attribute read-back of each JTAG pad to change only by a software write.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_TAP_12
          desc: '''An NDM reset with no clear shall leave a connected RISC-V TAP connected.'''
          source: [
            '''[Life Cycle Control](hw/ip/rv_dm/doc/interfaces.md#life-cycle-control)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[lc_ctrl.hjson `inter_signal_list` lc_hw_debug_en](hw/ip/lc_ctrl/data/lc_ctrl.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rv_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[System Reset Tree](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#system-reset-tree)'''
            '''[Summary](hw/top_earlgrey/ip_autogen/rstmgr/doc/theory_of_operation.md#summary)'''
          ]
          kind: "spec"
          testpoint: "jtag"
          checks: ["TAP selection outside NDM reset (check_Jtag_TapSelectionOutsideNdmReset)", "connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)", "cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''The structure check requires that an NDM reset reaches no flop of the TAP selection. The `jtag` checks require that the state of these flops alone picks the connected TAP.'''
          milestone: "V2S"
          priority: "1"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''RRAM TAP'''
      conditions: [
        '''These rows apply to a top that has the RRAM TAP ([top_earlgrey_pinmux.ipconfig.hjson](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson) `enable_rram_tap`). On a top without the RRAM TAP, TAP straps at 00 select no TAP ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)).'''
        '''The JTAG pad rows of TAP selection and the JTAG pads also hold for the RRAM TAP while it is connected. No row covers the TRST_N of the RRAM TAP while scan mode is on (Out of scope).'''
        '''The rows hold once the TAP straps and `lc_nvm_debug_en_i` have kept their values for the delay of the input synchronizers.'''
        '''In `REQ_RRAM_01`, TCK and TRST_N follow the TCK pad and the TRST_N pad from the second `clk_i` cycle in which the RRAM TAP is connected.'''
      ]
      requirements: [
        {
          name: REQ_RRAM_01
          desc: '''While the TAP straps are 00, `rram_jtag_o` shall carry the inputs of the TCK pad, the TMS pad, the TDI pad and the TRST_N pad, if `RRAM_JTAG_SEL` is `kMultiBitBool4True` and `lc_nvm_debug_en_i` is On.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[pinmux.hjson `countermeasures` TAP.MUX.LC_GATED](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''!!RRAM_JTAG_SEL'''
            '''[top_earlgrey.hjson `inter_module.connect pinmux.rram_jtag`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the values of TCK and TRST_N in the first `clk_i` cycle of a connection.'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["connected RRAM TAP gets the pads (assert_RramTap_ConnectedRramTapGetsThePads)"]
          why: '''While the RRAM TAP is connected, the check compares `rram_jtag_o` with the TCK, TMS, TDI and TRST_N pads in the same cycle. The check compares `tck` and `trst_n` only from the second cycle of the connection.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_02
          desc: '''While the RRAM TAP is not connected, the TMS and TDI of `rram_jtag_o` shall be 0.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''!!RRAM_JTAG_SEL'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["cut RRAM TAP gets TMS and TDI 0 (assert_RramTap_CutRramTapGetsTmsAndTdi0)"]
          why: '''From the release of `rst_ni` on, the check requires `tms` and `tdi` of `rram_jtag_o` to be 0 in every cycle in which the RRAM TAP is cut. The check allows the pads to carry any value.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_03
          desc: '''The TCK and TRST_N of `rram_jtag_o` shall be 0 during reset and in the `clk_i` cycle after reset. They shall also be 0 in the `clk_i` cycle after any cycle in which the RRAM TAP is not connected.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `clocking`](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "rram_tap"
          checks: ["TCK and TRST low after a cut (assert_RramTap_TckAndTrstLowAfterACut)"]
          why: '''The check requires `tck` and `trst_n` of `rram_jtag_o` to be 0 in reset and in the first cycle after reset. The check requires the same in every cycle that follows a cycle in which the RRAM TAP is cut.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_09
          desc: '''In the first `clk_i` cycle in which the RRAM TAP is no longer connected, the TCK and TRST_N of `rram_jtag_o` shall still carry the inputs of the TCK pad and the TRST_N pad. This holds outside reset.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[pinmux.hjson `clocking`](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''No specification states the clock that counts the cycle, and the value of TRST_N.'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["TCK and TRST run one cycle more (assert_RramTap_TckAndTrstRunOneCycleMore)"]
          why: '''The check applies to each cycle outside reset in which the RRAM TAP is cut and was connected in the cycle before. In such a cycle, the check compares `tck` with the TCK pad and `trst_n` with the TRST_N pad.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_04
          desc: '''In the selection of the RRAM TAP, `lc_nvm_debug_en_i` shall count as On only at the value 4'b0101.'''
          source: [
            '''[Control Signal Propagation](hw/ip/lc_ctrl/doc/interfaces.md#control-signal-propagation)'''
            '''[pinmux.hjson `countermeasures` LC_NVM_DEBUG_EN.INTERSIG.MUBI](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["only True and On open", "cut RRAM TAP gets TMS and TDI 0 (assert_RramTap_CutRramTapGetsTmsAndTdi0)"]
          why: '''With `lc_nvm_debug_en_i` free, any held value other than 4'b0101 cuts the RRAM TAP. The check _cut RRAM TAP gets TMS and TDI 0_ then requires `tms` and `tdi` of `rram_jtag_o` to be 0.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_05
          desc: '''After a reset, the RRAM TAP shall not be connected until software writes `kMultiBitBool4True` to `RRAM_JTAG_SEL`.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''!!RRAM_JTAG_SEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["cut until the register is written (assert_RramTap_CutUntilTheRegisterIsWritten)"]
          why: '''Until the first accepted write to `RRAM_JTAG_SEL`, the check requires `tms` and `tdi` of `rram_jtag_o` to be 0. The check allows the straps and `lc_nvm_debug_en_i` to take any value.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_06
          desc: '''`RRAM_JTAG_SEL` and `lc_nvm_debug_en_i` shall not change which of the life cycle TAP, the RISC-V TAP and the DFT TAP is connected. They shall not change what that TAP receives either.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''!!RRAM_JTAG_SEL'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["connected TAP gets the pads (assert_Jtag_ConnectedTapGetsThePads)", "cut TAP gets zero (assert_Jtag_CutTapGetsZero)"]
          why: '''Both checks cover the requests of the life cycle, RISC-V and DFT TAPs while `RRAM_JTAG_SEL` and `lc_nvm_debug_en_i` are free.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_RRAM_07
          desc: '''`lc_check_byp_en_i` and the latch shall not change whether the RRAM TAP is connected.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_rram_tap`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "rram_tap"
          checks: ["RRAM TAP kept through a transition (assert_RramTap_RramTapKeptThroughATransition)", "cut RRAM TAP gets TMS and TDI 0 (assert_RramTap_CutRramTapGetsTmsAndTdi0)"]
          why: '''The check _RRAM TAP kept through a transition_ requires a connected RRAM TAP to stay connected during a life cycle transition or while the latch is Off.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''DFT straps'''
      conditions: [
        '''The output `dft_strap_test_o` holds a valid bit and the straps.'''
        '''The straps take bit 0 from the DFT strap 0 pad and bit 1 from the DFT strap 1 pad ([existing pinmux FPV testplan: DftStrapTestO_A](hw/top_earlgrey/ip_autogen/pinmux/data/pinmux_fpv_testplan.hjson)), two pads that the top description assigns and that the table Pads by role lists.'''
        '''Two documents disagree on the number of DFT strap pads. The top description gives two, and the theory of operation gives three ([Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)). The rows follow the top description, because it sets the pads that the pinmux is built with.'''
      ]
      requirements: [
        {
          name: REQ_DFT_01a
          desc: '''At a `strap_en_i` pulse, the valid bit of `dft_strap_test_o` shall take the value 1, if `lc_dft_en_i` is On.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["pulse samples DFT straps (assert_DftStrap_PulseSamplesDftStraps)"]
          why: '''At a strap pulse with `lc_dft_en_i` On in each of the two cycles before, the check requires the valid bit to be 1 from the next cycle on.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_01b
          desc: '''At a `strap_en_i` pulse, the straps of `dft_strap_test_o` shall take the values of the DFT strap 0 pad and the DFT strap 1 pad, if `lc_dft_en_i` is On.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Inter-Module Signals](hw/top_earlgrey/ip_autogen/pinmux/doc/interfaces.md#inter-module-signals)'''
            '''[top_earlgrey.hjson `targets.asic.pinmux.special_signals`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
            '''[Manufacturing States](doc/security/specs/device_life_cycle/README.md#manufacturing-states)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["pulse samples DFT straps (assert_DftStrap_PulseSamplesDftStraps)"]
          why: '''At a strap pulse with `lc_dft_en_i` steadily On, the check compares the two straps after the pulse with the DFT strap 0 pad and the DFT strap 1 pad. The check accepts the value of each pad in the pulse cycle or in the cycle after it.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_02a
          desc: '''Once the valid bit of `dft_strap_test_o` is 1, the valid bit shall stay 1 until a full reset.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["DFT straps held (assert_DftStrap_DftStrapsHeld)"]
          why: '''Once the valid bit is 1, the check requires the output to keep its value into each next cycle that is not in full reset. The check allows `lc_dft_en_i` and the pads to take any value.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_02b
          desc: '''Once the valid bit of `dft_strap_test_o` is 1, the straps of `dft_strap_test_o` shall keep their values until a full reset.'''
          source: [
            '''[Strap Sampling and TAP Isolation](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#strap-sampling-and-tap-isolation)'''
            '''[Non-debug Module Reset](hw/top_earlgrey/ip_autogen/pinmux/doc/theory_of_operation.md#non-debug-module-reset)'''
            '''[top_earlgrey.hjson `resets.nodes lc_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `resets.nodes sys_io_div4`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey.hjson `module.pinmux`](hw/top_earlgrey/data/top_earlgrey.hjson)'''
            '''[top_earlgrey_pinmux.ipconfig.hjson `enable_strap_sampling`](hw/top_earlgrey/ip_autogen/pinmux/data/top_earlgrey_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "dft_strap"
          checks: ["DFT straps held (assert_DftStrap_DftStrapsHeld)"]
          why: '''Once the valid bit is 1, the check requires the two straps to keep their values into each next cycle that is not in full reset.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_DFT_03
          desc: '''`dft_strap_test_o` shall be all 0 before a sample, which takes place at a `strap_en_i` pulse while `lc_dft_en_i` is On. This holds for any value on the DFT strap 0 pad and the DFT strap 1 pad.'''
          source: [
            '''[chip_testplan.hjson `chip_sw_tap_strap_sampling`](hw/top_earlgrey/data/chip_testplan.hjson)'''
