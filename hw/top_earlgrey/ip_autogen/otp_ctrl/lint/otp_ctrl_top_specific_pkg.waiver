# waiver file for OTP controller top-specific package

waive -rules INPUT_NOT_READ -location {otp_ctrl_part_pkg.sv} \
      -regexp {Input port 'part_inv_default\[.*:.*\]' is not read from in function 'named_keymgr_key_assign'} \
      -comment "The function only extracts the key manager items from the partition defaults, so the other bits are not read."
