# waiver file for chip_earlgrey_asic

waive -rules {MULTI_DRIVEN} -location {chip_earlgrey_asic.sv} -regexp {'(IOA2|IOA3)' has 2 drivers, also driven at} \
      -comment "These two pads are shorted to AST, hence this multiple driver warning is OK."

waive -rules {COMBO_LOOP} -location {chip_earlgrey_asic.sv} \
      -regexp {port 'u_passthrough.host_s_i.*' driven in module 'spi_device'} \
      -comment "In the passthrough mode, SPI 4 lines are connected from pads to pads."

waive -rules {CLOCK_DRIVER} -location {chip_earlgrey_asic.sv} \
      -regexp {'mio_in\[10\]' is driven by instance 'u_padring' of module 'padring', and used as a clock} \
      -comment "'MioPadSpiDevClk' is the pad of the spi_device clock signal."

waive -rules {CLOCK_MUX} -location {chip_earlgrey_asic.sv} \
      -regexp {Clock 'mio_in\[10\]' reaches a multiplexer here, used as a clock}
      -comment "'MioPadSpiDevClk' is the pad of the spi_device clock signal. Inside spi_device, it's fed into a clock mux."

waive -rules {CLOCK_DRIVER} -location {chip_earlgrey_asic.sv} \
      -regexp {'mio_in\[11\]' is driven by instance 'u_padring' of module 'padring', and used as a clock 'csb_i' at spid_csb_sync.sv} \
      -comment "'MioPadSpiDevCsL' is the pad of the spi_device chip select signal. Inside spi_device, it's used as a clock for detecting toggles."

# Combo loops through uart loopback can be ignored
waive -rules {COMBO_LOOP} -location {chip_earlgrey_asic.sv} -regexp {'tx' driven in module 'uart_core' by 'rx' at uart_core.sv} \
      -comment "there is technically a loopback path through uart, however RX / TX should never be configured to the same pin"

# Combo loops through sysrst_ctrl inversion can be ignored
waive -rules {COMBO_LOOP} -location {chip_earlgrey_asic.sv} -regexp {'outputs\[[0-9]+\]' driven in module 'sysrst_ctrl_pin' by 'inputs\[[0-9]+\]' at sysrst_ctrl_pin} \
      -comment "sysrst_ctrl creates a feed through path directly for certain muxed pins"

# External clock
waive -rules {CLOCK_USE} -location {chip_earlgrey_asic.sv}  -msg {'mio_in_raw[40]' is used for some other purpose, and as clock} \
      -comment "MioPadIoc6 at index 40 may serve as an external clock input, hence the warnings"

waive -rules {CLOCK_DRIVER} -location {chip_earlgrey_asic.sv} \
      -regexp {'mio_in_raw\[40\]' is driven by instance 'u_padring' of module 'padring', and used as a clock} \
      -comment "MioPadIoc6 at index 40 may serve as an external clock input, hence the warnings"

waive -rules {CLOCK_DRIVER} -location {pinmux.sv} \
      -regexp {'mio_attr\[40\].pull_select' is driven here, and used as a clock} \
      -comment "MioPadIoc6 at index 40 may serve as an external clock input. The pull_select signal impacts the value of the pad simulation model."

waive -rules {CLOCK_USE} -location {pinmux.sv} \
      -regexp {'hw2reg.mio_pad_attr\[40\].pull_select.d' is connected to 'pinmux_reg_top' port 'hw2reg.mio_pad_attr\[40\].pull_select.d', and used as a clock} \
      -comment "MioPadIoc6 at index 40 may serve as an external clock input. The pull_select signal impacts the value of the pad simulation model."

# See https://github.com/lowRISC/opentitan/issues/15674
waive -rules {LHS_TOO_SHORT} -location {aes_prng_masking.sv} \
      -regexp {Bitlength mismatch between 'unused_assert_static_lint_error' length 1 and 'AesSecAllowForcingMasksNonDefault'\(1'b1\)' length 2} \
      -comment "We want to be able to switch off the masking inside AES, see https://github.com/lowRISC/opentitan/issues/14240."

waive -rules {LHS_TOO_SHORT} -location {sram_ctrl.sv} \
      -regexp {Bitlength mismatch between 'unused_assert_static_lint_error' length 1 and 'SramCtrlSecZeroInitNonDefault'\(1'b1\)' length 2} \
      -comment "SecZeroInit is intentionally enabled for the CHERIoT meta SRAM to ensure capabilities are cleared on initialization."

# See https://github.com/lowRISC/opentitan/issues/31066
waive -rules {LHS_TOO_SHORT} -location {prim_ram_1p_scr.sv} \
      -regexp {Bitlength mismatch between 'unused_assert_static_lint_error' length 1 and 'DepthPow2OrDivisibleByLintMinChunkDepthCheck_L'\(1'b1\)' length 2, instance '.*\.u_sram_ctrl_meta\.u_prim_ram_1p_scr'} \
      -comment "The 38 KiB CHERIoT meta SRAM uses address scrambling with 2 KiB chunks: 9 of its 14 address bits pass through the S&P network and the 5 MSBs are rotated by one of 19 chunk offsets. This is weaker than for a power-of-2 depth, but better than no address scrambling and avoids growing the SRAM to 48 KiB."

# Temporary generic waiver for ast until the proper split into sub-IPs in the Main and Aon toplevels is done.
waive -location {ast*.sv} \
      -regexp {.*} \
      -comment "AST is TEMPORARILY waived until properly split into Main and Aon domain."
