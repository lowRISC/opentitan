# waiver file for top_earlgrey (and the earlgrey power domain submodules)

# dedicated reset drivers / muxes
set_reset_drivers prim_clock_mux2 prim_flop_2sync prim_flop
set_clock_drivers prim_clock_buf prim_clock_mux2

# All leaf resets have a reset multiplex
waive -rules RESET_MUX -location {top_earlgrey.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {Asynchronous reset .*rstmgr_resets(_i|_o)?\.rst.* is driven by a multiplexer} \
      -comment "This is dedicated reset infrastructure, and hence permissible"

# External clock
waive -rules {CLOCK_USE} -location {top_earlgrey.sv} -regexp {'clk_ast_ext_i' is connected to 'earlgrey_pd_aon' port 'clk_ast_ext_i', and used as a clock} \
      -comment "This is an actual external clock."

# Clock and reset feedthrough across the top_earlgrey wrapper. It distributes the
# clkmgr_clocks / rstmgr_resets structs (which originate inside earlgrey_pd_aon)
# to the earlgrey_pd_main wrapper and the internal AST partitions.
waive -rules {CLOCK_USE} -location {top_earlgrey.sv} -regexp {'clkmgr_clocks..*' is connected to '(earlgrey_pd_main|earlgrey_pd_aon)' port '(clkmgr_clocks_(i|o)..*)', and used as a clock} \
      -comment "Clock struct feedthrough across the wrapper into the power domains."

waive -rules {RESET_USE} -location {top_earlgrey.sv} -regexp {'rstmgr_resets..*' is connected to '(earlgrey_pd_main|earlgrey_pd_aon)' port '(rstmgr_resets_(i|o)..*)', and used as an asynchronous reset or set} \
      -comment "Reset struct feedthrough across the wrapper into the power domains."

waive -rules {RESET_USE} -location {earlgrey_pd_aon.sv} -regexp {'rstmgr_resets..*' is connected to 'ast_part_secondary' port 'rst_ast_.*_ni', and used as an asynchronous reset or set} \
      -comment "Reset struct distribution inside the power domain."

# Clock and reset sense ports of AST
waive -rules {CLOCK_USE} -location {earlgrey_pd_aon.sv} -regexp {'ast_sns_clks..*' is connected to 'ast_part_secondary' port 'sns_clks_i..*', and used as a clock} \
      -comment "These clocks are fed back to AST for sensing purposes."

waive -rules {RESET_USE} -location {earlgrey_pd_aon.sv} -regexp {'ast_sns_rsts..*' is connected to 'ast_part_secondary' port 'sns_rsts_i..*', and used as an asynchronous reset or set} \
      -comment "These resets are fed back to AST for sensing purposes."

# Clock MUXs
waive -rules CLOCK_MUX -location {top_earlgrey.sv} -regexp {'ast_intraip_p2s.clk_rst.clk_ast_tlul' is driven by a multiplexer here} \
      -comment "This is an actual clock signal originating from a DFT clock mux"

waive -rules CLOCK_MUX -location {top_earlgrey.sv earlgrey_pd_aon.sv} -regexp {'ast_clk_src_io.*' reaches a multiplexer here, used as a clock} \
      -comment "This multiplexer is required to generate a divided clock."

waive -rules CLOCK_MUX -location {top_earlgrey.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {.*clk_io_div.* is driven by a multiplexer here} \
      -comment "Divided clocks go through prim_clock_div, which use muxes for scan bypass and clock step down"

waive -rules CLOCK_MUX -location {top_earlgrey.sv earlgrey_pd_main.sv} -regexp {Clock 'spi_device_passthrough_req.sck' reaches a multiplexer here, used as a clock} \
      -comment "In passthrough mode, spi_host muxes 'spi_device_passthrough_req.sck' to the `cio_sck_o` output."

waive -rules CLOCK_MUX -location {top_earlgrey.sv} -regexp {Clock 'cio_spi_device_sck_p2d' reaches a multiplexer here, used as a clock} \
      -comment "'DioSpiDeviceSck' is the dedicated IO for the spi_device clock signal. Pinmux (Aon domain) forwards it to spi_device, where it's fed into a clock mux."

# Scan reset is a legal asynchronous reset.
waive -rules RESET_USE -location {top_earlgrey.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {'scan_rst_ni?' is connected to .* port 'scan_rst_ni', and used as an asynchronous reset or set 'rst_.*ni' at} \
      -comment "Scan reset is a legal asynchronous reset"

## xbar
#waive -rules HIER_NET_NOT_READ -location {tlul_xbar.sv} -regexp {a_source.* is not read from} \
#      -comment "upper bits of a_source are shifted off when going through M:1 sockets"

# Most SAME_NAME_TYPE issues have been fixed. There are however some that overlap due to similar terminology.
# Since these functions / parameters / signals live in different scopes, this is acceptable, and we can waive them.
waive -rules SAME_NAME_TYPE -location {aes_sbox_canright_pkg.sv keccak_2share.sv} -regexp {'theta' is used as a (reg|function) here, and as a (function|reg) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {keccak_round.sv keccak_2share.sv otbn_pkg.sv} -regexp {'L' is used as a (parameter|reg) here, and as a (reg|parameter) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {spi_device.sv rstmgr_pkg.sv} -regexp {'spi_device' is used as a (module|reg) here, and as a (reg|module) at } \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {tlul_socket_m1.sv otbn_pkg.sv} -regexp {'M' is used as a (parameter|reg) here, and as a (reg|parameter) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {cheriot_socket_m1.sv otbn_pkg.sv} -regexp {'M' is used as a (parameter|reg) here, and as a (reg|parameter) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {i2c.sv i3c_controller_pkg.sv} -regexp {'i2c' is used as a (module|reg) here, and as a (reg|module) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {i2c_bus_monitor.sv i3c_reg_pkg.sv} -regexp {'bus_idle' is used as a (block|reg) here, and as a (reg|block) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {i3c_target_trx.sv prim_alert_receiver.sv} -regexp {'ack_nq' is used as a (block|reg) here, and as a (reg|block) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {i3c_reset_detector.sv prim_sync_reqack.sv} -regexp {'req_sync' is used as an? (reg|instance) here, and as an? (instance|reg) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}

## I3C
# The I3C Target transceiver has no free-running clock: it is clocked by the Controller-supplied
# SCL, and by SDA to detect START, Repeated START and STOP conditions. Both arrive through MIO
# pads, so the pad inputs legitimately reach clock inputs.
waive -rules {CLOCK_DRIVER} -location {earlgrey_pd_aon.sv} -regexp {'mio_p2d\[(38|39|40|41)\]' is driven by instance 'u_pinmux' of module 'pinmux', and used as a clock '(scl_i|sda0_clk_ni)' at} \
      -comment "The I3C Target SCL and SDA pins clock the Target transceiver, which has no free-running clock."
waive -rules {CLOCK_DRIVER} -location {earlgrey_pd_aon.sv} -regexp {'mio_p2d\[(50|51|52|53)\]' is driven by instance 'u_pinmux' of module 'pinmux', and used as a clock '(scl_buf|sda_clk_n)' at} \
      -comment "The SCL and SDA inputs of the I3C Target Reset Detectors clock the detectors, which have no free-running clock."

waive -rules {LINE_LENGTH} -location {top_earlgrey.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {Line length of [0-9]+ exceeds 100 character limit} \
      -comment "Earlgrey toplevels are auto-generated and adhering to the line length limit is not always feasible for auto-generated code"

waive -rules LINE_LENGTH -location {top_earlgrey_rnd_cnst_pkg.sv} -regexp {Line length of [0-9]+ exceeds 100 character limit} \
      -comment "top_earlgrey_rnd_cnst_pkg is auto-generated and adhering to the line length limit is not always feasible for auto-generated code"
