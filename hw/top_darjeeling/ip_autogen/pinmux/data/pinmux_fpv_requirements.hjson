          why: '''The check requires `input_disable` to read back a written 0 as 0. Once a written 1 in `input_disable` reads back as 1 on one pad, the check requires a written 1 to read back as 1 on every pad of the same type from that cycle on.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
