            '''[top_darjeeling_pinmux.ipconfig.hjson `n_wkup_detect`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "wakeup_cause"
          checks: ["no request without cause (assert_WakeupCause_NoRequestWithoutCause)"]
          why: '''The check requires `pin_wkup_req_o` to be 0 once every cause bit has been 0 for 3 consecutive cycles.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_19a
          desc: '''A write to a detector's enable shall reach the AON logic within a bounded time.'''
          source: [
            '''!!WKUP_DETECTOR_EN'''
            '''[Wakeup Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#wakeup-features)'''
