        }
        {
          name: REQ_ATTR_03
          desc: '''The `invert` field of every pad shall read back as written.'''
          source: [
            '''[Generic Pad Wrapper](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["invert reads back (assert_PadAttr_InvertReadsBack)"]
          why: '''On every pad type, the check compares the `invert` bit of the read-back with the `invert` bit of the pad's last attribute write. The check applies in every cycle after the pad's first attribute write.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_05
          desc: '''The `virtual_od_en` field of a BidirStd pad or a BidirStr pad shall read back as written.'''
          source: [
            '''Earl Grey's [Virtual open drain](hw/top_earlgrey/doc/design/README.md#virtual-open-drain)'''
            '''[top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["virtual open drain reads back (assert_PadAttr_VirtualOpenDrainReadsBack)"]
          why: '''On every BidirStd pad and every BidirStr pad, the check compares the `virtual_od_en` bit of the read-back with the `virtual_od_en` bit of the pad's last attribute write. The check applies in every cycle after the pad's first attribute write.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_06
          desc: '''The `od_en` field of every pad shall read back 0.'''
          source: [
            '''Earl Grey's [Virtual open drain](hw/top_earlgrey/doc/design/README.md#virtual-open-drain)'''
            '''[Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["no open drain (assert_PadAttr_NoOpenDrain)"]
          why: '''On every pad, the check requires the `od_en` bit of the read-back to be 0 in every cycle, for any value that software wrote.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_07
          desc: '''The `virtual_od_en` field of every pad whose type is neither BidirStd nor BidirStr shall read back 0.'''
          source: [
            '''Earl Grey's [Virtual open drain](hw/top_earlgrey/doc/design/README.md#virtual-open-drain)'''
            '''[Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["no virtual open drain elsewhere (assert_PadAttr_NoVirtualOpenDrainElsewhere)"]
          why: '''On every pad whose type is neither BidirStd nor BidirStr, the check requires the `virtual_od_en` bit of the read-back to be 0 in every cycle, for any value that software wrote.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_ATTR_08c
          desc: '''The `pull_en` field of every pad shall read back as written in each bit that the pad's type keeps.'''
          source: [
            '''!!MIO_PAD_ATTR'''
            '''[Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
            '''[top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["supported bits read back (assert_PadAttr_SupportedBitsReadBack)"]
          why: '''The check requires `pull_en` to read back a written 0 as 0. Once a written 1 in `pull_en` reads back as 1 on one pad, the check requires a written 1 to read back as 1 on every pad of the same type from that cycle on.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
