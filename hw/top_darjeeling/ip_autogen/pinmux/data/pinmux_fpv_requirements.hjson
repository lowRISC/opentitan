    {
      name: '''Sleep retention'''
      conditions: [
        '''In these rows, a pad is any MIO pad `p` or any DIO pad `d`.'''
        '''A pad's status bit is the pad's bit in `MIO_PAD_SLEEP_STATUS` or in `DIO_PAD_SLEEP_STATUS`.'''
        '''Sleep entry is a rise of `sleep_en_i` from 0 to 1.'''
        '''The rows for sleep modes 0 to 3 hold while the pad's sleep mode has not changed since sleep entry.'''
      ]
      requirements: [
        {
          name: REQ_SLP_01
          desc: '''At sleep entry, the status bit of every pad whose sleep enable is 1 shall become 1. `REQ_SLP_09` states the one exception, in which a software clear of that bit lands in the same cycle.'''
          source: [
            '''!!MIO_PAD_SLEEP_EN.EN'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["bit set at entry (assert_PadSleep_BitSetAtEntry)"]
          why: '''At every sleep entry in which the pad's sleep enable is 1 and software does not clear the status bit in that cycle, the check requires the bit to be 1 in the next cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_02
          desc: '''A status bit shall become 1 only at sleep entry, and only if the pad's sleep enable is 1.'''
          source: [
            '''!!MIO_PAD_SLEEP_STATUS.EN'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["bit set only at entry (assert_PadSleep_BitSetOnlyAtEntry)"]
          why: '''Whenever a status bit rises from 0 to 1, the check requires the cycle before to be a sleep entry in which the pad's sleep enable is 1.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_03a
          desc: '''While a pad is asleep and its sleep mode is 0, the pad's output shall be 0.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["tie low in sleep (assert_PadSleep_TieLowInSleep)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 0 at the sleep entry, the check compares the pad's output with 0 in the same cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_03b
          desc: '''While a pad is asleep and its sleep mode is 0, the pad's output enable shall be 1, so the pad drives 0.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["tie low in sleep (assert_PadSleep_TieLowInSleep)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 0 at the sleep entry, the check compares the pad's output enable with 1.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_04a
          desc: '''While a pad is asleep and its sleep mode is 1, the pad's output shall be 1.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["tie high in sleep (assert_PadSleep_TieHighInSleep)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 1 at the sleep entry, the check compares the pad's output with 1 in the same cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_04b
          desc: '''While a pad is asleep and its sleep mode is 1, the pad's output enable shall be 1, so the pad drives 1.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["tie high in sleep (assert_PadSleep_TieHighInSleep)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 1 at the sleep entry, the check compares the pad's output enable with 1.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_05a
          desc: '''While a pad is asleep and its sleep mode is 2, the pad's output enable shall be 0, so the pad is high-Z.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["high-Z in sleep (assert_PadSleep_HighZInSleep)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 2 at the sleep entry, the check compares the pad's output enable with 0 in the same cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_05b
          desc: '''While a pad is asleep and its sleep mode is 2, the pad's output shall be 0.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["high-Z in sleep (assert_PadSleep_HighZInSleep)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 2 at the sleep entry, the check compares the pad's output with 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_06a
          desc: '''While a pad is asleep and its sleep mode is 3, the pad shall keep the output that it drove in the last cycle before its status bit became 1.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
            '''[Retention Logic](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-logic)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["keep holds (assert_PadSleep_KeepHolds)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 3 at the sleep entry that set the bit, the check compares the pad's output with its output in that entry cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_06b
          desc: '''While a pad is asleep and its sleep mode is 3, the pad shall keep the output enable that it drove in the last cycle before its status bit became 1.'''
          source: [
            '''!!MIO_PAD_SLEEP_MODE.OUT'''
            '''[Retention Logic](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-logic)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["keep holds (assert_PadSleep_KeepHolds)"]
          why: '''While a pad's status bit is 1 and its sleep mode was 3 at the sleep entry that set the bit, the check compares the pad's output enable with its enable in that entry cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_07
          desc: '''Once a status bit is 1, the bit shall stay 1 until software writes 0 to it. The rule holds at every value of `sleep_en_i` and of the pad's sleep enable, and for every value that the peripheral drives.'''
          source: [
            '''!!MIO_PAD_SLEEP_STATUS.EN'''
            '''[Retention Logic](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-logic)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["bit holds until cleared (assert_PadSleep_BitHoldsUntilCleared)", "clear releases (assert_PadSleep_ClearReleases)"]
          why: '''If software does not clear a status bit at 1 in a cycle, the check _bit holds until cleared_ requires the bit to be 1 in the next cycle. The check _clear releases_ requires the bit to be 0 in the cycle after a clear.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_08
          desc: '''While an MIO pad is awake, the pad shall drive what its output select names. While a DIO pad is awake, the pad shall drive the output and output enable of its own peripheral.'''
          source: [
            '''[Retention Logic](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-logic)'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "sleep_release"
          checks: ["tie 0 drives 0 (assert_PadOutput_Tie0Drives0)", "tie 1 drives 1 (assert_PadOutput_Tie1Drives1)", "select 2 is high-Z (assert_PadOutput_Select2IsHighZ)", "drives selected output (assert_PadOutput_DrivesSelectedOutput)", "select without an output is high-Z (assert_PadOutput_SelectWithoutAnOutputIsHighZ)", "DIO drives its peripheral (assert_PadOutput_DioDrivesItsPeripheral)"]
          why: '''Each of these checks compares the pad's drive with its selected drive in every cycle in which the pad's status bit is 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_09
          desc: '''When sleep entry sets a status bit in the cycle that software writes 0 to that bit, the bit shall end at 0. The software clear has precedence over sleep entry.'''
          source: [
            '''!!MIO_PAD_SLEEP_STATUS'''
            '''[Type RW](util/reggen/README.md#type-rw)'''
            '''[Simultaneous SW and HW access](util/reggen/README.md#simultaneous-sw-and-hw-access)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["clear wins (assert_PadSleep_ClearWins)"]
          why: '''When a sleep entry with the pad's sleep enable at 1 falls in the same cycle as a software clear of the status bit, the check requires the bit to be 0 in the next cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_10a
          desc: '''A write to a pad's sleep mode while the pad is asleep shall leave the pad as it is.'''
          source: [
            '''[Retention Logic](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-logic)'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["mode write while held (assert_PadSleep_ModeWriteWhileHeld)"]
          why: '''After software writes the pad's sleep mode while the status bit is 1, the check requires the pad to keep the sleep value of the mode taken at the sleep entry.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_SLP_10b
          desc: '''After a write to a pad's sleep mode while the pad is asleep, the new mode shall take effect at the next sleep entry.'''
          source: [
            '''[Retention Logic](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-logic)'''
            '''[Sleep Features](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#sleep-features)'''
          ]
          kind: "spec"
          testpoint: "pad_sleep"
          checks: ["tie low in sleep (assert_PadSleep_TieLowInSleep)", "tie high in sleep (assert_PadSleep_TieHighInSleep)", "high-Z in sleep (assert_PadSleep_HighZInSleep)", "keep holds (assert_PadSleep_KeepHolds)", "the CSR checker"]
          why: '''Each of the four sleep mode checks uses the sleep mode that the pad had at the sleep entry. The CSR checker checks that the register keeps the written mode.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Register locks'''
      conditions: [
        '''A "lock" is one bit of a `*_REGWEN` register. Each lock locks the registers that have the same index. A lock is open while it is 1 and closed while it is 0.'''
        '''The rule that a locked pad's attribute output does not change (`REQ_LOCK_03a`) holds on every pad. The rule for the value that software reads (`REQ_LOCK_03b`) holds on every pad.'''
      ]
      requirements: [
        {
          name: REQ_LOCK_01a
          desc: '''Every lock shall read 1 after reset.'''
          source: [
            '''the register description: the `EN` field of each `*_REGWEN`, for example !!MIO_PAD_ATTR_REGWEN.EN `resval: "1"`, on `clk_i` with `rst_ni` ([pinmux.hjson `clocking`](hw/top_darjeeling/ip_autogen/pinmux/data/pinmux.hjson))'''
            '''[Configuration and Register Definition File Format](util/reggen/README.md#configuration-and-register-definition-file-format)'''
          ]
          kind: "spec"
          testpoint: "register_block"
          checks: ["the CSR checker"]
          why: '''After reset, the CSR checker expects every lock to be 1, and compares the lock's value and each read of it with 1. Bit 31 of `ALERT_TEST` locks the alert test in the same way, and the CSR checker expects it to be 1 after reset too.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_LOCK_01b
          desc: '''Once software writes 0 to a lock, the lock shall stay 0 until reset.'''
          source: [
            '''[Configuration and Register Definition File Format](util/reggen/README.md#configuration-and-register-definition-file-format)'''
            '''[Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
          ]
          kind: "spec"
          testpoint: "register_block"
          checks: ["the CSR checker"]
          why: '''The CSR checker predicts each lock as an `rw0c` field. In that prediction, an accepted write of 0 clears the lock and nothing sets it. A lock that returns to 1 before a reset fails the comparison.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_LOCK_01c
          desc: '''A write of 1 to a lock that is 0 shall not reopen it.'''
          source: [
            '''the register description: each lock `rw0c`'''
            '''[Configuration and Register Definition File Format](util/reggen/README.md#configuration-and-register-definition-file-format)'''
            '''[Pinmux Configuration](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
          ]
          kind: "spec"
          testpoint: "register_block"
          checks: ["the CSR checker"]
          why: '''The CSR checker predicts each lock as an `rw0c` field, so a closed lock stays 0 on a write of 1. A lock that such a write reopens fails the comparison.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_LOCK_02
          desc: '''While a lock is 0, a write to a register it locks shall leave that register unchanged.'''
          source: [
            '''!!MIO_PERIPH_INSEL_REGWEN.EN'''
            '''[Configuration and Register Definition File Format](util/reggen/README.md#configuration-and-register-definition-file-format)'''
          ]
          kind: "spec"
          testpoint: "register_block"
          checks: ["locked read-back holds (assert_Regwen_LockedReadBackHolds)", "the CSR checker"]
          why: '''The CSR checker predicts that a register whose lock reads 0 keeps its value over every write. For the attribute registers, the check _locked read-back holds_ requires the read-back to stay unchanged while the lock reads 0.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_LOCK_03a
          desc: '''While a pad's attribute lock is 0, the pad's attribute output shall not change.'''
          source: [
            '''!!MIO_PAD_ATTR_REGWEN.EN'''
            '''[Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
          ]
          kind: "spec"
          testpoint: "regwen"
          checks: ["locked attribute holds (assert_Regwen_LockedAttributeHolds)"]
          why: '''While the attribute lock of a pad is closed, the check requires the pad's attribute output to keep its value from each cycle to the next. The check covers every pad.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_LOCK_03b
          desc: '''While a pad's attribute lock is 0, the value that software reads from the pad's attribute register shall not change.'''
          source: [
            '''!!MIO_PAD_ATTR_REGWEN.EN'''
            '''[Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)'''
          ]
          kind: "spec"
          testpoint: "regwen"
          checks: ["locked read-back holds (assert_Regwen_LockedReadBackHolds)"]
          why: '''While the attribute lock of a pad is closed, the check requires the pad's read-back to keep its value from each cycle to the next. The check covers every pad.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Register block and bus'''
      conditions: [
        '''A "failed request" is a request whose command integrity code does not match, or whose data integrity code does not match ([Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)). No document says whether the data integrity code of a read is checked, because that code covers the write data ([Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)). These rows follow the design, which checks the data integrity code of every request.'''
        '''The pinmux's alert sender answers a ping of the alert handler with an alert event, which is a full handshake on the alert and acknowledge pairs. The alert handler takes that handshake as the answer to its ping ([Ping Testing](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#ping-testing)).'''
        '''The "in-band reset" is the alert handler's re-initialization. During the in-band reset, the alert handler puts a signal integrity error on its ping and acknowledge pairs on purpose ([Employed Solution](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#employed-solution)).'''
        '''A request has an "illegal combination of address, size and mask" when its address is not aligned to its size, when its size is greater than 2, or when its mask has a bit set outside the access. A `PutFullData` request also has an illegal combination when the mask bit of a lane inside the access is 0.'''
      ]
      requirements: [
        {
          name: REQ_REG_01a
          desc: '''Every register field shall behave as its access type requires on each software read or write that is answered without an error. This row covers a write only while the field's lock reads 1, or when the field has no lock.'''
          source: [
            '''the register description: each field's `swaccess`, for example !!MIO_PAD_SLEEP_STATUS `swaccess: "rw0c"`'''
            '''[Configuration and Register Definition File Format](util/reggen/README.md#configuration-and-register-definition-file-format)'''
          ]
          kind: "spec"
          testpoint: "register_block"
          checks: ["read-back changes only on a write (assert_PadAttr_ReadBackChangesOnlyOnAWrite)", "the CSR checker"]
          why: '''For the attribute registers, the check _read-back changes only on a write_ allows a read-back to change only in the cycle after an attribute write. The CSR checker predicts each field from its access type.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_REG_01b
          desc: '''After reset, every register field shall read the reset value that the register description gives the field.'''
          source: [
            '''the register description: each field's `resval`, for example !!MIO_PAD_SLEEP_STATUS.EN `resval: "0"`'''
            '''[Configuration and Register Definition File Format](util/reggen/README.md#configuration-and-register-definition-file-format)'''
          ]
          kind: "spec"
          testpoint: "register_block"
          checks: ["the CSR checker"]
          why: '''After reset, the CSR checker requires each field to hold its reset value. The check _reset attributes_ covers the reset values of the attribute registers.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_01a
          desc: '''The pinmux shall answer every request with one response, and only one.'''
          source: [
            '''TileLink 1.9.3 p. 39: "Receipt of request messages must result in the eventual receipt of a response message by the requestor."; p. 30: "it is illegal to receive a response without receiving the request."; p. 46: "In TL-UL, every message fits within a single beat"'''
            '''No specification states the limit of one response per request.'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["device rules (assert_Bus_DeviceRules)"]
          why: '''The check uses the device rules of the TL-UL ABVIP on the pinmux's port. These rules match each response to one open request.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_01b
          desc: '''The pinmux shall answer every request with a response that follows the TL-UL rules and carries the source ID of the request.'''
          source: [
            '''[Source ID requirements for device elements](hw/ip/tlul/README.md#source-id-requirements-for-device-elements)'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["device rules (assert_Bus_DeviceRules)"]
          why: '''The check uses the device rules of the TL-UL ABVIP on the pinmux's port. These rules compare the `d_source` of each response with the `a_source` of its request.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_01c
          desc: '''A request shall receive an error response only if it is a failed request, a request that one of `REQ_BUS_10a` to `REQ_BUS_10d` describes, or a request to an address that no register maps.'''
          source: [
            '''[Explicit Error Cases](hw/ip/tlul/README.md#explicit-error-cases)'''
            '''[Error responses](util/reggen/README.md#error-responses)'''
            '''No specification states the error on a read whose only mismatch is in its data integrity code, and the error on an address that is not aligned to the request's size.'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["errors as the register checker predicts", "the CSR checker"]
          why: '''For every request that is not a failed request, the error checks of the CSR checker require `d_error` to be 1 exactly when the request has one of the listed causes.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_02a
          desc: '''Every response shall carry the response integrity code, which is computed over the op code, the size and the error of that response.'''
          source: [
            '''[Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)'''
            '''[pinmux.hjson `countermeasures` BUS.INTEGRITY](hw/top_darjeeling/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''No specification states the encoding of the response integrity code.'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["response codes correct (assert_Bus_ResponseCodesCorrect)"]
          why: '''For each response, the check recomputes the response code from the response's opcode, size and error with the integrity functions of `tlul_pkg`. The check then compares the result with the response code that the pinmux sends.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_02b
          desc: '''Every response shall carry the data integrity code, which is computed over the data of that response.'''
          source: [
            '''[Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)'''
            '''[pinmux.hjson `countermeasures` BUS.INTEGRITY](hw/top_darjeeling/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''No specification states the encoding of the data integrity code.'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["response codes correct (assert_Bus_ResponseCodesCorrect)"]
          why: '''For each response, the check recomputes the data code over the response data with the integrity functions of `tlul_pkg`. The check then compares the result with the data code that the pinmux sends.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_03
          desc: '''A failed request shall receive an error response.'''
          source: [
            '''[Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)'''
            '''[cip_base_vseq](hw/dv/sv/cip_lib/README.md#cip_base_vseq)'''
          ]
          kind: "RTL"
          testpoint: "bus"
          checks: ["failed request errors (assert_Bus_FailedRequestErrors)"]
          why: '''The check requires `d_error` to be 1 on the response to every failed request.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_04
          desc: '''A write that is a failed request shall change no register.'''
          source: [
            '''[Usage of User Bits](hw/ip/tlul/README.md#usage-of-user-bits)'''
          ]
          kind: "RTL"
          testpoint: "bus"
          checks: ["failed write changes nothing (assert_Bus_FailedWriteChangesNothing)"]
          why: '''The check requires every register to keep its value over a failed write. The one exception is an AON field that is still taking an earlier write, which has not landed yet.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_05
          desc: '''Outside the alert handler's in-band reset, a failed request shall raise the fatal alert `fatal_fault`.'''
          source: [
            '''[pinmux.hjson `alert_list` fatal_fault](hw/top_darjeeling/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[Employed Solution](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#employed-solution)'''
            '''No specification states the alert for a read whose only mismatch is in its data integrity code.'''
          ]
          kind: "spec"
          testpoint: "alert"
          checks: ["failed request alerts (assert_Alert_FailedRequestAlerts)"]
          why: '''The check requires an alert event on `alert_tx_o` within 40 cycles of every failed request.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_06
          desc: '''Outside the alert handler's in-band reset, the pinmux shall send the fatal alert repeatedly from the time it is raised until reset.'''
          source: [
            '''[Alerts per Module](doc/contributing/hw/comportability/README.md#alerts-per-module)'''
            '''[Employed Solution](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#employed-solution)'''
          ]
          kind: "spec"
          testpoint: "alert"
          checks: ["fatal alert repeats (assert_Alert_FatalAlertRepeats)"]
          why: '''After a failed request and until reset, the check requires every cycle to be followed by an alert event within 40 cycles.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_07
          desc: '''While bit 31 of `ALERT_TEST` is 1, a write of 1 to bit 0 of `ALERT_TEST` that is answered without an error shall send one alert event. The rule applies only outside the alert handler's in-band reset.'''
          source: [
            '''The register page says of bit 0: "Write 1 to trigger one alert event of this kind." (!!ALERT_TEST)'''
            '''[Test Alert Register Creation](doc/contributing/hw/comportability/README.md#test-alert-register-creation)'''
            '''[Employed Solution](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#employed-solution)'''
          ]
          kind: "spec"
          testpoint: "alert"
          checks: ["test sends an event (assert_Alert_TestSendsAnEvent)", "no alert without a cause (assert_Alert_NoAlertWithoutACause)"]
          why: '''The check _test sends an event_ requires an alert event within 40 cycles of each alert test. In the check _no alert without a cause_, each alert test allows one alert event, so one test gives one event.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_08
          desc: '''While bit 31 of `ALERT_TEST` is 0, a write to bit 0 of `ALERT_TEST` that is not a failed request shall send no alert. The rule applies only outside the alert handler's in-band reset.'''
          source: [
            '''The register page says of bit 31: "Write 0 to disable alert testing until the next reset." (!!ALERT_TEST)'''
            '''[Employed Solution](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#employed-solution)'''
          ]
          kind: "spec"
          testpoint: "alert"
          checks: ["no alert without a cause (assert_Alert_NoAlertWithoutACause)"]
          why: '''The check allows no alert event for a write of bit 0 while bit 31 of `ALERT_TEST` is 0. An alert event that has no other cause then fails the check.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_09
          desc: '''Outside the alert handler's in-band reset, the pinmux shall send the fatal alert only after a failed request or an alert test. This rule does not cover the pinmux's answers to the alert handler's pings.'''
          source: [
            '''[pinmux.hjson `alert_list` fatal_fault](hw/top_darjeeling/ip_autogen/pinmux/data/pinmux.hjson)'''
            '''[Employed Solution](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#employed-solution)'''
          ]
          kind: "spec"
          testpoint: "alert"
          checks: ["no alert without a cause (assert_Alert_NoAlertWithoutACause)"]
          why: '''The check allows an alert event only after a failed request, after a ping or after an alert test. Each ping and each alert test allows one event.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_10a
          desc: '''A request with an undefined opcode shall receive an error response.'''
          source: [
            '''[Usage of Opcode, Size and Mask](hw/ip/tlul/README.md#usage-of-opcode-size-and-mask)'''
            '''[Error responses](util/reggen/README.md#error-responses)'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["errors as the register checker predicts", "the CSR checker"]
          why: '''The error checks of the CSR checker require `d_error` to be 1 on a request with an undefined opcode. The proof lets the opcode take any value.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_10b
          desc: '''A request with an illegal combination of address, size and mask shall receive an error response. These combinations are defined in the Conditions above.'''
          source: [
            '''[Explicit Error Cases](hw/ip/tlul/README.md#explicit-error-cases)'''
            '''TileLink 1.9.3 p. 51: "a_address must be aligned to a_size."'''
            '''No specification states the error on an address that is not aligned to the request's size.'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["errors as the register checker predicts", "the CSR checker"]
          why: '''The error checks of the CSR checker require `d_error` to be 1 on a request with an illegal combination of address, size and mask. The proof keeps every mask contiguous.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_10c
          desc: '''A write of 8 or 16 bits to an address not aligned to a word shall receive an error response.'''
          source: [
            '''[Error responses](util/reggen/README.md#error-responses)'''
            '''[Explicit Error Cases](hw/ip/tlul/README.md#explicit-error-cases)'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["errors as the register checker predicts", "the CSR checker"]
          why: '''The error checks of the CSR checker require `d_error` to be 1 on an 8-bit or 16-bit write that is not aligned to a word.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_10d
          desc: '''A write narrower than its register shall receive an error response. The width of a register is set by the location of its fields.'''
          source: [
            '''[Error responses](util/reggen/README.md#error-responses)'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["errors as the register checker predicts", "the CSR checker"]
          why: '''The error checks of the CSR checker require `d_error` to be 1 on a write that is narrower than its register.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_10e
          desc: '''A request to an address that no register maps shall receive an error response, when that address is within the address bits that the register block decodes.'''
          source: [
            '''[Explicit Error Cases](hw/ip/tlul/README.md#explicit-error-cases)'''
            '''[Error responses](util/reggen/README.md#error-responses)'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["errors as the register checker predicts", "the CSR checker"]
          why: '''The error checks of the CSR checker require `d_error` to be 1 on a request to an address that maps to no register.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_11
          desc: '''A write that is answered with an error for any reason other than a failed integrity check shall change no register.'''
          source: [
            '''[cip_base_vseq](hw/dv/sv/cip_lib/README.md#cip_base_vseq)'''
            '''[Error responses](util/reggen/README.md#error-responses)'''
          ]
          kind: "spec"
          testpoint: "bus"
          checks: ["error write changes nothing", "the CSR checker"]
          why: '''A write answered with an error is not an accepted write. The CSR checker and the no-write checks of the attribute registers and the AON fields therefore require every register to keep its value over that write.'''
          milestone: "V2"
          priority: "2"
          security: true
          state: "open"
        }
        {
          name: REQ_BUS_12
          desc: '''Outside the alert handler's in-band reset, the pinmux shall answer each ping of the alert handler with one alert event within a bounded time.'''
          source: [
            '''[Ping Testing](hw/top_darjeeling/ip_autogen/alert_handler/doc/theory_of_operation.md#ping-testing)'''
          ]
          kind: "spec"
          testpoint: "alert"
          checks: ["ping answered (assert_Alert_PingAnswered)", "no alert without a cause (assert_Alert_NoAlertWithoutACause)"]
          why: '''The check _ping answered_ requires an alert event within 40 cycles of each ping. In the check _no alert without a cause_, each ping allows one alert event, so one ping gives one event.'''
          milestone: "V2S"
          priority: "2"
          security: true
          state: "open"
        }
      ]
    }
    {
      name: '''Wakeup detectors'''
      conditions: [
        '''The detector index `w` runs from 0 to `NWkupDetect` - 1, and a cycle in these rows is a cycle of `clk_aon_i`. The watched signal and the forwarded value are defined in the Terms.'''
        '''The register values in these rows are those that the AON logic holds once a write has crossed into the AON domain.'''
        '''The rows hold while an enabled detector keeps its mode. The other fields of the detector may change while it is enabled, although no specification states what such a change does.'''
        '''The rows hold at every value of `sleep_en_i` and of the scan mode, and also while `clk_i` is stopped.'''
        '''The rows are checked from the filter's fourth sample after the AON reset `rst_aon_ni`.'''
        '''The timed rows (`REQ_WKUP_09a` to `REQ_WKUP_10b`) hold while `CNT_TH` is 1 or greater.'''
      ]
      requirements: [
        {
          name: REQ_WKUP_01
          desc: '''While a detector's `MIODIO` is 0, its watched signal shall be the input of MIO pad `PADSEL` - 2 for `PADSEL` from 2 to `NMioPads` + 1, the constant 0 for `PADSEL` 0 and the constant 1 for `PADSEL` 1.'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
            '''!!WKUP_DETECTOR.MIODIO'''
            '''!!WKUP_DETECTOR_PADSEL.SEL'''
            '''[Retention and Wakeup Features](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#retention-and-wakeup-features)'''
            '''[Wakeup Detectors](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#wakeup-detectors)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_pads`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["edge sets cause (assert_Wakeup_EdgeSetsCause)", "timed high sets cause (assert_Wakeup_TimedHighSetsCause)", "timed low sets cause (assert_Wakeup_TimedLowSetsCause)", "no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''The checks watch the MIO pad or the constant that the select names.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_02
          desc: '''While a detector's `MIODIO` is 1, its watched signal shall be the input of DIO pad `PADSEL` for `PADSEL` from 0 to `NDioPads` - 1.'''
          source: [
            '''!!WKUP_DETECTOR.MIODIO'''
            '''!!WKUP_DETECTOR_PADSEL.SEL'''
            '''[MIO and DIO Signal Categories](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_dio_pads`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["edge sets cause (assert_Wakeup_EdgeSetsCause)", "no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''The checks watch the forwarded value of the DIO pad that the select names.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_03
          desc: '''A detector's watched signal shall be 0 while its `PADSEL` names no pad. `PADSEL` names no pad when it is greater than `NMioPads` + 1 and `MIODIO` is 0, or when it is `NDioPads` or greater and `MIODIO` is 1.'''
          source: [
            '''!!WKUP_DETECTOR_PADSEL.SEL'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_pads`, `n_dio_pads`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["timed low sets cause (assert_Wakeup_TimedLowSetsCause)", "no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''On a select that names no pad, the checks watch the value 0. The checks therefore require a detector in mode 4 to detect, and allow no edge to set the cause bit.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_04
          desc: '''While a detector's `FILTER` is 0, its forwarded value shall be the watched signal as sampled at each `clk_aon_i` edge.'''
          source: [
            '''[Wakeup Detectors](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#wakeup-detectors)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["edge sets cause (assert_Wakeup_EdgeSetsCause)", "no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''With `FILTER` 0, the forwarded value that the checks watch is the sampled pad. The checks allow the pad to be seen up to 4 cycles late.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_05
          desc: '''While a detector's `FILTER` is 1, its forwarded value shall take a new value only once 4 consecutive samples of the watched signal have had that value.'''
          source: [
            '''!!WKUP_DETECTOR.FILTER'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["edge sets cause (assert_Wakeup_EdgeSetsCause)", "no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''The checks count a level that holds for 4 consecutive samples as an edge of the forwarded value. A glitch of 3 samples gives no edge.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_06a
          desc: '''An enabled detector in mode 0 (Posedge) shall detect every rise of the forwarded value.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
            '''[Wakeup Detectors](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#wakeup-detectors)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["posedge sets cause (assert_Wakeup_PosedgeSetsCause)"]
          why: '''The check requires a hardware write of 1 to the cause bit within 8 cycles of each rise of the forwarded value, if `EN` is 1 at the rise and in each of the 4 cycles after it. A pulse of one sample counts as a rise.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_06b
          desc: '''An enabled detector in mode 0 (Posedge) shall detect only at a rise of the forwarded value.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
            '''[Wakeup Detectors](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#wakeup-detectors)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''In mode 0, the check allows a hardware write of 1 to a cause bit at 0 only when the write answers a rise of the forwarded value with `EN` 1. The check allows the rise to be seen up to 4 cycles late.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_07a
          desc: '''An enabled detector in mode 1 (Negedge) shall detect every fall of the forwarded value.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["negedge sets cause (assert_Wakeup_NegedgeSetsCause)"]
          why: '''The check requires a hardware write of 1 to bit `w` within 8 cycles of each fall of the forwarded value, if `EN` is 1 at the fall and in each of the 4 cycles after it.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_07b
          desc: '''An enabled detector in mode 1 (Negedge) shall detect only at a fall of the forwarded value.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''In mode 1, the check allows a hardware write of 1 to a cause bit at 0 only when the write answers a fall of the forwarded value. A detector that detects on a rise therefore fails the check.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_08a
          desc: '''An enabled detector in mode 2 (Edge) shall detect every change of the forwarded value.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["edge sets cause (assert_Wakeup_EdgeSetsCause)"]
          why: '''The check requires a hardware write of 1 to bit `w` within 8 cycles of each rise and each fall of the forwarded value, if `EN` is 1 at the edge and in each of the 4 cycles after it.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_08b
          desc: '''An enabled detector in mode 2 (Edge) shall detect only at a change of the forwarded value.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''In mode 2, the check allows a hardware write of 1 to a cause bit at 0 only when the write answers a rise or a fall of the forwarded value.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_09a
          desc: '''An enabled detector in mode 3 (TimedHigh) shall detect when the forwarded value has been 1 for `CNT_TH` consecutive cycles.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
            '''!!WKUP_DETECTOR_CNT_TH.TH'''
            '''[Wakeup Detectors](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#wakeup-detectors)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `wkup_cnt_width`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["timed high sets cause (assert_Wakeup_TimedHighSetsCause)"]
          why: '''The check requires the cause bit to be set within 8 cycles of the cycle in which the forwarded value has been 1 for `CNT_TH` + 1 consecutive cycles with `EN` 1. The sources of this count differ by one cycle, so a detection after `CNT_TH` + 1 cycles also passes.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_09b
          desc: '''An enabled detector in mode 3 (TimedHigh) shall never detect while the forwarded value has been 1 for fewer than `CNT_TH` consecutive cycles.'''
          source: [
            '''!!WKUP_DETECTOR.MODE'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `wkup_cnt_width`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "wakeup"
          checks: ["no false cause (assert_Wakeup_NoFalseCause)"]
          why: '''In mode 3, the check refuses a set of the cause bit while the forwarded value has been 1 for fewer than `CNT_TH` consecutive cycles with `EN` 1.'''
          milestone: "V2"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_WKUP_10a
