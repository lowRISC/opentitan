{
  name: "pinmux_fpv"
  // The requirements of the pinmux FPV testplan (doc/fpv/README.md), one entry each:
  //   name, desc   the requirement ID and its statement
  //   source      where the rule comes from: !!REGISTER.FIELD names a register field
  //               (reggen's form), a Markdown link names a document section or a key
  //   kind        "spec": a specification states the rule; "RTL": none does, and the
  //               rule follows the design's present behaviour or leaves the outcome
  //               to a specification question; a "spec" entry whose source list
  //               ends with "No specification states <part>." takes that one part
  //               from the design's present behaviour
  //   testpoint   its testpoint in pinmux_env_fpv_testplan.hjson
  //   checks      what decides it: "<check name> (<planned assertion>)", the CSR
  //               checker, or a check that waits on a specification question
  //   why         why those checks prove it
  //   milestone   the verification stage of its testpoint: V1, V2 or V2S
  //   priority    the order of work within a stage: "1" before "2"
  //   security    true when a security property depends on it
  //   state       "open" until its checks are proven; with a reason where no check
  //               of this plan decides it
  // The file holds, besides the entries:
  //   written_for   the top the plan was written for and read against
  //   rendered_for  the top of this copy
  //   terms         the words the requirements use, each with its meaning
  //   parameters    the values the top's configuration sets, which the
  //                 requirements name by parameter, with the key that sets each
  //   pad_roles     the roles of the pads the top description assigns, which the
  //                 requirements name by role
  //   groups        the requirements by feature; a group's conditions say when
  //                 its requirements hold and define its own words
  written_for: "earlgrey"
  rendered_for: "darjeeling"
  terms: [
    {
      name: '''`n`'''
      desc: '''MIO peripheral input, from 0 to `NMioPeriphIn` - 1'''
    }
    {
      name: '''`k`'''
      desc: '''MIO peripheral output, from 0 to `NMioPeriphOut` - 1'''
    }
    {
      name: '''`p`'''
      desc: '''MIO pad, from 0 to `NMioPads` - 1'''
    }
    {
      name: '''`d`'''
      desc: '''DIO pad, from 0 to `NDioPads` - 1'''
    }
    {
      name: '''Watched signal'''
      desc: '''The pad input that `MIODIO` and `PADSEL` pick'''
    }
    {
      name: '''Forwarded value'''
      desc: '''The watched signal sampled each `clk_aon_i` cycle, through the filter when `FILTER` is 1'''
    }
    {
      name: '''Asleep, awake'''
      desc: '''A pad is asleep while its sleep status bit is 1, awake while it is 0'''
    }
    {
      name: '''AON'''
      desc: '''The always-on domain: the logic on `clk_aon_i` and `rst_aon_ni`'''
    }
    {
      name: '''Lands'''
      desc: '''A written or sampled value lands in the cycle the register or flop it is meant for takes it'''
    }
    {
      name: '''Hardware write'''
      desc: '''A write to a register field made by the pinmux logic, not by software over the bus'''
    }
    {
      name: '''Allowed pad'''
      desc: '''A pad is allowed for a signal when the signal's pad list names the pad, or when the list is empty. The pad list is the signal's `pads` entry in the top's configuration ([top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson); [top_darjeeling_pinmux.ipconfig.hjson](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson) `mio_periph_ins`; [top_darjeeling_pinmux.ipconfig.hjson](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson) `mio_periph_outs`).'''
    }
  ]
  parameters: [
    {
      name: "NMioPeriphIn"
      desc: '''Number of muxed peripheral inputs'''
      value: 4
    }
    {
      name: "NMioPeriphOut"
      desc: '''Number of muxed peripheral outputs'''
      value: 5
    }
    {
      name: "NMioPads"
      desc: '''Number of muxed pads'''
      value: 12
    }
    {
      name: "NDioPads"
      desc: '''Number of dedicated pads'''
      value: 73
    }
    {
      name: "NWkupDetect"
      desc: '''Number of wakeup detectors'''
      value: 8
    }
    {
      name: "WkupCntWidth"
      desc: '''Width of a wakeup detector's counter, in bits'''
      value: 8
    }
  ]
  pad_roles: [
  ]
  groups: [
    {
      name: '''Input selection'''
      conditions: [
        '''Every row holds in every cycle.'''
        '''An input's pad list limits only the select values that name a pad. The constant selects 0 and 1 act the same on every input, with or without a pad list.'''
      ]
      requirements: [
        {
          name: REQ_IN_01
          desc: '''MIO peripheral input `n` shall read 0 while `MIO_PERIPH_INSEL_n` is 0.'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["reads tie 0 (assert_PadListen_ReadsTie0)"]
          why: '''In every cycle the check compares each MIO peripheral input whose select is 0 with 0.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_02
          desc: '''MIO peripheral input `n` shall read 1 while `MIO_PERIPH_INSEL_n` is 1.'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["reads tie 1 (assert_PadListen_ReadsTie1)"]
          why: '''In every cycle the check compares each MIO peripheral input whose select is 1 with 1.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_03
          desc: '''MIO peripheral input `n` shall read the input of MIO pad `p`, in the same cycle, while `MIO_PERIPH_INSEL_n` is 2 + `p` and pad `p` is allowed for input `n`. Here `p` runs from 0 to `NMioPads` - 1.'''
          source: [
            '''!!MIO_PERIPH_INSEL.IN'''
            '''[Muxing Matrix](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_pads`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_ins`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["reads selected pad (assert_PadListen_ReadsSelectedPad)"]
          why: '''The check compares each MIO peripheral input with `mio_in_i[p]` in the same cycle while its select is 2 + `p`, for every `p` from 0 to `NMioPads` - 1. For an input with a pad list, the check runs only over the pads that the list allows.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_04
          desc: '''MIO peripheral input `n` shall read 0 while `MIO_PERIPH_INSEL_n` is greater than `NMioPads` + 1. These select values name no pad.'''
          source: [
            '''!!MIO_PERIPH_INSEL'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_pads`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "pad_listen"
          checks: ["select without a pad reads 0 (assert_PadListen_SelectWithoutAPadReads0)"]
          why: '''While the select of a MIO peripheral input is greater than `NMioPads` + 1, the check compares the input with 0. These select values name no pad.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_05
          desc: '''DIO peripheral input `d` shall read the input of DIO pad `d`, in the same cycle, at every value of the pinmux registers.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
          ]
          kind: "spec"
          testpoint: "pad_listen"
          checks: ["DIO reads its pad (assert_PadListen_DioReadsItsPad)"]
          why: '''The check compares each DIO peripheral input with its own pad's bit of `dio_in_i` in the same cycle, at every value of the registers.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_06
          desc: '''After reset and until software writes its select, MIO peripheral input `n` shall read the pad input or the constant 0 or 1 that the top defines as its reset selection. An input with no reset selection defined shall read 0.'''
          source: [
            '''[Pinmux Configuration](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''[MIO and DIO Signal Categories](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
            '''!!MIO_PERIPH_INSEL.IN'''
            '''[top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_ins`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "reset_state"
          checks: ["input starts at default (assert_ResetState_InputStartsAtDefault)"]
          why: '''From reset until the input's select is written, the check compares the input with the input's default value in every cycle. For an input with no default, the check compares the input with 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_IN_07
          desc: '''MIO peripheral input `n` shall read 0 while `MIO_PERIPH_INSEL_n` is 2 + `p` and pad `p` is not allowed for input `n`.'''
          source: [
            '''[Muxing Matrix](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[Pinmux Configuration](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''!!MIO_PERIPH_INSEL.IN'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_ins`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "sparse_insel"
          checks: ["unlisted pad reads zero (assert_SparseInsel_UnlistedPadReadsZero)"]
          why: '''While the input select names a pad that the input's pad list does not allow, the check compares the input with 0 in the same cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Output selection'''
      conditions: [
        '''Every row holds while the pad is awake.'''
        '''A pad list limits only the select values that name a peripheral output, so the constant select values 0, 1 and 2 behave the same on every pad.'''
      ]
      requirements: [
        {
          name: REQ_OUT_01a
          desc: '''The output of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 0.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 0 drives 0 (assert_PadOutput_Tie0Drives0)"]
          why: '''While an awake pad's select is 0, the check compares the pad's output with 0 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_01b
          desc: '''The output enable of MIO pad `p` shall be 1 while `MIO_OUTSEL_p` is 0, so the pad drives 0.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 0 drives 0 (assert_PadOutput_Tie0Drives0)"]
          why: '''While an awake pad's select is 0, the check compares the pad's output enable with 1 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_02a
          desc: '''The output of MIO pad `p` shall be 1 while `MIO_OUTSEL_p` is 1.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 1 drives 1 (assert_PadOutput_Tie1Drives1)"]
          why: '''While an awake pad's select is 1, the check compares the pad's output with 1 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_02b
          desc: '''The output enable of MIO pad `p` shall be 1 while `MIO_OUTSEL_p` is 1, so the pad drives 1.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["tie 1 drives 1 (assert_PadOutput_Tie1Drives1)"]
          why: '''While an awake pad's select is 1, the check compares the pad's output enable with 1 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_03a
          desc: '''The output enable of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 2, so the pad is high-Z.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["select 2 is high-Z (assert_PadOutput_Select2IsHighZ)"]
          why: '''While an awake pad's select is 2, the check compares the pad's output enable with 0 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_03b
          desc: '''The output of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is 2.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["select 2 is high-Z (assert_PadOutput_Select2IsHighZ)"]
          why: '''While an awake pad's select is 2, the check compares the pad's output with 0 in every cycle.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_04a
          desc: '''MIO pad `p` shall carry peripheral output `k`, in the same cycle, while `MIO_OUTSEL_p` is 3 + `k` and pad `p` is allowed for output `k`. Here `k` runs from 0 to `NMioPeriphOut` - 1.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
            '''[Muxing Matrix](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_outs`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''While an awake pad's select is 3 + `k`, the check compares its output with `periph_to_mio_i[k]` in the same cycle, for `k` from 0 to `NMioPeriphOut` - 1. On a top with pad lists, the check skips outputs not allowed for the pad.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_04b
          desc: '''MIO pad `p` shall carry output enable `k`, in the same cycle, while `MIO_OUTSEL_p` is 3 + `k` and pad `p` is allowed for output `k`. Here `k` runs from 0 to `NMioPeriphOut` - 1.'''
          source: [
            '''!!MIO_OUTSEL.OUT'''
            '''[Muxing Matrix](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_outs`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["drives selected output (assert_PadOutput_DrivesSelectedOutput)"]
          why: '''While an awake pad's select is 3 + `k`, the check compares its output enable with `periph_to_mio_oe_i[k]` in the same cycle, for `k` from 0 to `NMioPeriphOut` - 1. On a top with pad lists, the check skips outputs not allowed for the pad.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_05a
          desc: '''The output enable of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is greater than `NMioPeriphOut` + 2, so the pad is high-Z. These select values name no peripheral output. On this top, `MIO_OUTSEL_p` has no value greater than `NMioPeriphOut` + 2, so this row does not apply.'''
          source: [
            '''!!MIO_OUTSEL'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "pad_output"
          checks: ["select without an output is high-Z (assert_PadOutput_SelectWithoutAnOutputIsHighZ)"]
          why: '''While an awake pad's select is greater than `NMioPeriphOut` + 2, the check compares the pad's output enable with 0. These select values name no peripheral output.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_05b
          desc: '''The output of MIO pad `p` shall be 0 while `MIO_OUTSEL_p` is greater than `NMioPeriphOut` + 2. These select values name no peripheral output. On this top, `MIO_OUTSEL_p` has no value greater than `NMioPeriphOut` + 2, so this row does not apply.'''
          source: [
            '''!!MIO_OUTSEL'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `n_mio_periph_out`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "RTL"
          testpoint: "pad_output"
          checks: ["select without an output is high-Z (assert_PadOutput_SelectWithoutAnOutputIsHighZ)"]
          why: '''While an awake pad's select is greater than `NMioPeriphOut` + 2, the check compares the pad's output with 0. These select values name no peripheral output.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_06a
          desc: '''DIO pad `d` shall carry its peripheral's output, in the same cycle.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["DIO drives its peripheral (assert_PadOutput_DioDrivesItsPeripheral)"]
          why: '''The check compares each awake DIO pad's output with `periph_to_dio_i[d]` in the same cycle, for any values that the registers hold.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_06b
          desc: '''DIO pad `d` shall carry its peripheral's output enable, in the same cycle.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
          ]
          kind: "spec"
          testpoint: "pad_output"
          checks: ["DIO drives its peripheral (assert_PadOutput_DioDrivesItsPeripheral)"]
          why: '''The check compares each awake DIO pad's output enable with `periph_to_dio_oe_i[d]` in the same cycle, for any values that the registers hold.'''
          milestone: "V1"
          priority: "1"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_07
          desc: '''After reset and until software writes its select, MIO pad `p` shall carry the peripheral output that the top defines as the pad's reset selection. A pad with no reset selection defined shall be high-Z.'''
          source: [
            '''[MIO and DIO Signal Categories](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#mio-and-dio-signal-categories)'''
            '''[Pinmux Configuration](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''!!MIO_OUTSEL.OUT'''
            '''[top_darjeeling.hjson](hw/top_darjeeling/data/top_darjeeling.hjson)'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_outs`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "reset_state"
          checks: ["pad starts at default (assert_ResetState_PadStartsAtDefault)"]
          why: '''From reset until the pad's select is written, the check compares an awake pad with the pad's default drive in every cycle. For a pad that no default names, the check requires output enable 0.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
        {
          name: REQ_OUT_08
          desc: '''MIO pad `p` shall be high-Z, with output enable 0 and output 0, while `MIO_OUTSEL_p` is 3 + `k` and pad `p` is not allowed for output `k`.'''
          source: [
            '''[Muxing Matrix](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#muxing-matrix)'''
            '''[Pinmux Configuration](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pinmux-configuration)'''
            '''!!MIO_OUTSEL.OUT'''
            '''[top_darjeeling_pinmux.ipconfig.hjson `mio_periph_outs`](hw/top_darjeeling/ip_autogen/pinmux/data/top_darjeeling_pinmux.ipconfig.hjson)'''
          ]
          kind: "spec"
          testpoint: "sparse_outsel"
          checks: ["unlisted output disables pad (assert_SparseOutsel_UnlistedOutputDisablesPad)", "disabled pad drives zero (assert_SparseOutsel_DisabledPadDrivesZero)"]
          why: '''While the pad's output select names an output whose pad list does not allow the pad, the checks compare the pad's `oe` and `out` with 0 in the same cycle.'''
          milestone: "V2"
          priority: "2"
          security: false
          state: "open"
        }
      ]
    }
    {
      name: '''Pad attributes'''
      conditions: [
        '''Every row holds in every cycle, whether the pad is asleep or awake.'''
        '''"Written" means a write that the register block accepts while the register's lock is open. The group Register locks gives the rules of a lock.'''
        '''"Reads back" means the value that a read of the register returns.'''
        '''A pad type "keeps" an attribute bit when the pads of that type implement the bit ([Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)).'''
        '''A pad type keeps the same bits on every pad of the type, and the bits that it keeps never change. No document lists the bits that each pad type keeps, so the rows fix only that the pads of one type agree.'''
        '''A one-bit field is kept when its bit is kept, and each bit of `slew_rate` and of `drive_strength` is kept or not kept on its own ([Pad Attributes](hw/top_darjeeling/ip_autogen/pinmux/doc/programmers_guide.md#pad-attributes)).'''
      ]
      requirements: [
        {
          name: REQ_ATTR_01a
          desc: '''The `invert` field of the attribute output of MIO pad `p` shall equal the value that the `invert` field of `MIO_PAD_ATTR_p` reads back.'''
          source: [
            '''!!MIO_PAD_ATTR.invert'''
            '''[Type RW HWExt](util/reggen/README.md#type-rw-hwext)'''
            '''[Generic Pad Wrapper](hw/top_darjeeling/ip_autogen/pinmux/doc/theory_of_operation.md#generic-pad-wrapper)'''
          ]
          kind: "spec"
          testpoint: "pad_attr"
          checks: ["pad gets read-back (assert_PadAttr_PadGetsReadBack)"]
