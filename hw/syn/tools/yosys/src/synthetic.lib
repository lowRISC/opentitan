SPDX-License-Identifier: Apache-2.0

Minimal synthetic library designed to quickly estimate
area and relative timing of digital circuits.

The area is derived from transistor sizing and topology of each cell.
Area is scaled to directly report NAND2 gate-equivalent.
An extra 0.1GE offset is applied to punish using more cells,
this can be intepreted as extra area for aligning to site multiples.
Do not normalize to the effective NAND2 size of 1.1 for GE!

Timing uses a topology-informed, linear capacitive-load model
for each pin-to-output arc and rise/fall direction:
t=\tau\left[\max(p-1,0)+k,\frac{C_\text{load}}{C_\text{unit}}\right]
Where:
- tau is an arbitrary time scale (10ps)
- p is an arc-specific topology proxy for the transistor stack-depth.
- k is a shared linear loading coefficient (1)
- C_{load} is the total connected load capacitance
- C_{unit} is the normalized load (1fF)

Input capacitance approximate the topology-dependent loading.
The model ignores slew and explicit drive strengths.
********************************************************************/
library (synthetic_compound_caps_unlimited) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);
  default_input_pin_cap : 0.001;
  default_output_pin_cap : 0;
  default_inout_pin_cap : 0.001;
  default_fanout_load : 1;
  input_threshold_pct_rise : 50;
  output_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;
  nom_process : 1;
  nom_temperature : 25;
  nom_voltage : 1;
  operating_conditions (analytical) {
    process : 1; temperature : 25; voltage : 1; tree_type : balanced_tree;
  }
  default_operating_conditions : analytical;
  lu_table_template (analytical_delay) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.002, 0.01, 0.05, 0.2");
    index_2 ("0.00025, 0.001, 0.004, 0.016, 0.032");
  }

  cell (buf) {
    area : 1.1;
    pin (a_i) {
      direction : input;
      capacitance : 0.001;
      rise_capacitance : 0.001;
      fall_capacitance : 0.001;
      fanout_load : 1;
    }
    pin (y_o) {
      direction : output;
      function : "a_i";
      timing () {
        related_pin : "a_i";
        timing_sense : positive_unate;
        cell_rise (analytical_delay) {
          values ("0.0125, 0.02, 0.05, 0.17, 0.33", "0.0125, 0.02, 0.05, 0.17, 0.33", "0.0125, 0.02, 0.05, 0.17, 0.33", "0.0125, 0.02, 0.05, 0.17, 0.33");
        }
        rise_transition (analytical_delay) {
          values ("0.01, 0.01, 0.01, 0.01, 0.01", "0.01, 0.01, 0.01, 0.01, 0.01", "0.01, 0.01, 0.01, 0.01, 0.01", "0.01, 0.01, 0.01, 0.01, 0.01");
        }
        cell_fall (analytical_delay) {
          values ("0.0125, 0.02, 0.05, 0.17, 0.33", "0.0125, 0.02, 0.05, 0.17, 0.33", "0.0125, 0.02, 0.05, 0.17, 0.33", "0.0125, 0.02, 0.05, 0.17, 0.33");
        }
        fall_transition (analytical_delay) {
          values ("0.01, 0.01, 0.01, 0.01, 0.01", "0.01, 0.01, 0.01, 0.01, 0.01", "0.01, 0.01, 0.01, 0.01, 0.01", "0.01, 0.01, 0.01, 0.01, 0.01");
        }
      }
    }
  }

