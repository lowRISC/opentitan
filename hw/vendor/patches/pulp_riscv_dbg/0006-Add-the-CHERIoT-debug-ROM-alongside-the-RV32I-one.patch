+     88c: f1402473     	csrr	s0, mhartid
+     890: 10852823     	ct.csw	s0, 0x110(a0)
+     894: 03a0055b     	ct.cspecialr	a0, 26
+     898: 0390045b     	ct.cspecialr	s0, 25
