From 15e41c11d22110cbe0becc49978d665719c5e420 Mon Sep 17 00:00:00 2001
From: Samuel Riedel <sriedel@lowrisc.org>
Date: Fri, 18 Sep 2026 17:17:12 +0200
Subject: [PATCH 06/12] Add the CHERIoT debug ROM alongside the RV32I one

Signed-off-by: Samuel Riedel <sriedel@lowrisc.org>
---
 debug_rom/Makefile               |  32 +++++++-
 debug_rom/debug_rom_cheriot.S    | 135 +++++++++++++++++++++++++++++++
 debug_rom/debug_rom_cheriot.dump |  60 ++++++++++++++
 debug_rom/debug_rom_cheriot.sv   |  76 +++++++++++++++++
 debug_rom/link_cheriot.ld        |  12 +++
 5 files changed, 314 insertions(+), 1 deletion(-)
 create mode 100644 hw/vendor/pulp_riscv_dbg/debug_rom/debug_rom_cheriot.S
 create mode 100644 hw/vendor/pulp_riscv_dbg/debug_rom/debug_rom_cheriot.dump
 create mode 100644 hw/vendor/pulp_riscv_dbg/debug_rom/debug_rom_cheriot.sv
 create mode 100644 hw/vendor/pulp_riscv_dbg/debug_rom/link_cheriot.ld

diff --git a/debug_rom/Makefile b/debug_rom/Makefile
index 931e253..fbe43f2 100644
--- a/debug_rom/Makefile
+++ b/debug_rom/Makefile
@@ -7,8 +7,24 @@ OBJCOPY?=riscv64-unknown-elf-objcopy
 OBJDUMP?=riscv64-unknown-elf-objdump
 PYTHON?=python3
 
+# The CHERIoT park loop is assembled with the CHERIoT LLVM toolchain rather than a RISC-V GCC, so
+# it is deliberately not part of the "all" target.
+cheriot_debug_rom = debug_rom_cheriot.sv debug_rom_cheriot.dump
+
+CHERIOT_LLVM_ROOT?=/opt/cheriot-llvm/bin
+CHERIOT_CXX?=$(CHERIOT_LLVM_ROOT)/clang++
+CHERIOT_OBJCOPY?=$(CHERIOT_LLVM_ROOT)/llvm-objcopy
+CHERIOT_OBJDUMP?=$(CHERIOT_LLVM_ROOT)/llvm-objdump
+CHERIOT_LD?=$(CHERIOT_LLVM_ROOT)/ld.lld
+CHERIOT_TARGET_FLAGS?=-target riscv32-unknown-unknown -mcpu=cheriot -mabi=cheriot \
+                      -mxcheri-rvc -mrelax -fshort-wchar -nostdinc
+
 all: $(debug_rom)
 
+cheriot: $(cheriot_debug_rom)
+
+.PHONY: all cheriot clean
+
 %.sv: %.img
 	$(PYTHON) gen_rom.py $<
 
@@ -24,5 +40,19 @@ all: $(debug_rom)
 %.dump: %.elf
 	$(OBJDUMP) -d $< --disassemble-all --disassemble-zeroes --section=.text --section=.text.startup --section=.text.init --section=.data  > $@
 
+# Explicit rules for the CHERIoT ROM. make prefers these over the pattern rules above, which would
+# otherwise use the RISC-V toolchain.
+debug_rom_cheriot.o: debug_rom_cheriot.S
+	$(CHERIOT_CXX) -c $(CHERIOT_TARGET_FLAGS) -DSND_SCRATCH=1 $< -nostdlib -fPIC -static -o $@
+
+debug_rom_cheriot.elf: debug_rom_cheriot.o link_cheriot.ld
+	$(CHERIOT_LD) --script=link_cheriot.ld --relax -o $@ $<
+
+debug_rom_cheriot.bin: debug_rom_cheriot.elf
+	$(CHERIOT_OBJCOPY) -O binary $< $@
+
+debug_rom_cheriot.dump: debug_rom_cheriot.elf
+	$(CHERIOT_OBJDUMP) -d $< --disassemble-all --disassemble-zeroes --section=.text > $@
+
 clean:
-	rm -f *.img *.dump *.bin *.sv
+	rm -f *.img *.dump *.bin *.o *.elf *.sv
diff --git a/debug_rom/debug_rom_cheriot.S b/debug_rom/debug_rom_cheriot.S
new file mode 100644
index 0000000..530ecde
--- /dev/null
+++ b/debug_rom/debug_rom_cheriot.S
@@ -0,0 +1,135 @@
+// See LICENSE.SiFive for license details.
+
+// Conversion to CHERIoT Ibex ISA from RISC-V
+//   Copyright SCI Semiconductor 2025
+
+#include "encoding.h"
+
+// The debugger can assume as second scratch register.
+// # define SND_SCRATCH 1
+// These are implementation-specific addresses in the Debug Module
+#define HALTED    0x100
+#define GOING     0x108
+#define RESUMING  0x110
+#define EXCEPTION 0x118
+
+// Region of memory where each hart has 1
+// byte to read.
+#define FLAGS 0x400
+#define FLAG_GO     0
+#define FLAG_RESUME 1
+
+#define CSR_DSCRATCHC0 0x19
+#define CSR_DSCRATCHC1 0x1a
+
+.section .text
+        .option norvc
+        .global entry
+        .global exception
+        .global whereto
+
+        // Entry location on ebreak, Halt, or Breakpoint
+        // It is the same for all harts. They branch when
+        // their GO or RESUME bit is set.
+
+        // Each entry is padded to 8 bytes, as in debug_rom.S: dm_pkg places ResumeAddress at
+        // HaltAddress + 8 and ExceptionAddress at HaltAddress + 16.
+entry:
+       cj _entry
+       nop
+resume:
+       cj _resume
+       nop
+exception:
+       cj _exception
+       nop
+
+
+
+_entry:
+        // This fence is required because the execution may have written something
+        // into the Abstract Data or Program Buffer registers.
+        fence
+        CSpecialRW c0, CSR_DSCRATCHC0, cs0       // Save s0 to allow signaling MHARTID
+#ifdef SND_SCRATCH
+        CSpecialRW c0, CSR_DSCRATCHC1, ca0       // Save a0 to allow loading arbitrary DM base
+        auipcc ca0, 0                // Get PC
+        srli a0, a0, 12              // And throw away lower 12 bits to get the DM base
+        slli a0, a0, 12
+#endif
+        // We continue to let the hart know that we are halted in order that
+        // a DM which was reset is still made aware that a hart is halted.
+        // We keep checking both whether there is something the debugger wants
+        // us to do, or whether we should resume.
+entry_loop:
+        csrr s0, CSR_MHARTID
+#ifdef SND_SCRATCH
+        csw  s0, HALTED(ca0)
+        add  s0, s0, a0
+#else
+        sw   s0, HALTED(zero)
+#endif
+        clbu s0, FLAGS(cs0) // 1 byte flag per hart. Only one hart advances here.
+        andi s0, s0, (1 << FLAG_GO)
+        bnez s0, going
+        csrr s0, CSR_MHARTID
+#ifdef SND_SCRATCH
+        add  s0, s0, a0
+#endif
+        clbu s0, FLAGS(cs0) // multiple harts can resume  here
+        andi s0, s0, (1 << FLAG_RESUME)
+        bnez s0, resume
+        cj   entry_loop
+
+_exception:
+        // We can only get here due to an exception while in debug mode. Hence,
+        // we do not need to save a0 to a scratch register as it has already
+        // been saved on debug entry.
+#ifdef SND_SCRATCH
+        auipcc ca0, 0                  // Get POC
+        srli a0, a0, 12              // And throw away lower 12 bits to get the DM base
+        slli a0, a0, 12
+        csw  zero, EXCEPTION(ca0)     // Let debug module know you got an exception.
+        // It is safe to always restore the scratch registers here as they must
+        // have been saved on debug entry. Restoring them here avoids issues
+        // with registers being overwritten by exceptions occuring during
+        // program buffer execution.
+        CSpecialRW ca0, CSR_DSCRATCHC1, c0       // Restore a0 here
+#else
+        sw   zero, EXCEPTION(zero)     // Let debug module know you got an exception.
+#endif
+        CSpecialRW cs0, CSR_DSCRATCHC0, c0       // Restore s0 here
+        ebreak
+
+going:
+#ifdef SND_SCRATCH
+        csw zero, GOING(ca0)          // When debug module sees this write, the GO flag is reset.
+        CSpecialRW ca0, CSR_DSCRATCHC1, c0      // Restore a0 here
+#else
+        sw zero, GOING(zero)          // When debug module sees this write, the GO flag is reset.
+#endif
+        CSpecialRW cs0, CSR_DSCRATCHC0, c0      // Restore s0 here
+        cj   whereto
+
+_resume:
+        csrr s0, CSR_MHARTID
+#ifdef SND_SCRATCH
+        csw   s0, RESUMING(ca0)   // When Debug Module sees this write, the RESUME flag is reset.
+        CSpecialRW ca0, CSR_DSCRATCHC1, c0  // Restore a0 here
+#else
+        sw   s0, RESUMING(zero)   // When Debug Module sees this write, the RESUME flag is reset.
+#endif
+        CSpecialRW cs0, CSR_DSCRATCHC0, c0  // Restore s0 here
+        dret
+
+        // END OF ACTUAL "ROM" CONTENTS. BELOW IS JUST FOR LINKER SCRIPT.
+
+.section .whereto
+whereto:
+        nop
+        // Variable "ROM" This is : jal x0 abstract, jal x0 program_buffer,
+        //                or jal x0 resume, as desired.
+        //                Debug Module state machine tracks what is 'desired'.
+        //                We don't need/want to use jalr here because all of the
+        //                Variable ROM contents are set by
+        //                Debug Module before setting the OK_GO byte.
