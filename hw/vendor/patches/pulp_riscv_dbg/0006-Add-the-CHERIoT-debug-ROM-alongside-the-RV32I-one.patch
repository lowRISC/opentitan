+     854: 00247413     	andi	s0, s0, 0x2
+     858: fa0418e3     	bnez	s0, 0x808 <resume>
+     85c: fd5ff06f     	j	0x830 <entry_loop>
+
+00000860 <_exception>:
+     860: 00000517     	ct.auipcc	a0, 0x0
