From bb2b878594eb7164e3cf4d18c0e7d0e63790087e Mon Sep 17 00:00:00 2001
From: Samuel Riedel <sriedel@lowrisc.org>
Date: Fri, 18 Sep 2026 18:07:51 +0200
Subject: [PATCH 07/11] Add a runtime CHERIoT mode input to dm_top and dm_mem

Signed-off-by: Samuel Riedel <sriedel@lowrisc.org>

diff --git a/src/dm_mem.sv b/src/dm_mem.sv
index f7a5f7d..3aa52f2 100755
--- a/src/dm_mem.sv
+++ b/src/dm_mem.sv
@@ -21,12 +21,15 @@ module dm_mem #(
   parameter int unsigned        BusWidth         = 32,
   parameter logic [NrHarts-1:0] SelectableHarts  = {NrHarts{1'b1}},
   parameter int unsigned        DmBaseAddress    = '0,
+  parameter bit                 CheriotSupport   = 1'b0,
   localparam int unsigned       BeWidth          = BusWidth/8
 ) (
   input  logic                             clk_i,       // Clock
   input  logic                             rst_ni,      // debug module reset
 
   output logic [NrHarts-1:0]               debug_req_o,
+  // Select CHERIoT mode
+  input  prim_mubi_pkg::mubi4_t            cheriot_enable_i,
   input  logic                             ndmreset_i,
   input  logic [19:0]                      hartsel_i,
   // from Ctrl and Status register
diff --git a/src/dm_top.sv b/src/dm_top.sv
index 87b480a..e302e40 100644
--- a/src/dm_top.sv
+++ b/src/dm_top.sv
@@ -24,6 +24,8 @@ module dm_top #(
   // Bitmask to select physically available harts for systems
   // that don't use hart numbers in a contiguous fashion.
   parameter logic [NrHarts-1:0] SelectableHarts  = {NrHarts{1'b1}},
+  // Include the CHERIoT debug ROM and let cheriot_enable_i select CHERIoT mode
+  parameter bit                 CheriotSupport   = 1'b0,
   // toggle new behavior to drive master_be_o during a read
   parameter bit                 ReadByteEnable   = 1
 ) (
@@ -36,6 +38,8 @@ module dm_top #(
   // register is a word address and not a byte address. This value is passed in as a static signal
   // so that it becomes possible to assign this value with chiplet tie-offs or straps, if needed.
   input  logic [31:0]           next_dm_addr_i,
+  // Select CHERIoT mode
+  input  prim_mubi_pkg::mubi4_t cheriot_enable_i,
   input  logic                  testmode_i,
   output logic                  ndmreset_o,  // non-debug module reset
   input  logic                  ndmreset_ack_i, // non-debug module reset acknowledgement pulse
@@ -208,11 +212,13 @@ module dm_top #(
     .NrHarts(NrHarts),
     .BusWidth(BusWidth),
     .SelectableHarts(SelectableHarts),
+    .CheriotSupport(CheriotSupport),
     .DmBaseAddress(DmBaseAddress)
   ) i_dm_mem (
     .clk_i,
     .rst_ni,
     .debug_req_o,
+    .cheriot_enable_i,
     .ndmreset_i              ( ndmreset              ),
     .hartsel_i               ( hartsel               ),
     .haltreq_i               ( haltreq               ),
