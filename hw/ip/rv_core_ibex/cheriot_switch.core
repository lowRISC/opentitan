name: "lowrisc:ip:cheriot_switch:0.1"
description: "Write-once ePMP/CHERIoT execution mode switch"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:all
      - lowrisc:prim:mubi

    files:
      - rtl/cheriot_switch.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
