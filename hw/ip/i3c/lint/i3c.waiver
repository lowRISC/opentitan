# waiver file for I3C Controller/Target

## Clocks derived from the I3C bus
waive -rules {CLOCK_MUX} -location {i3c_core.sv} \
      -regexp {Clock 'targ_(scl_buf|scl_buf_n|sda0_clk|sda0_clk_n)' is driven by a multiplexer here} \
      -comment "The Target-side input buffers gate SCL and SDA when disabled and select the scan clock in scan mode."
waive -rules {CLOCK_MUX} -location {i3c_core.sv} \
      -regexp {Clock 'targ_bus_obs_i\.sda\[0\]' reaches a multiplexer here} \
      -comment "The Target-side input buffers gate SCL and SDA when disabled and select the scan clock in scan mode."
waive -rules {CLOCK_USE} -location {i3c_core.sv} \
      -regexp {'targ_bus_obs_i\.(scl|sda\[0\])' is connected to 'prim_flop_2sync' port 'd_i\[[01]\]', and used as a clock} \
      -comment "The bus levels are also synchronized into clk_i to report them to software and to time bus inactivity."
waive -rules {CLOCK_USE INV_CLOCK} -location {i3c_patt_detector.sv} \
      -regexp {'scl_buf_i' is (used for some other purpose, and|inverted, used) as clock} \
      -comment "SCL high resets the HDR Exit and Restart Pattern Detector, as in the example design of the I3C Basic specification (section 6.1.2.1)."
waive -rules {CLOCK_USE INV_CLOCK} -location {i3c_target_trx.sv} \
      -regexp {'scl_i' is (used for some other purpose, and|inverted, used) as clock} \
      -comment "SDA edges sample SCL to detect START, Repeated START and STOP conditions."
