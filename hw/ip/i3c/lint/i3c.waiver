# waiver file for I3C Controller/Target

## Clocks derived from the I3C bus
waive -rules {CLOCK_MUX} -location {i3c_core.sv} \
      -regexp {Clock 'targ_(scl_buf|scl_buf_n|sda0_clk|sda0_clk_n)' is driven by a multiplexer here} \
      -comment "The Target-side input buffers gate SCL and SDA when disabled and select the scan clock in scan mode."
waive -rules {CLOCK_MUX} -location {i3c_core.sv} \
      -regexp {Clock 'targ_bus_obs_i\.sda\[0\]' reaches a multiplexer here} \
      -comment "The Target-side input buffers gate SCL and SDA when disabled and select the scan clock in scan mode."
waive -rules {CLOCK_USE} -location {i3c_core.sv} \
      -regexp {'targ_bus_obs_i\.(scl|sda\[0\])' is connected to 'prim_flop_2sync' port 'd_i\[[01]\]', and used as a clock} \
      -comment "The bus levels are also synchronized into clk_i to report them to software and to time bus inactivity."
waive -rules {CLOCK_USE INV_CLOCK} -location {i3c_patt_detector.sv} \
      -regexp {'scl_buf_i' is (used for some other purpose, and|inverted, used) as clock} \
      -comment "SCL high resets the HDR Exit and Restart Pattern Detector, as in the example design of the I3C Basic specification (section 6.1.2.1)."
waive -rules {CLOCK_USE INV_CLOCK} -location {i3c_target_trx.sv} \
      -regexp {'scl_i' is (used for some other purpose, and|inverted, used) as clock} \
      -comment "SDA edges sample SCL to detect START, Repeated START and STOP conditions."

## Asynchronous resets
waive -rules {RESET_DRIVER} -location {i3c_core.sv} \
      -regexp {'targ_trx_rst_n' is driven by instance 'u_targ_rst_src' of module 'prim_flop'} \
      -comment "A flop in the clk_i domain drives the reset of the Target transceiver, so that the reset is free of glitches. The transceiver is clocked by SCL and SDA and has no free-running clock."
waive -rules {RESET_USE} -location {i3c_core.sv} \
      -regexp {'targ_trx_rst_n' is used for some other purpose, and as asynchronous reset} \
      -comment "The Target transceiver reset is also reported to software and restarts the Bus Available timer."
waive -rules {RESET_DRIVER} -location {i3c_patt_detector.sv} \
      -regexp {'(scl_rst_n|restart_rst_n)' is driven here, and used as an asynchronous reset} \
      -comment "The HDR Exit and Restart Pattern Detector has asynchronous resets derived from SCL and the enables, as in the example design of the I3C Basic specification (section 6.1.2.1)."
waive -rules {RESET_USE} -location {i3c_core.sv} \
      -regexp {'rst_ni' is connected to 'i3c_patt_detector' port 'rst_ni', and used as an asynchronous reset} \
      -comment "The HDR Exit and Restart Pattern Detector combines rst_ni into its asynchronous resets."
waive -rules {RESET_USE} -location {i3c_dxt.sv} \
      -regexp {'rst_ni' is connected to 'prim_ram_1p' port 'rst_ni', and used as an asynchronous reset or set} \
      -comment "rst_ni is the asynchronous reset of prim_ram_1p. It is unused in the generic implementation, but other implementations may use it."

## Parameters
waive -rules {PARAM_NOT_USED} -location {i3c_controller.sv i3c_controller_trx.sv} \
      -regexp {Parameter '(PrimaryCtrl|SecondaryCtrl)' not used} \
      -comment "The Controller logic does not yet distinguish between the Primary and the Secondary Controller role (see #31308)."
