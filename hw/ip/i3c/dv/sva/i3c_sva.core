# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:dv:i3c_sva:0.1"
description: "I3C assertion modules and bind file."
filesets:
  files_dv:
    depend:
      - lowrisc:tlul:headers
      - lowrisc:fpv:csr_assert_gen
    files:
      - i3c_bind.sv
    file_type: systemVerilogSource

  files_formal:
    depend:
      - lowrisc:ip:i3c

generate:
  csr_assert_gen:
    generator: csr_assert_gen
    parameters:
      spec: ../../data/i3c.hjson

targets:
  default: &default_target
    filesets:
      - files_dv
    generate:
      - csr_assert_gen
  formal:
    <<: *default_target
    filesets:
      - files_formal
      - files_dv
    toplevel: i3c
