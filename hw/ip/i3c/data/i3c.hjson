{
  name:               "i3c",
  human_name:         "I3C",
  one_line_desc:      "I3C Controller/Target",
  one_paragraph_desc: '''
                      I3C IP block that implements the MIPI Alliance Improved Inter-Integrated Chip (I3C) protocol.
                      The IP block provides both Controller- and Target-side functionality.
                      The Controller-side logic implement both the I3C Transaction Command Response Interface (TCRI) and the I3C Host Controller Interface (HCI).
                      On the Target side a bespoke Target Transaction Interface (TTI) is specified and implemented, supporting up to four Virtual Targets.
                      '''
  // Unique comportable IP identifier defined under KNOWN_CIP_IDS in the regtool.
  cip_id:             "47",
  design_spec:        "../doc",
  dv_doc:             "../doc/dv",
  hw_checklist:       "../doc/checklist",
  sw_checklist:       "/sw/device/lib/dif/dif_i3c",
  revisions: [
    {
      version:            "0.1.0",
      life_stage:         "L1",
      design_stage:       "D0",
      verification_stage: "V0",
      commit_id:          "",
      notes:              ""
    }
  ]
  clocking: [
    {clock: "clk_i", reset: "rst_ni", primary: true}
    {clock: "clk_aon_i", reset: "rst_aon_ni"},
    // The scan_rst_ni port isn't listed here because it's generated by the
    // "scan_reset: true" below.
    {clock: "scan_clk_i"}
  ],
  bus_interfaces: [
    { protocol: "tlul", direction: "device", racl_support: true }
  ],
  available_inout_list: [
  ],
  available_input_list: [
  ],
  available_output_list: [
    { name: "ctrl_scl_pu_en", desc: "I3C Controller clock Pullup enable output" }
    { name: "ctrl_sda_pu_en", desc: "I3C Controller data Pullup enable output" }
    { name: "scl_hk_en", desc: "I3C Controller clock High-keeper enable output" }
    { name: "sda_hk_en", desc: "I3C Controller data High-keeper enable output" }
  ],
  interrupt_list: [
    // Global HCI interrupt, asserted when any HCI interrupt is pending.
    { name:    "hci",
      type:    "status",
      default: "0",
      desc:    "HCI interrupt."
    }
    // Global Target interrupt, asserted when any Target interrupt is pending.
    { name:    "targ",
      type:    "status",
      default: "0",
      desc:    "Target interrupt."
    }
  ],
  alert_list: [
    { name: "fatal_fault",
      desc: "This fatal alert is triggered when a fatal TL-UL bus integrity fault is detected."
    }
  ],
  inter_signal_list: [
    { struct:  "i3c_ctrl_bus_drv",
      package: "i3c_io_pkg",
      type:    "uni",
      name:    "cio_ctrl_bus_drv",
      act:     "req"
    }
    { struct:  "i3c_ctrl_bus_obs",
      package: "i3c_io_pkg",
      type:    "uni",
      name:    "cio_ctrl_bus_obs",
      act:     "rcv"
    }
    { struct:  "i3c_targ_bus_drv",
      package: "i3c_io_pkg",
      type:    "uni",
      name:    "cio_targ_bus_drv",
      act:     "req"
    }
    { struct:  "i3c_targ_bus_obs",
      package: "i3c_io_pkg",
      type:    "uni",
      name:    "cio_targ_bus_obs",
      act:     "rcv"
    }
    { struct:  "logic",
      package: "",
      type:    "uni",
      name:    "rstdet_enable",
      act:     "req"
    }
    // TODO: Combine the following two entries to become a `req_rsp?`
    { struct:  "i3c_rstdet_req"
      package: "i3c_pkg"
      type:    "uni"
      name:    "rstdet_req"
      act:     "req"
    }
    { struct:  "i3c_rstdet_rsp"
      package: "i3c_pkg"
      type:    "uni"
      name:    "rstdet_rsp"
      act:     "rcv"
    }
    { struct:  "logic"
      package: ""
      type:    "uni"
      name:    "mbist_en"
      act:     "rcv"
    }
    // RAM configuration
    { struct:  "ram_1p_cfg"
      package: "prim_ram_1p_pkg"
      type:    "req_rsp"
      name:    "ram_cfg"
      act:     "rsp"
    }
    { struct:  "ram_1p_cfg"
      package: "prim_ram_1p_pkg"
      type:    "req_rsp"
      name:    "dat_cfg"
      act:     "rsp"
    }
    { struct:  "ram_1p_cfg"
      package: "prim_ram_1p_pkg"
      type:    "req_rsp"
      name:    "dct_cfg"
      act:     "rsp"
    }
    { struct:  "racl_policy_vec",
      type:    "uni",
      name:    "racl_policies",
      act:     "rcv",
      package: "top_racl_pkg",
      desc:    '''Incoming RACL policy vector from a racl_ctrl instance.
               The policy selection vector (parameter) selects the policy for each register.
               '''
    }
    { struct:  "racl_error_log",
      type:    "uni",
      name:    "racl_error",
      act:     "req",
      width:   "1"
      package: "top_racl_pkg",
      desc:    "RACL error log information of this module."
    }
  ]
  scan: "true",       // Enable `scanmode_i` port
  scan_reset: "true", // Enable `scan_rst_ni` port
  param_list: [
    // Device Address Table size in bus words; each entry consumes 8 bytes of address space.
    { name:    "NumDATWords",
      type:    "int unsigned",
      default: "64",
      desc:    "Size of the Device Address Table in bus words."
    },
    // Device Characteristics Table size in bus words; each entry consumes 16 bytes of address space.
    { name:    "NumDCTWords",
      type:    "int unsigned",
      default: "128",
      desc:    "Size of the Device Characteristics Table in bus words."
    }
    { name:    "MaxTargets",
      type:    "int unsigned",
      default: "4",
      desc:    "The maximum number of Virtual Targets supported."
    }
    { name:    "MaxGroups",
      type:    "int unsigned",
      default: "8",
      desc:    "The maximum number of Group Addresses supported on the Target side."
    }
  ]
  regwidth: "32",
  registers: [
    { name:     "INFO",
      desc:     "IP block information, allowing software to adapt dynamically.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "28:18"
          name:   "BUF_DWORD_MAX",
          desc:   '''Index of the final DWORD of the shared Message Buffer.
                  i.e. one less than its size in DWORDs.
                  ''',
          resval: "0x3ff"
        }
        { bits:   "17:13",
          name:   "DCT_ENTRY_MAX",
          desc:   '''Index of the final entry of the HCI Device Characteristics Table.
                  i.e. one less than the number of entries.
                  ''',
          resval: "31"
        }
        { bits:   "12:8",
          name:   "DAT_ENTRY_MAX",
          desc:   '''Index of the final entry of the HCI Device Address Table.
                  i.e. one less than the number of entries.
                  ''',
          resval: "31"
        }
        { bits:   "7:4",
          name:   "VERSION",
          desc:   "Version number of the IP block.",
          resval: "1"
        }
        { bits:   "3:0",
          name:   "REVISION",
          desc:   "Revision number of the IP block.",
          resval: "0"
        }
      ]
    }
    { name:     "CTRL_STATUS",
      desc:     "Controller-side Status register.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "PRESENT",
          desc:   "Indicates the presence of Controller functionality.",
          resval: "1"
        }
      ]
    }
    { name: "CTRL_ERROR",
      desc: "Controller Error counts."
      swaccess: "rw1c",
      hwaccess: "hrw",
      fields: [
        { bits:   "15:12",
          name:   "CE3",
          desc:   "Count of type 3 Controller Errors.",
          resval: "0"
        }
        { bits:   "11:8",
          name:   "CE2",
          desc:   "Count of type 2 Controller Errors.",
          resval: "0"
        }
        { bits:   "7:4",
          name:   "CE1",
          desc:   "Count of type 1 Controller Errors.",
          resval: "0"
        }
        { bits:   "3:0",
          name:   "CE0",
          desc:   "Count of type 0 Controller Errors.",
          resval: "0"
        }
      ]
    }
    { name: "TARG_CONTROL",
      desc: "Target Control register.",
      fields: [
        { bits:     "31",
          name:     "RESET",
          desc:     '''Software reset of Target logic.

                    Iff the Standby Controller support is disabled by clearing `STBY_CR_SUPPORT`, writing '1' to this field will reset all of the Target-side logic.
                    To reset the Target-side logic when Standby Controller support is enabled, software shall instead use the `SOFT_RST` field of the HCI-specified `RESET_CONTROL` register, whether or not the Controller is currently the Active Controller.
                    ''',
          hwqe:     "true",
          swaccess: "wo",
          hwaccess: "hro",
          resval:   "0"
        }
        { bits:     "30",
          name:     "HJ_REQUEST",
          desc:     '''Issue Hot-Join request.

                    This applies to all Virtual Targets since they share a single physical Target.
                    Software shall set this to '1' to issue the request, and the hardware will clear it when the request has been sent and acknowledged.
                    ''',
          hwqe:     "true",
          swaccess: "rw",
          hwaccess: "hrw",
          resval:   "0"
        }
        { bits:     "4",
          name:     "CRHDLY1_SET_AS",
          desc:     '''Set Bus Activity State.
                    This information is returned in response to the CRHDLY form of the GETMXDS CCC.
                    ''',
          swaccess: "rw",
          hwaccess: "hro",
          resval:   "0"
        }
        { bits:     "3:2",
          name:     "CRHDLY1_AS",
          desc:     '''Controller Handoff Activity State.
                    This information is returned in response to the CRHDLY form of the GETMXDS CCC.
                    ''',
          swaccess: "rw",
          hwaccess: "hro",
          resval:   "0"
        }
        { bits:     "1",
          name:     "STBY_CR_SUPPORT",
          desc:     '''Standby Controller role supported.

                    When set the Controller shall have the option of performing Controller Role Handoff and switching into Standby Controller mode.
                    If this field is clear the Controller will refuse to hand off the bus when requested and will instead remain the Active Controller,
                    thus freeing up the first Virtual Target to operate independently as a dedicated Target device.
                    '''
          swaccess: "rw",
          hwaccess: "hro",
          resval:   "1"
        }
        { bits:     "0",
          name:     "EN",
          desc:     '''Target enable.

                    Enable the Target-side logic as a separate I3C device, instead of supporting Standby Controller mode.
                    In this configuration the Controller-side logic must remain the Active Controller and cannot perform Controller Role Handoff.
                    ''',
          swaccess: "rw",
          hwaccess: "hro",
          resval:   "0"
        }
      ]
    }
    { name:     "TARG_STATUS",
      desc:     "Target-side Status register",
      swaccess: "ro",
      hwext:    "true",
      fields: [
        { bits:     "31",
          name:     "PRESENT",
          desc:     "Indicates the presence of Target functionality.",
          hwaccess: "hwo",
          resval:   "1"
        }
        { bits:     "30",
          name:     "ACTIVE",
          desc:     "Indicates whether the Target functionality is presently active, as opposed to under reset.",
          hwaccess: "hwo",
          resval:   "0"
        }
        { bits:     "26",
          name:     "PROTOCOL_ERROR",
          desc:     "Protocol error detected since the last GETSTATUS CCC to read this indicator.",
          hwaccess: "hrw",
          hwqe:     "true",
          resval:   "0"
        }
        { bits:     "25",
          name:     "VTM",
          desc:     "Vendor Test Mode active, in response to ENTTM.",
          hwaccess: "hwo",
          resval:   "0"
        }
        { bits:     "24",
          name:     "RSTACT_VIRT_TARG_DET",
          desc:     "RSTACT Virtual Target Detect.",
          hwaccess: "hwo",
          resval:   "0"
        }
        { bits:     "23:16",
          name:     "RSTACT",
          desc:     "Configured Target Reset action.",
          hwaccess: "hwo",
          resval:   "0"
        }
        { bits:     "15",
          name:     "EXT_PRESENT",
          desc:     '''Indicates whether one or more additional protocols is implemented in the Target hardware.

                    Some protocols require a sufficiently fast response that software involvement is not possible.
                    These may be implemented as an extension within the Target core.
                    '''
          hwaccess: "hwo",
          resval:   "0"
        }
        { bits:     "14:0",
          name:     "EXT_INFO",
          desc:     "Extension-specific information."
          swaccess: "rw",
          hwaccess: "hrw",
          hwqe:     "true",
          resval:   "0"
        }
      ]
    }
    { name:     "TARG_SINK_CONTROL",
      desc:     "Target data sink control.",
      swaccess: "rw",
      fields: [
        { bits:     "31",
          name:     "START",
          desc:     '''Initiate removal of DWORDs from a transmission buffer.

                    The 'data sink' logic is a mechanism for recovering from aborting or failed transmissions without impacting subsequent, already-queued transfers.
                    Software shall write '1' to this field to start the 'data sink' logic.
                    The ACTIVE field in the corresponding `TARG_SINK_STATUS` register shows whether the logic is still active.
                    '''
          hwqe:     "true",
          swaccess: "wo",
          hwaccess: "hro",
          resval:   "0"
        }
        { bits:     "26:16",
          name:     "LENGTH",
          desc:     '''Specifies the number of DWORDs to be removed, minus 1.

                    This field instructs the 'data sink' logic to remove a specified number of DWORDs of data from the specified source.
                    Software shall program 'n-1' into this field to remove 'n' DWORDs.
                    '''
          hwaccess: "hro",
          resval:   "0"
        }
        { bits:     "14:12",
          name:     "BUFFER",
          desc:     '''Specifies the transmission buffer from which DWORDs are to be removed.

                    0 - IBI Data buffer.
                    1 - Virtual Target 0 Tx buffer
                    2 - Virtual Target 1 Tx buffer...
                    ''',
          hwaccess: "hro",
          resval:   "0"
        }
      ]
    }
    { name:     "TARG_SINK_STATUS",
      desc:     "Target data sink status.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "26:16",
          name:   "LENGTH",
          desc:   '''Reports the numbers of DWORDs still to be removed when `ERROR` is asserted.

                  In the event of an error, this value may be used to ascertain how much of the operation was performed.
                  When this field reports 'm', there are still 'm+1' DWORDs to be removed.
                  In the event of successful completion ('ACTIVE' and 'ERROR' both reset) this field is not meaningful and the DWORDs were removed as expected.
                  ''',
          resval: "0"
        }
        { bits:   "1",
          name:   "ERROR",
          desc:   '''Indicates whether the data sink mechanism stopped prematurely.
                  If the specified buffer did not contain sufficient data for the logic to remove the specified number of DWORDs it will set this bit when becoming inactive.
                  ''',
          resval: "0"
        }
        { bits:   "0",
          name:   "ACTIVE",
          desc:   '''Indicates whether the data sink logic is active.
                  This bit becomes set when the operation is started and will be cleared at most a few tens of microseconds later when the operation is complete.
                  ''',
          resval: "0"
        }
      ]
    }
    // The reset detector requires an asynchronous clock signal for its register interface;
    // even though the reset detector logic itself operates on the SCL signal this cannot be used
    // for the register interface because doing so could stall the CPU indefinitely.
    // Therefore `clk_aon_i` for this purpose.
    { name:     "RESET_DET_CTRL",
      desc:     "Reset detector control.",
      swaccess: "wo",
      hwaccess: "hro",
      hwext:    "true",
      hwqe:     "true",
      async:    "clk_aon_i",
      fields: [
        { bits:   "21",
          name:   "RST_TARGET_EN",
          desc:   "Enable response to a Whole Target reset request.",
          resval: "0"
        }
        { bits:   "20",
          name:   "RST_PERIPH_EN",
          desc:   "Enable response to a Peripheral reset request.",
          resval: "0"
        }
        { bits:   "16",
          name:   "WAKE_ACK",
          desc:   "Wake acknowledgement.",
          resval: "0"
        }
        { bits:   "1",
          name:   "SLEEP_REQ",
          desc:   "Activate the reset detector prior to entry into 'Deepest Sleep' state.",
          resval: "0",
          tags: [// Prevent usb wake functions from being turned on outside of directed tests
                 "excl:CsrNonInitTests:CsrExclWrite"]
        }
      ]
    }
    { name:     "RESET_DET_STATUS",
      desc:     "Reset detector status.",
      swaccess: "ro",
      hwaccess: "hwo",
      async:    "clk_aon_i",
      fields: [
        { bits:   "3",
          name:   "RST_TARGET",
          desc:   "Indicates that a Whole Target reset requst was received.",
          resval: "0"
        }
        { bits:   "2",
          name:   "RST_PERIPH",
          desc:   "Indicates that a Peripheral request request was received.",
          resval: "0"
        }
        { bits:   "1",
          name:   "WAKE_UP",
          desc:   "Indicates that a Wake Up request was received.",
          resval: "0"
        },
        { bits:   "0",
          name:   "ACTIVE",
          desc:   "Indicates whether the reset detector is active.",
          resval: "0"
        }
      ]
    }
    { name:     "CTRL_TIME_SP"
      desc:     '''Controller Timing Parameters for Start and stoP.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCAS_DIV2",
          desc:   '''Half of the delay between SDA falling and SCL falling in START timing, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "TCBP_DIV2",
          desc:   '''Half of the delay between SCL rising and SDA rising in STOP timing, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_OD",
      desc:     '''Controller Timing Parameters for Open Drain signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "SCLHI_DIV2",
          desc:   '''Half of the SCL high interval during Open Drain signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "SCLLO_DIV2",
          desc:   '''Half of the SCL low interval during Open Drain signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_PP",
      desc:     '''Controller Timing Parameters for SDR0/HDR-DDR Push-Pull SCL High signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCHS",
          desc:   '''Half of the SCL high interval during Push-Pull signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "15",
          name:   "HCEXT",
          desc:   '''Enable half-cycle SCL extension.
                  If the field `PP_SCLHI_DIV2` has been set to something other than 0x3ff, this bit controls whether the half-cycle SCL extension is enabled.
                  If `PP_SCLHI_DIV2` has all bits set then the hardware will determine this setting automatically.
                  Extending SCL by half a cycle of the IP clock enables support for other clock frequencies such as 96MHz.
                  '''
          resval: "1"
        }
        { bits:   "9:0",
          name:   "TCHH",
          desc:   '''Half of the SCL low interval during Push-Pull signaling at SDR0 rate, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_SDR0",
      desc:     '''Controller Timing Parameters for SDR0/HDR-DDR Push-Pull SCL Low signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCLS",
          desc:   '''Duration of setup phase before rising SCL when using Push-Pull signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "TCLH",
          desc:   '''Duration of hold phase after falling SCL when using Push-Pull signaling at SDR0 rate, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_SDR1",
      desc:     '''Controller Timing Parameters for SDR1 Push-Pull SCL Low signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCLS",
          desc:   '''Duration of setup phase before rising SCL when using Push-Pull signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "TCLH",
          desc:   '''Duration of hold phase after falling SCL when using Push-Pull signaling at SDR0 rate, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_SDR2",
      desc:     '''Controller Timing Parameters for SDR2 Push-Pull SCL Low signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCLS",
          desc:   '''Duration of setup phase before rising SCL when using Push-Pull signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "TCLH",
          desc:   '''Duration of hold phase after falling SCL when using Push-Pull signaling at SDR0 rate, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_SDR3",
      desc:     '''Controller Timing Parameters for SDR3 Push-Pull SCL Low signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCLS",
          desc:   '''Duration of setup phase before rising SCL when using Push-Pull signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "TCLH",
          desc:   '''Duration of hold phase after falling SCL when using Push-Pull signaling at SDR0 rate, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_SDR4",
      desc:     '''Controller Timing Parameters for SDR4 Push-Pull SCL Low signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "TCLS",
          desc:   '''Duration of setup phase before rising SCL when using Push-Pull signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "TCLH",
          desc:   '''Duration of hold phase after falling SCL when using Push-Pull signaling at SDR0 rate, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_FMP",
      desc:     '''Controller Timing Parameters for I2C Fast Mode Plus signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "SCLHI_DIV2",
          desc:   '''Half of the SCL high interval during I2C Fast Mode Plus signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "SCLLO_DIV2",
          desc:   '''Half of the SCL low interval during I2C Fast Mode Plus signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "CTRL_TIME_FM",
      desc:     '''Controller Timing Parameters for I2C Fast Mode signaling.

                This register shall be modified only when the Controller is not connected to the I3C bus.
                ''',
      swaccess: "rw",
      hwaccess: "hro"
      fields: [
        { bits:   "25:16",
          name:   "SCLHI_DIV2",
          desc:   '''Half of the SCL high interval during I2C Fast Mode signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
        { bits:   "9:0",
          name:   "SCLLO_DIV2",
          desc:   '''Half of the SCL low interval during I2C Fast Mode signaling, minus 1.
                  This interval is in terms of the IP clock period.
                  If this field has all bits set then the hardware will calculate a suitable value.
                  '''
          resval: "0x3ff"
        }
      ]
    }
    { name:     "INTERVAL_TIME0",
      desc:     '''Interval Timers 0 register.
                Time intervals are specified as two's complement 8-bit signed offsets added to the default values calculated by the hardware:

                 - interval_clks = (hw_default_us * clks_per_us) + (signed_adj << shift)

                The granularity of the adjustment is timer-dependent because the intervals span a large range, from 1us to 50ms.
                It is also scaled according to the clock frequency of the IP block, because the supported frequency range is 50MHz to 1.5GHz:

                Clock frequencies:
                 - 50MHz to 64MHz, both inclusive: base weighting applies.
                 - From 64MHz (exclusive) to 128MHz (inclusive): adjustments have twice the base weighting.
                 - From 128MHz (excl.) to 256MHz (incl.): adjustments have 4 times the base weighting.
                 - From 256MHz (excl.) to 512MHz (incl.): adjustments have 8 times the base weighting.
                 - From 512MHz (excl.) to 1024MHz (incl.): adjustments have 16 times the base weighting.
                 - From 1024MHz (excl.) to 1500MHz (incl.): adjustments have 32 times the base weighting.

                This allows the default intervals (in microseconds) to be adjusted in terms of IP clock cycles to an accuracy of +/- 0.8% typically.
                '''
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "31:24",
          name:   "DEAD_BUS",
          desc:   '''Adjustment to the interval of the Dead Bus timer.

                  Default interval: 50 milliseconds.
                  Base weighting: 0x4000 IP clock cycles.
                  '''
          resval: "0"
        }
        { bits:   "23:16",
          name:   "CTRL_BUS_AVAIL",
          desc:   '''Adjustment to the interval of the Controller Bus Available timer.

                  Default interval: 1 microsecond.
                  Base weighting: 1 IP clock cycle.
                  '''
          resval: "0"
        }
        { bits:   "15:8",
          name:   "READ_STALLED",
          desc:   '''Adjustment to the interval of the SDA read stall (no Controller SCL activity during Read Transfer) timer.

                  Default interval: 150 microseconds.
                  Base weighting: 0x40 IP clock cycles.
                  '''
          resval: "0"
        }
        { bits:   "7:0",
          name:   "TARG_BUS_AVAIL",
          desc:   '''Adjustment to the interval of the Target Bus Available timer.

                  Default interval: 1 microsecond.
                  Base weighting: 1 IP clock cycle.
                  '''
          resval: "0"
        }
      ]
    }
    { name:     "INTERVAL_TIME1",
      desc:     '''Interval Timers 1 register.
                Time intervals are specified as two's complement 8-bit signed adjustments to the default values calculated by the hardware.

                The granularity of the adjustment is timer-dependent and clock frequency-dependent.
                The weightings given here apply to the base case of an IP clock frequency up to 64MHz, inclusive.
                See `INTERVAL_TIME0` for details.
                '''
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "31:24",
          name:   "TARG_TRX_RST",
          desc:   '''Adjustment to the Target Reset timer.

                  Default interval: 5 microseconds.
                  Base weighting: 1 IP clock cycle.
                  '''
          resval: "0"
        }
        { bits:   "23:16",
          name:   "TE0_RECOV",
          desc:   '''Adjustment to the interval after which the Target shall attempt recovery from a Target Error 0 (TE0) condition.

                  Default interval: 60 microseconds.
                  Base weighting: 0x10 IP clock cycles.
                  '''
          resval: "0"
        }
        { bits:   "15:8",
          name:   "TARG_BUS_IDLE",
          desc:   '''Adjustment to the interval of the Target Bus Idle timer.

                  Default interval: 200 microseconds.
                  Base weighting: 0x40 IP clock cycles.
                  '''
          resval: "0"
        }
        { bits:   "7:0",
          name:   "COMMAND_RETRY",
          desc:   '''Adjustment to the interval after which NACKed commands are retried.

                  Default interval: 800 microseconds.
                  Base weighting: 0x100 IP clock cycles.
                  '''
          resval: "0"
        }
      ]
    }
    { name:     "PHY_CONFIG",
      desc:     "PHY configuration",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "31",
          name:   "CTRL_DIRECT_DRIVE_EN",
          desc:   "Enable direct driving of the Serial Clock (SCL) and Serial Data (SDA) lines by software.",
          resval: "0"
        }
        // SCL-related Controller outputs in direct-driving mode.
        { bits:   "27",
          name:   "CTRL_SCL_PP_EN",
          desc:   "Enable push-pull driving of SCL in direct-driving mode.",
          resval: "0"
        }
        { bits:   "25",
          name:   "CTRL_SCL_PU_EN",
          desc:   "Enable pull-up on SCL in direct-driving mode.",
          resval: "0",
        }
        { bits:   "24",
          name:   "CTRL_SCL",
          desc:   "State of the SCL line when direct-driving is enabled.",
          resval: "1"
        }
        // SDA-related Controller outputs in direct-driving mode.
        { bits:   "23",
          name:   "CTRL_SDA_PP_EN",
          desc:   "Enable push-pull driving of SDA in direct-driving mode, when open drain driving is not also enabled.",
          resval: "0"
        }
        { bits:   "22",
          name:   "CTRL_SDA_OD_EN",
          desc:   "Enable open drain driving of SDA in direct-driving mode.",
          resval: "0"
        }
        { bits:   "21",
          name:   "CTRL_SDA_PU_EN",
          desc:   "Enable pull-up on SDA in direct-driving mode.",
          resval: "0",
        }
        { bits:   "20",
          name:   "CTRL_SDA",
          desc:   "State of the SDA line when direct-driving is enabled.",
          resval: "1"
        }
        { bits:   "1",
          name:   "SDA_HK_EN",
          desc:   "High-keeper enable for the SDA lane.",
          resval: "1"
        }
        { bits:   "0",
          name:   "SCL_HK_EN",
          desc:   "High-keeper enable for the SCL line.",
          resval: "1"
        }
      ]
    }
    { name:     "BLOCKED_ADDR",
      desc:     '''Blocked target addresses.
                The controller will raise an error if any attempt is made to access a blocked target address.
                This feature is intended to safeguard against inadvertent accesses to any I2C device that may try to employ clock-stretching, but it may also be of use diagnostically.
                ''',
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "30:24",
          name:   "MASK1",
          desc:   '''Address mask for the second set of blocked addresses.

                  This mask determines which bits of the device address will be tested and matched against the address in 'ADDR1'.
                  I2C devices are commonly configured with one of a small set of static addresses, differing in only one two address bits.
                  If this field is zero then 'ADDR1' is implicitly not used.
                  '''
          resval: "0"
        }
        { bits:   "22:16",
          name:   "ADDR1",
          desc:   "Second blocked address.",
          resval: "0"
        }
        { bits:   "14:8",
          name:   "MASK0",
          desc:   '''Address mask for the first set of blocked addresses.

                  This mask determines which bits of the device address will be tested and matched against the address in 'ADDR0'.
                  I2C devices are commonly configured with one of a small set of static addresses, differing in only one two address bits.
                  If this field is zero then 'ADDR0' is implicitly not used.
                  '''
          resval: "0"
        }
        { bits:   "6:0",
          name:   "ADDR0",
          desc:   "First blocked address.",
          resval: "0"
        }
      ]
    }
    { name:     "BUFFER_CTRL",
      desc:     "Buffer control",
      hwext:    "true",
      hwqe:     "true",
      fields: [
        { bits:     "31",
          name:     "CLEAR",
          desc:     '''Software clear of buffer state including the following:
                    All `WPTR` and `RPTR` values are set to the corresponding `MIN` values, emptying all circular buffers.
                    This shall only be used when both the Controller- and the Target-side functionality are disabled.
                    '''
          swaccess: "wo",
          hwaccess: "hro",
          resval:   "0"
        }
        { bits:     "29:28",
          name:     "SW_ADDR_HI",
          desc:     '''Supplies the high address bits when software performs direct accesses to the internal message buffer.
                    The IP may be configured to map part of its internal message buffer into the upper half of the IP address space.
                    This provides more RAM to a memory-limited system when the I3C is not being used, and may be diagnostically useful when it is used.
                    Since half of the IP address space is typically 2KiB but the message buffer is larger, this field allows software-controlled paging.
                    '''
          swaccess: "rw",
          hwaccess: "hrw",
          resval:   "0"
        }
      ]
    }
    { name:     "BUFFER_STATUS",
      desc:     "Buffer status",
      fields: [
        { bits:   "31",
          name:   "HCIQ_ERR",
          desc:   '''Diagnostic error indicator for the Host Controller Interface (HCI) queues.
                  The hardware sets this bit in the event of a write to a full or read-only queue, or a read from an empty or write-only queue.
                  Software shall clear this bit by writing '1'.
                  '''
          swaccess: "rw1c",
          hwaccess: "hwo",
          resval:   "0"
        }
        { bits:   "30",
          name:   "TTIQ_ERR",
          desc:   '''Diagnostic error indicator for the Target Transaction Interface (TTI) queues.
                  The hardware sets this bit in the event of a write to a full or read-only queue, or a read from an empty or write-only queue.
                  Software shall clear this bit by writing '1'.
                  '''
          swaccess: "rw1c",
          hwaccess: "hwo",
          resval:   "0"
        }
      ]
    }
    // Controller Transmission Buffer.
    { name:     "CTRL_TXBUF_CONFIG",
      desc:     "Controller TX Buffer Configuration",
      swaccess: "rw",
      hwaccess: "hro",
      // Note: this register should be consistent with DATA_BUFFER_STATUS_LEVEL
      fields: [
        { bits:   "30:28",
          name:   "SIZE_VAL",
          desc:   '''Size value presented as `QUEUE_SIZE.TX_DATA_BUFFER_SIZE`.
                  This value is log2(size in DWORDs) - 1.
                  '''
          resval: "6"
        }
        { bits:   "25:16",
          name:   "MAX_ADDR",
          desc:   "Maximum address for Controller TX use (inclusive).",
          resval: "0x7f"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for Controller TX use.",
          resval: "0"
        }
      ]
    }
    { name:     "CTRL_TXBUF_STATE",
      desc:     "Controller TX Buffer State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the buffer is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
          desc:   "Current read pointer.",
          resval: "0"
        }
        { bits:   "9:0",
          name:   "WPTR",
          desc:   "Current write pointer.",
          resval: "0"
        }
      ]
    }
    // Controller Reception Buffer.
    { name:     "CTRL_RXBUF_CONFIG",
      desc:     "Controller RX Buffer Configuration",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:    "30:28",
          name:    "SIZE_VAL",
          desc:    '''Size value presented as `QUEUE_SIZE.RX_DATA_BUFFER_SIZE`.
                   This value is log2(size in DWORDs) - 1.
                   '''
          resval:  "6"
        }
        { bits:   "25:16",
          name:   "MAX_ADDR",
          desc:   "Maximum address for Controller RX use (inclusive).",
          resval: "0xff"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for Controller RX use.",
          resval: "0x80"
        }
      ]
    }
    { name:     "CTRL_RXBUF_STATE",
      desc:     "Controller RX Buffer State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the buffer is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
          desc:   "Current read pointer.",
          resval: "0x80"
        }
        { bits:   "9:0",
          name:   "WPTR",
          desc:   "Current write pointer.",
          resval: "0x80"
        }
      ]
    }
    // Controller Command Queue.
    { name:     "COMMAND_QUEUE_CONFIG",
      desc:     "Command Queue Configuration.",
      swaccess: "rw",
      hwaccess: "hro",
      // Note: this register should be consistent with QUEUE_STATUS_LEVEL
      fields: [
        { bits:    "31:24",
          name:    "SIZE_VAL",
          desc:    '''Size value presented as `QUEUE_SIZE.CR_QUEUE_SIZE`.
                   '''
          resval:  "16"
        }
        { bits:   "21:12",
          name:   "MAX_ADDR",
          desc:   "Maximum address for Command Queue use (inclusive).",
          resval: "0x11f"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for Command Queue use.",
          resval: "0x100"
        }
      ]
    }
    { name:     "COMMAND_QUEUE_STATE",
      desc:     "Command Queue State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the queue is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
          desc:   "Current read pointer.",
          resval: "0x100"
        }
        { bits:   "9:0",
          name:   "WPTR",
          desc:   "Current write pointer.",
          resval: "0x100"
        }
      ]
    }
    // Controller Response Queue.
    { name:     "RESPONSE_QUEUE_CONFIG",
      desc:     "Response Queue Configuration.",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:    "31:24",
          name:    "SIZE_VAL",
          desc:    '''Size value presented as `ALT_QUEUE_SIZE.ALT_RSP_QUEUE_SIZE`.
                   '''
          resval:  "16"
        }
        { bits:   "21:12",
          name:   "MAX_ADDR",
          desc:   "Maximum address for Response Queue use (inclusive).",
          resval: "0x12f"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for Response Queue use.",
          resval: "0x120"
        }
      ]
    }
    { name:     "RESPONSE_QUEUE_STATE",
      desc:     "Response Queue State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the queue is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
          desc:   "Current read pointer.",
          resval: "0x120"
        }
        { bits:   "9:0",
          name:   "WPTR",
          desc:   "Current write pointer.",
          resval: "0x120"
        }
      ]
    }
    // Controller IBI Data Buffer.
    { name:     "IBI_CONFIG",
      desc:     "In-Band Interrupt Queue Configuration.",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:    "31:24",
          name:    "SIZE_VAL",
          desc:    '''Size value presented as `QUEUE_SIZE.IBI_STATUS_SIZE`.

                   This value represents the sum of the IBI Queue and the IBI Status Descriptor FIFO.
                   Since EXT_IBI_QUEUE_EN is set, the actual number of DWORDs is 8 times this value.
                   '''
          resval:  "20"
        }
        { bits:   "21:12",
          name:   "MAX_ADDR",
          desc:   "Maximum address for IBI Queue use (inclusive).",
          resval: "0x1af"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for IBI Queue use.",
          resval: "0x130"
        }
      ]
    }
    { name:     "IBI_STATE",
      desc:     "In-Band Interrupt Queue State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the queue is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
          desc:   "Current read pointer.",
          resval: "0x130"
        }
        { bits:   "9:0",
          name:   "WPTR",
          desc:   "Current write pointer.",
          resval: "0x130"
        }
      ]
    }
    // Controller IBI Status Descriptor Queue.
    { name:     "IBI_STAT_CONFIG",
      desc:     "In-Band Status Descriptor FIFO Configuration.",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "21:12",
          name:   "MAX_ADDR",
          desc:   "Maximum address for IBI Status Descriptor FIFO use (inclusive).",
          resval: "0x1cf"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for IBI Status Descriptor FIFO use.",
          resval: "0x1b0"
        }
      ]
    }
    { name:     "IBI_STAT_STATE",
      desc:     "In-Band Status Descriptor FIFO State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the FIFO is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
          desc:   "Current read pointer.",
          resval: "0x1b0"
        }
        { bits:   "9:0",
          name:   "WPTR",
          desc:   "Current write pointer.",
          resval: "0x1b0"
        }
      ]
    }
    // Target Transmission Data Buffers.
    { multireg: {
        name:     "TARG_TXBUF_CONFIG",
        desc:     "Target TX Buffer Configuration.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        hwaccess: "hro",
        // This default configuration using `multireg_idx` apportions the space among all of the
        // supported targets, rather than the number that are configured and supported by the IP.
        fields: [
          { bits:   "25:16",
            name:   "MAX_ADDR",
            desc:   '''Maximum address for Target TX use (inclusive).
                    The default addressing apportions the available storage space among the maximum number of Virtual Targets.
                    For configurations employing fewer Virtual Targets, software should modify the configuration.
                    ''',
            resval: "0x20f + (multireg_idx * 0x40)"
          }
          { bits:   "9:0",
            name:   "MIN_ADDR",
            desc:   '''Minimum address for Target TX use.
                    The default addressing apportions the available storage space among the maximum number of Virtual Targets.
                    For configurations employing fewer Virtual Targets, software should modify the configuration.
                    '''
            resval: "0x1d0 + (multireg_idx * 0x40)"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_TXBUF_STATE",
        desc:     "Target 0 TX Buffer State.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "ro",
        hwaccess: "hwo",
        hwext:    "true",
        // This default configuration using `multireg_idx` apportions the space among all of the
        // supported targets, rather than the number that are configured and supported by the IP.
        fields: [
          { bits:   "31",
            name:   "FULL",
            desc:   "Indicates if the buffer is full.",
            resval: "0"
          }
          { bits:   "30",
            name:   "PRE",
            desc:   "Indicates if prefetched data is available.",
            resval: "0"
          }
          { bits:   "25:16",
            name:   "RPTR",
            desc:   "Current read pointer.",
            resval: "0x1d0 + (multireg_idx * 0x40)"
          }
          { bits:   "9:0",
            name:   "WPTR",
            desc:   "Current write pointer.",
            resval: "0x1d0 + (multireg_idx * 0x40)"
          }
        ]
      }
    }
    // Target Reception Buffer.
    { name:     "TARG_RXBUF_CONFIG",
      desc:     "Target RX Buffer Configuration",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "25:16",
          name:   "MAX_ADDR",
          desc:   "Maximum address for Target RX use (inclusive).",
          resval: "0x36f"
        }
        { bits:   "9:0",
          name:   "MIN_ADDR",
          desc:   "Minimum address for Target RX use.",
          resval: "0x2d0"
        }
      ]
    }
    { name:     "TARG_RXBUF_STATE",
      desc:     "Target RX Buffer State.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "31",
          name:   "FULL",
          desc:   "Indicates if the buffer is full.",
          resval: "0"
        }
        { bits:   "30",
          name:   "PRE",
          desc:   "Indicates if prefetched data is available.",
          resval: "0"
        }
        { bits:   "25:16",
          name:   "RPTR",
