          desc:     '''Target 0 Tx Descriptor Queue Ready Status.
                    Asserted when the Tx Descriptor Queue has at least the requested amount of space, see `TARG_TX_THLD_CTRL.TX_DESC_EMPTY_THLD`.
                    '''
          resval:   "0"
        }
        { bits:     "11",
          name:     "TX3_THLD_STAT",
          desc:     '''Target 3 Tx Data Buffer Threshold Status.
                    Asserted when the requested amount of space is available in the Tx Data Buffer, see `TARG_TX_THLD_CTRL.TX_BUF_FREE_THLD`.
                    '''
