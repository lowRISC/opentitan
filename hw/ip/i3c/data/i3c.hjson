          desc:   "Force Target 2 Tx Data Buffer Threshold.",
          resval: "0"
        }
        { bits:   "9",
          name:   "TX1_THLD_FORCE",
          desc:   "Force Target 1 Tx Data Buffer Threshold.",
          resval: "0"
        }
        { bits:   "8",
          name:   "TX0_THLD_FORCE",
          desc:   "Force Target 0 Tx Data Buffer Threshold.",
          resval: "0"
        }
        { bits:   "6",
          name:   "ASYNC_EVT_OVF_FORCE",
          desc:   "Force Asynchronous Event Queue Overflow.",
          resval: "0"
        }
        { bits:   "5",
          name:   "RX_BUFFER_OVF_FORCE",
          desc:   "Force Rx Data Buffer Overflow.",
          resval: "0"
        }
        { bits:   "4",
          name:   "TRANSFER_ERR_FORCE",
          desc:   "Force Transfer Error.",
          resval: "0"
        }
        { bits:   "3",
          name:   "TRANSFER_ABORT_FORCE",
          desc:   "Force Transfer Abort.",
          resval: "0"
        }
        { bits:   "2",
          name:   "ASYNC_EVT_READY_FORCE",
          desc:   "Force Asynchronous Event Queue Ready.",
          resval: "0"
        }
        { bits:   "1",
          name:   "IBI_THLD_FORCE",
          desc:   "Force IBI Status Threshold.",
          resval: "0"
        }
        { bits:   "0",
          name:   "RX_DESC_READY_FORCE",
          desc:   "Force Rx Descriptor Queue Ready.",
          resval: "0"
        }
      ]
    }
    { name:     "TARG_PIO_CONTROL",
      desc:     "Target PIO mode Control register.",
      hwaccess: "hrw",
      hwqe:     "true",
      fields: [
        { bits:     "27:24",
          name:     "ABORT",
          desc:     '''Allows software to abort transmission for each Virtual Target in turn.
                    Writing 1 to the corresponding bit will abort any in-progress transmission from that Virtual Target.
                    Transmission will enter the Suspended state and will not resume until the Suspended state is cleared.
                    ''',
          swaccess: "rw",
          resval:   "0"
        }
        { bits:     "19:16",
          name:     "SUSPENDED",
          desc:     '''Indicates, for each Virtual Target in turn, whether transmission has been suspended.
                    If an error occurs during transmission, the corresponding bit will be set automatically by hardware.
                    Software use of the Abort mechanism described above also causes this bit to become set.
                    It remains asserted until the software writes a 1 to clear this bit.
                    ''',
          swaccess: "rw1c",
          resval:   "0"
        }
        { bits:     "1",
          name:     "IBI_ABORT",
          desc:     '''Allows software to abort transmission of In-Band Interrupts.
                    Writing 1 to this bit will abort any in-progress IBI transmission.
                    IBI transmission will enter the Suspended stateand will not resume until the Suspended state is cleared.
                    ''',
          swaccess: "rw",
          resval:   "0"
        }
        { bits:     "0",
          name:     "IBI_SUSPENDED",
          desc:     '''Indicates whether transmission of In-Band Interrupts has been suspended.
                    If an error occurs during transmission, this bit will be set automatically by hardware.
                    Software use of the IBI Abort mechanism described above also causes this bit to become set.
                    It remains asserted until the software writes a 1 to clear this bit.
                    ''',
          swaccess: "rw1c",
          resval:   "0"
        }
      ]
    }
    { name:     "TARG_ASYNC_EVT_CONTROL",
      desc:     "Target Asynchronous Event Queue Control.",
      hwaccess: "hro",
      hwqe:     "true",
      fields: [
        { bits:     "31",
          name:     "RESET",
          desc:     "Write 1 to reset the Asynchronous Event Queue.",
          swaccess: "rw1c",
          resval:   "0",
        }
        { bits:     "7",
          name:     "BUS_EVENTS",
          desc:     "Report I3C Bus Events.",
          swaccess: "rw",
          resval:   "0",
        }
        { bits:     "6",
          name:     "IBI_SUSPEND",
          desc:     "Report Suspension of In-Band Interrupt transmission.",
          swaccess: "rw",
          resval:   "0",
        }
        { bits:     "5",
          name:     "TX_SUSPEND",
          desc:     "Report Suspension of Target transmissions.",
          swaccess: "rw",
          resval:   "0"
        }
        { bits:     "4",
          name:     "IBI_NOTIFY",
          desc:     "Notify results of In-Band Interrupt transmissions.",
          swaccess: "rw",
          resval:   "0",
        }
        { bits:     "3",
          name:     "TX_NOTIFY",
          desc:     "Notify results of Target transmissions.",
          swaccess: "rw",
          resval:   "0"
        }
        { bits:     "2",
          name:     "DIR_GET_CCC",
          desc:     "Capture `Direct GET` CCC traffic.",
          swaccess: "rw",
          resval:   "0"
        }
        { bits:     "1",
          name:     "DIR_SET_CCC",
          desc:     "Capture `Direct SET` CCC traffic.",
          swaccess: "rw",
          resval:   "0"
        }
        { bits:     "0",
          name:     "BCST_CCC",
          desc:     "Capture `Broadcast CCC` traffic.",
          swaccess: "rw",
          resval:   "0"
        }
      ]
    }
    { name:     "TARG_ERROR",
      desc:     "Target Error counts.",
      swaccess: "rw1c",
      hwaccess: "hrw",
      fields: [
        { bits:   "31:28",
          name:   "DBR",
          desc:   '''Count of Dead Bus Recovery attempts.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "27:24",
          name:   "TE6",
          desc:   '''Count of type 6 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "23:20",
          name:   "TE5",
          desc:   '''Count of type 5 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "19:16",
          name:   "TE4",
          desc:   '''Count of type 4 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "15:12",
          name:   "TE3",
          desc:   '''Count of type 3 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "11:8",
          name:   "TE2",
          desc:   '''Count of type 2 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "7:4",
          name:   "TE1",
          desc:   '''Count of type 1 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
        { bits:   "3:0",
          name:   "TE0",
          desc:   '''Count of type 0 Target Errors.
                  Write 4'hf to clear the error count.
                  ''',
          resval: "0"
        }
      ]
    }
    { name:     "TARG_QUEUE_THLD_CTRL",
      desc:     "Target-side control register for setting queue interrupt thresholds.",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "31:24",
          name:   "IBI_STATUS_THLD",
          desc:   '''IBI Status Threshold.
                  Interrupt is issued when the IBI Status Descriptor Queue has space available for at least N entries.
                  0: Do not raise any interrupts.
                  ''',
          resval: "1"
        }
        { bits:   "15:8",
          name:   "RX_DESC_THLD",
          desc:   '''Rx Descriptor Queue Threshold.
                  Interrupt is issued when the Rx Descriptor Queue contains at least N descriptors.
                  0: Do not raise any interrupts.
                  ''',
          resval: "1"
        }
      ]
    }
    { name:     "TARG_QUEUE_STATUS_LEVEL",
      desc:     "Target-side queue levels.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "27:16",
          name:   "ASYNC_EVT_LVL",
          desc:   "The number of Asynchronous Event descriptors in the queue.",
          resval: "0"
        }
        { bits:   "7:0",
          name:   "RX_DESC_LVL",
          desc:   "The number of descriptors present in the Rx Descriptor queue.",
          resval: "0"
        }
      ]
    }
    { name:     "TARG_BUF_THLD_CTRL",
      desc:     "Target-side control register for setting buffer interrupt thresholds.",
      swaccess: "rw",
      hwaccess: "hro",
      fields: [
        { bits:   "30:28",
          name:   "RX_START_THLD",
          desc:   '''Receive Start Threshold in DWORDs.
                  Wait until there are at least 2^(N+1) DWORD available before accepting a Private Write transfer.
                  If the Active Controller attempts to perform a write transfer when this condition is not met, it will be NACKed.
                  '''
          resval: "1"
        }
        { bits:   "11:0",
          name:   "RX_SEGMENT_SIZE",
          desc:   '''Maximum length of received data segment, minus 1.
                  Received data is divided into DWORDs of no more than this length.
                  '''
          resval: "1"
        }
      ]
    }
    { name:     "TARG_BUF_STATUS_LEVEL",
      desc:     "Target-side data buffer levels.",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "27:16",
          name:   "IBI_FREE_LVL",
          desc:   "The available space (in DWORDs) in the Target IBI queue."
        }
        { bits:   "11:0",
          name:   "RX_BUF_LVL",
          desc:   "The number of DWORDs of data present in the Rx Buffer."
        }
      ]
    }
    { multireg: {
        name:     "TARG_RW_LEN",
        desc:     "Target Read/Write Length.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        hwaccess: "hrw",
        fields: [
          { bits:   "31:16",
            name:   "MWL",
