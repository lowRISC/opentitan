    { multireg: {
        name:     "TARG_ENABLE",
        count:    "MaxTargets",
        cname:    "TARGET",
        compact:  "true",
        desc:     "Enable signals for individual virtual targets.",
        swaccess: "rw",
        hwaccess: "hro",
        fields: [
          { bits:   "0",
            name:   "ENABLE",
            desc:   '''Enable virtual target.
                    A disabled target will not participate in address assignment or respond to bus traffic.
                    '''
            resval: "0"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_GROUP",
        count:    "MaxGroups"
        cname:    "GROUP"
        desc:     "Group addressing configuration.",
        swaccess: "ro",
        hwaccess: "hrw",
        fields: [
          { bits:   "11:8",
            name:   "TARGETS",
            desc:   '''The set of virtual targets subscribed to this group address.
                    If zero, this entry in the list of group addresses is unused.
                    ''',
            resval: "0"
          }
          { bits:   "6:0",
            name:   "GROUP_ADDR",
            desc:   '''Group address, iff the entry is used.
                    If zero, and TARGETS is non-zero, all I3C traffic will be captured as if addressed to the selected Target(s).
                    '''
            resval: "0"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_TX_THLD_CTRL",
        desc:     "Target control register for setting Tx thresholds.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        hwaccess: "hro",
        fields: [
          { bits:   "31:28",
            name:   "TX_START_THLD",
            desc:   '''Transmit (Transfer) Start Threshold in DWORDs.
                    Wait until there are at least 2^(N+1) DWORDs of data available before responding to a Read Transfer request.
                    '''
            resval: "1"
          }
          { bits:   "23:16",
            name:   "TX_DESC_EMPTY_THLD",
            desc:   '''Tx Descriptor Queue Threshold.
                    Interrupt is issued when the Tx Descriptor Queue contains at least N empty entries.
                    0: Do not raise an interrupt.
                    ''',
            resval: "1"
          }
          { bits:   "11:0",
            name:   "TX_BUF_FREE_THLD",
            desc:   '''Transmit Buffer Threshold.
                    Interrupt triggers when there are at least N DWORDs of free space in the Tx Data Buffer.
                    0: Do not raise an interrupt.
                    ''',
            resval: "1"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_TX_QUEUE_STATUS_LEVEL",
        desc:     "Target status register reporting transmit queue levels.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "ro",
        hwaccess: "hwo",
        hwext:    "true",
        fields: [
          { bits:   "23:16",
            name:   "TX_DESC_FREE_LVL",
            desc:   "The number of free Tx Descriptor Queue entries.",
            resval: "0"
          }
          { bits:   "11:0",
            name:   "TX_BUF_FREE_LVL",
            desc:   "The number of free DWORDs in the Tx Buffer.",
            resval: "0"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_ADDR",
        desc:     "Target address on the I3C bus.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        fields: [
          { bits:     "31",
            name:     "DYNAMIC_ADDR_VALID",
            desc:     "Dynamic Address is Valid.",
            hwaccess: "hrw",
            resval:   "0"
          }
          { bits:     "22:16",
            name:     "DYNAMIC_ADDR",
            desc:     "Device Dynamic Address.",
            hwaccess: "hrw",
            resval:   "0"
          }
          { bits:     "15",
            name:     "STATIC_ADDR_VALID",
            desc:     "Static Addres is Valid.",
            hwaccess: "hro",
            resval:   "0"
          }
          { bits:     "6:0",
            name:     "STATIC_ADDR",
            desc:     "Device Static Address.",
            hwaccess: "hro",
            resval:   "0"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_CHAR",
        desc:     "Target Characteristics.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        hwaccess: "hro",
        fields: [
          { bits:   "31:24",
            name:   "BCR",
            desc:   "Bus Characteristics Register.",
            resval: "0x3e"
          }
          { bits:   "23:16",
            name:   "DCR",
            desc:   "Device Characteristics Register.",
            resval: "0"
          }
          { bits:   "15:0",
            name:   "PID_HI",
            desc:   "High part of Provisioned ID.",
            resval: "0"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_PID_LO",
        desc:     "Low part of Target Provisioned ID.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        hwaccess: "hro",
        fields: [
          { bits:   "31:0",
            name:   "PID_LO",
            desc:   "Low part of Provisioned ID.",
            resval: "0"
          }
        ]
      }
    }
    { multireg: {
        name:     "TARG_CAPS",
        desc:     "Target Capabilities.",
        count:    "MaxTargets",
        cname:    "TARGET",
        swaccess: "rw",
        hwaccess: "hro",
        fields: [
          { bits:     "12:11",
            name:     "VTCAP2_BUS_CTX",
            desc:     "Bus Context and Conditions.",
            resval:   "0"
          }
          { bits:     "10",
            name:     "VTCAP2_ADDR_REMAP",
            desc:     "Address Remapping.",
            resval:   "0"
          }
          { bits:     "9:8",
            name:     "VTCAP2_IRQ",
            desc:     "Interrupt Requests.",
