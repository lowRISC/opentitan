    { multireg: {
        name:     "TARG_MAX_RDWR",
        desc:     "Target Maximum Read/Write Rate and Turnaround.",
        count:    "MaxTargets",
        cname:    "MAX_RDWR",
        swaccess: "rw",
        hwaccess: "hro",
        fields: [
          { bits:   "31:28",
            name:   "RDTURN_SCALE",
            desc:   '''Maximum Read Turnaround Time Scale.

                    This value scales the Turnaround Time Value, giving the Maximum Read Turnaround Time in microseconds.
                    max time = RDTURN_VAL << (RDTURN_SCALE + 1)
                    ''',
            resval: "0"
          }
          { bits:   "27:16",
            name:   "RDTURN_VAL",
            desc:   "Maximum Read Turnaround Time Value.",
            resval: "1"
          }
          { bits:   "15:8",
            name:   "MAXWR",
            desc:   "Maximum Write Settings.",
            resval: "0"
          }
          { bits:   "6:0",
            name:   "MAXRD",
            desc:   "Maximum Read Settings",
            resval: "0"
          }
        ]
      }
    }
    // Leave some space for additional registers before the TTI ports window starts.
    { skipto: "0x440" },
    // Must be aligned to a multiple of 0x40 to implement 16 ports; natural alignment is important
    // because the address decoding in `tlul_sram_adapter` just extracts address bits.
    { window: {
        name:       "TTI_PORTS",
        desc:       '''TTI ports, occupying successive word addresses:

                    - Rx Descriptor Queue.
                    - Rx Data Buffer.
                    - IBI Status Descriptor.
                    - IBI Data Buffer.
                    - Asynchronous Event Queue.
                    - Target 0-3 Tx Descriptor Queue.
                    - Target 0-3 Tx Data Buffer.
                    ''',
        items:      "13",
        validbits:  "32",
        byte-write: "false",
        unusual:    "true",  // Not 2^N words.
        swaccess:   "rw"
      }
    }
    // ----- Target Extension 0xC0 (Extended Capability). -----
    // TODO: This is a placeholder; Open Compute Project Firmware Recovery Protocol is
    // anticipated to implement its register interface here.
    { name:     "TARGEXT_EXTCAP_HEADER",
      desc:     "Target Extension Extended Capability Header",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "23:8",
          name:   "CAP_LENGTH",
          desc:   "Capability Structure Length in DWORDs.",
          resval: "0x1"
        }
        { bits:   "7:0",
          name:   "CAP_ID",
          desc:   "Extended Capability ID",
          resval: "0xC0"
        }
      ]
    }
    // Terminator for the linked list of Extended Capabilities.
    // An Extended Capabilities header with ID = 0x00 marks the end of the linked list.
    { name:     "TERM_EXTCAP_HEADER",
      desc:     "Terminating Extended Capability Header",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "23:8",
          name:   "CAP_LENGTH",
          desc:   "Capability Structure Length in DWORDs.",
          resval: "0x01"
        }
        { bits:   "7:0",
          name:   "CAP_ID",
          desc:   "Extended Capability ID",
          resval: "0x00"
        }
      ]
    }
    { skipto: "0xa00" },
    { window: {
        name:       "DAT",
        desc:       "Device Address Table.",
        items:      "NumDATWords",
        validbits:  "32",
        unusual:    "false",
        byte-write: "false",
        swaccess:   "rw"
      }
    }
    { skipto: "0xc00" },
    { window: {
        name:       "DCT",
        desc:       "Device Characteristics Table.",
        items:      "NumDCTWords",
        validbits:  "32",
        byte-write: "false",
        unusual:    "false",
        swaccess:   "rw"
      }
    }
    // This window onto the entire message buffer is optionally included based on 'SWDirectMsgBuf'.
    // - Up to 1024 words of the message buffer may be accessed at a time, with any additional upper
    //   address bits being specified by the `BUFFER_CTRL.SW_ADDR_HI` register field.
    { skipto: "0x1000" },
    { window: {
        name:       "BUFFER",
        items:      "1024",
        validbits:  "32",
        byte-write: "true",
        unusual:    "false"
        swaccess:   "rw",
        desc:       '''Software-managed 4KiB message buffer used for transmitting and receiving messages.

                    This may be used diagnostically when the I3C Controller and/or Target(s) are enabled.
                    It may be employed as additional system RAM when the I3C block is completely disabled.
                    '''
      }
    }
  ]
}
