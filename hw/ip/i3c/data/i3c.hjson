    // ----- Target Transaction Interface 0xC8 (Extended Capability). -----
    // Nothing more than the possible existence of this Extended Capability is described
    // in the HCI specification. These registers follow a TTI defined for the OpenTitan
    // IP block, as specified in ../docs/tti.md.
    //
    // It supports a configurable number of Virtual Targets, up to a maximum given by
    // `MaxTargets`, with the first Virtual Target also assuming the role of Standby
    // Controller when the controller is not Active. Each VT supports Private Read and
    // Private Write transfers as well as the standardized Common Command Codes.
    { name:     "TTI_EXTCAP_HEADER",
      desc:     "Target Transaction Interface Extended Capability Header",
      swaccess: "ro",
      hwaccess: "hwo",
      hwext:    "true",
      fields: [
        { bits:   "23:8",
          name:   "CAP_LENGTH",
          desc:   "Capability Structure Length in DWORDs.",
          resval: "0x59"
        }
        { bits:   "7:0",
          name:   "CAP_ID",
          desc:   "Extended Capability ID",
          resval: "0xC8"
        }
      ]
    }
    { name:     "TARG_INTR_STATUS",
      desc:     "Target Interrupt Status.",
      swaccess: "ro",
      hwaccess: "hrw",
      fields: [
        { bits:     "31",
          name:     "TE_STAT",
          desc:     "Target Error Status.",
          resval:   "0"
        }
        { bits:     "19",
          name:     "TX3_DESC_READY_STAT",
          desc:     '''Target 3 Tx Descriptor Queue Ready Status.
                    Asserted when the Tx Descriptor Queue has at least the requested amount of space, see `TARG_TX_THLD_CTRL.TX_DESC_EMPTY_THLD`.
                    '''
          resval:   "0"
        }
        { bits:     "18",
