# waiver file for the CHERIoT memory subsystem

waive -rules {ONE_BIT_MEM_WIDTH} -location {cheriot.sv} -regexp {Memory 'tag_mux_in_tag_(h2d|d2h)' has word width which is single bit wide} \
      -comment "Connects to the unpacked one-bit tag sideband ports of cheriot_socket_m1."
waive -rules {ONE_BIT_MEM_WIDTH} -location {cheriot_trbe.sv} -regexp {Memory 'mover_tag_(h2d|d2h)' has word width which is single bit wide} \
      -comment "Connects to the unpacked one-bit tag sideband ports of cheriot_socket_m1."
