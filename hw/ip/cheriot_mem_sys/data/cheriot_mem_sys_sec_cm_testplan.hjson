// Security countermeasures testplan extracted from the IP Hjson using reggen.
//
// This testplan is auto-generated only the first time it is created. This is
// because this testplan needs to be hand-editable. It is possible that these
// testpoints can go out of date if the spec is updated with new
// countermeasures. When `reggen` is invoked when this testplan already exists,
// It checks if the list of testpoints is up-to-date and enforces the user to
// make further manual updates.
//
// These countermeasures and their descriptions can be found here:
// .../cheriot_mem_sys/data/cheriot_mem_sys.hjson
//
// It is possible that the testing of some of these countermeasures may already
// be covered as a testpoint in a different testplan. This duplication is ok -
// the test would have likely already been developed. We simply map those tests
// to the testpoints below using the `tests` key.
//
// Please ensure that this testplan is imported in:
// .../cheriot_mem_sys/data/cheriot_mem_sys_testplan.hjson
{
  testpoints: [
    {
      name: sec_cm_bus_integrity
      desc: '''
            Verify the countermeasure(s) BUS.INTEGRITY.

            Integrity faults on the register port, the meta SRAM responses, the revocation
            engine's reads and bitmap lookups, and the commands of capability stores to the NVM
            are detected and raise `fatal_fault` as documented. End-to-end protection also relies
            on LOGIC.SHADOW.
            '''
      stage: V2S
      tests: ["cheriot_mem_sys_tl_intg_err", "cheriot_mem_sys_err_csr_intg",
              "cheriot_mem_sys_err_meta_intg", "cheriot_mem_sys_err_tbre_read",
              "cheriot_mem_sys_err_tbre_revbm", "cheriot_mem_sys_err_cmd_intg"]
    }
    {
      name: sec_cm_logic_shadow
      desc: '''
            Verify the countermeasure(s) LOGIC.SHADOW.

            Not implemented yet (#30572). Once it is, a fault in either copy must raise
            `fatal_fault`. Until then, the trvk_fault testpoint shows what a single fault in the
            revocation engine's TRVK filter does.
            Corrupt an output of the main copy, or an input of the second copy while it is in use,
            for one cycle, and check that the lockstep comparison raises the `fatal_fault` alert.
            Assertions inside the second copy are disabled while it is corrupted. Without a
            corruption, including the cycles after reset, the alert must not fire.
            '''
      stage: V2S
      // The chip-level testpoint chip_sw_cheriot_mem_sys_lockstep_glitch is to cover this with
      // traffic on every port.
      tests: []
    }
    {
      name: sec_cm_tbre_config_shadow
      desc: "Verify the countermeasure(s) TBRE.CONFIG.SHADOW."
      stage: V2S
      tests: ["cheriot_mem_sys_shadow_reg_errors"]
    }
    {
      name: sec_cm_mem_sw_noaccess
      desc: '''
            Verify the countermeasure(s) MEM.SW_NOACCESS.

            Both bitmap ports and unmapped register offsets refuse every access to the tag regions,
            and the tags and the meta SRAM are unchanged afterwards.
            '''
      stage: V2S
      tests: ["cheriot_mem_sys_access_check"]
    }
    {
      name: sec_cm_intersig_mubi
      desc: '''
            Verify the countermeasure(s) INTERSIG.MUBI.

            All 15 `cheriot_ena_i` values other than MuBi4True select ePMP mode: no tag lookup, no
            meta SRAM access, starts ignored.
            '''
      stage: V2S
      tests: ["cheriot_mem_sys_mode_gating"]
    }
    {
      name: sec_cm_cored_tag_intersig_mubi
      desc: '''
            Verify the countermeasure(s) CORED_TAG.INTERSIG.MUBI.

            Corrupt the request tag of an untagged core data request to an invalid encoding, and
            check that it reads as untagged and raises the `fatal_fault` alert.
            '''
      stage: V2S
      // The chip-level testpoint chip_sw_cheriot_cored_tag_mubi covers the same at the top level.
      tests: ["cheriot_mem_sys_cored_tag_mubi"]
    }
    {
      name: sec_cm_cheriot_enable_ctrl_redun
      desc: '''
            Verify the countermeasure(s) CHERIOT_ENABLE.CTRL.REDUN.

            With SecLockstep set, drive `cheriot_ena_i` and `cheriot_ena_shadow_i` with different
            values, or one of them with an invalid value, while `cheriot_ena_cmp_i` is not
            MuBi4False, and check that the `fatal_fault` alert is raised. Also check that the
            enables as the mode switch in rv_core_ibex drives them raise no alert:
            `cheriot_ena_cmp_i` on from reset and off two cycles before `cheriot_ena_i` changes,
            the second copy's enable raised one cycle after the first copy's, and
            `cheriot_ena_cmp_i` on again after it.
            '''
      stage: V2S
      // The testbench ties the three enables to MuBi4False; this needs them driven.
      tests: []
    }
  ]
}
