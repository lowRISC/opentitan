// Security countermeasures testplan extracted from the IP Hjson using reggen.
//
// This testplan is auto-generated only the first time it is created. This is
// because this testplan needs to be hand-editable. It is possible that these
// testpoints can go out of date if the spec is updated with new
// countermeasures. When `reggen` is invoked when this testplan already exists,
// It checks if the list of testpoints is up-to-date and enforces the user to
// make further manual updates.
//
// These countermeasures and their descriptions can be found here:
// .../cheriot_mem_sys/data/cheriot_mem_sys.hjson
//
// It is possible that the testing of some of these countermeasures may already
// be covered as a testpoint in a different testplan. This duplication is ok -
// the test would have likely already been developed. We simply map those tests
// to the testpoints below using the `tests` key.
//
// Please ensure that this testplan is imported in:
// .../cheriot_mem_sys/data/cheriot_mem_sys_testplan.hjson
{
  testpoints: [
    {
      name: sec_cm_bus_integrity
      desc: "Verify the countermeasure(s) BUS.INTEGRITY."
      stage: V2S
      tests: []
    }
    {
      name: sec_cm_logic_shadow
      desc: '''
            Verify the countermeasure(s) LOGIC.SHADOW.

            Corrupt an output of the main copy, or an input of the second copy while it is in use,
            for one cycle, and check that the lockstep comparison raises the `fatal_fault` alert.
            Assertions inside the second copy are disabled while it is corrupted. Without a
            corruption, including the cycles after reset, the alert must not fire.
            '''
      stage: V2S
      // The chip-level testpoint chip_sw_cheriot_mem_sys_lockstep_glitch is to cover this with
      // traffic on every port.
      tests: []
    }
    {
      name: sec_cm_tbre_config_shadow
      desc: "Verify the countermeasure(s) TBRE.CONFIG.SHADOW."
      stage: V2S
      tests: ["cheriot_mem_sys_shadow_reg_errors"]
    }
    {
      name: sec_cm_mem_sw_noaccess
      desc: "Verify the countermeasure(s) MEM.SW_NOACCESS."
      stage: V2S
      tests: []
    }
    {
      name: sec_cm_intersig_mubi
      desc: "Verify the countermeasure(s) INTERSIG.MUBI."
      stage: V2S
      tests: []
    }
    {
      name: sec_cm_cored_tag_intersig_mubi
      desc: '''
            Verify the countermeasure(s) CORED_TAG.INTERSIG.MUBI.

            Corrupt the request tag of an untagged core data request to an invalid encoding, and
            check that it reads as untagged and raises the `fatal_fault` alert.
            '''
      stage: V2S
      // The core data port is not driven in this testbench, so the chip-level testpoint
      // chip_sw_cheriot_cored_tag_mubi is to cover this.
      tests: []
    }
  ]
}
