name: "lowrisc:fpv:otbn_mai_fpv:0.1"
description: "otbn_mai FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:prim:all
      # TODO: add more dependencies here if needed
      - lowrisc:ip:otbn
    files:
      - vip/otbn_mai_assert_fpv.sv
      - tb/otbn_mai_bind_fpv.sv
      - tb/otbn_mai_tb.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    # note, this setting is just used
    # to generate a file list for jg
    default_tool: icarus
    filesets:
      - files_formal
    toplevel: otbn_mai_tb

  formal:
    <<: *default_target

  lint:
    <<: *default_target
