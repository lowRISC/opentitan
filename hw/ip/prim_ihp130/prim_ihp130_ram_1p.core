name: "lowrisc:prim_ihp130:ram_1p"
description: "IHP130 single-port RAM"
virtual:
  - lowrisc:prim:ram_1p

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim_ihp130:ram_1p_pkg
    files:
      - rtl/prim_ram_1p.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
