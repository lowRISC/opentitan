name: "lowrisc:prim_ihp130:ram_1r1w"
description: "IHP130 1-read 1-write SRAM using 2P macros (A=write, B=read)"
virtual:
  - lowrisc:prim:ram_1r1w

filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim_ihp130:ram_1r1w_pkg
    files:
      - rtl/prim_ram_1r1w.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
