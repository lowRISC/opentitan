# NOTE: This is a placeholder while we get the flow working.
#       Eventually, it should be integrated properly into dvsim.

# Get directories (in a similar way to the ones used by dvsim)
the-makefile  := $(CURDIR)/$(word $(words $(MAKEFILE_LIST)),$(MAKEFILE_LIST))
src-dir       := $(dir $(the-makefile))
ot-top        := $(shell git -C $(src-dir) rev-parse --show-toplevel)
branch-name   := $(shell git -C $(src-dir) rev-parse --abbrev-ref HEAD)
rram-ctrl-dir := $(ot-top)/hw/ip/rram_ctrl
scratch       := $(ot-top)/scratch/$(branch-name)/rram_ctrl_formal

psgen-srcs  := $(wildcard $(src-dir)proofs/*.proof)
psgen-flags := -task -root rram_ctrl

# The name of the directory generated for the directory from lowrisc:ip:rram_ctrl
hw-fusesoc-dir-name := lowrisc_ip_rram_ctrl_0.1

# The path to the directory in which fusesoc writes files (in the rule that generates the .stamp file)
fusesoc-dir-path := $(scratch)/$(hw-fusesoc-dir-name)/default-vcs/

# The path to the .scr file that gets generated by fusesoc (in the rule that generates the .stamp file)
hw-scr-path := $(fusesoc-dir-path)/$(hw-fusesoc-dir-name).scr

# Generate an AND-Inverter-Graph representation of the design and the properties that are to be
# proven (from the RTL and the contents of $(psgen-srcs)).
.PHONY: aig
aig: $(scratch)/all.aig

.PHONY: clean
clean:
	rm -rf $(scratch)

$(scratch)/fusesoc.stamp: $(rram-ctrl-dir)/rtl
	mkdir -p $(@D)
	fusesoc                                   \
	  --cores-root $(ot-top)                  \
	  run                                     \
      --mapping=lowrisc:prim_generic:all:0.1  \
	  --build-root $(@D)                      \
	  --tool vcs                              \
	  --setup                                 \
	  lowrisc:ip:rram_ctrl
	touch $@

$(scratch)/psgen-yosys.svh: $(scratch)/fusesoc.stamp $(psgen-srcs)
	psgen $(addprefix -path ,$(psgen-srcs)) \
	      -root example                     \
	      -task                             \
	      -sv-out $@                        \
	      -clocking                         \
	      -covers                           \
	      -cover-assert                     \
	      -step-prefix

# Generate a simple awk script that interpolates @variable@ values
# from build-all.ys.in
$(scratch)/tpl.awk:
	mkdir -p $(scratch)
	echo '{' >$@
	echo '  gsub("#.*", "")' >>$@
	echo '  gsub("@fusesoc-dir@", "$(fusesoc-dir-path)")' >>$@
	echo '  gsub("@fusesoc-scr@", "$(hw-scr-path)")' >>$@
	echo '  gsub("@formal-src@", "$(rram-ctrl-dir)/dv/formal")' >>$@
	echo '  gsub("@build@", "$(scratch)")' >>$@
	echo '  print($$0)' >>$@
	echo '}' >>$@

# Apply the awk script to get a Yosys script with sensible paths
$(scratch)/build-all.ys: $(scratch)/tpl.awk build_all.ys.in
	awk -f $(scratch)/tpl.awk build_all.ys.in >$@ || rm -f $@

# The aiger file for the OSS flow
$(scratch)/all.aig: $(scratch)/psgen-yosys.svh $(scratch)/fusesoc.stamp $(scratch)/build-all.ys
	set -o pipefail;                            \
      yosys -m '$(LOWRISC_YOSYS_FORMAL_MODULE)' \
	        -m '$(YOSYS_SLANG_MODULE)'          \
	        -v 1                                \
	        -s <(cat $(scratch)/build-all.ys) 2>&1 | tee $(scratch)/yosys.log
