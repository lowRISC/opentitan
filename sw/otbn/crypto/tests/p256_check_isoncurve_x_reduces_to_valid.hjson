{
  "entrypoint": "p256_check_isoncurve",
  "input": {
    "dmem": {
      # x = p + 5: fits in 256 bits but x >= p, so it is not a valid field element.
      # However, x mod p = 5, and (5, y) IS a valid P-256 point.
      "x": "0xffffffff00000001000000000000000000000001000000000000000000000004"
      "y": "0x459243b9aa581806fe913bce99817ade11ca503c64d9a3c533415c083248fbcc"
      "ok": "0x00000739"  # HARDENED_TRUE
    }
  }
  "output": {
    "dmem": {
      "ok": "0x000001d4"  # HARDENED_FALSE
    }
  }
}
