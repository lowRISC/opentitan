{
  "entrypoint": "main",
  "input": {
    "dmem": {
      # Valid RSA-2048 modulus n = p*q (from rsa_2048_signature_functest).
      "rsa_n": ""
    }
  }
  "output": {
    "regs": {
      # HARDENED_BOOL_TRUE: composite and not a prime power.
      "x2": "0x00000739"
    }
  }
}
