{
    name: "uds_mldsa",

    variables: {
        // Creator MLDSA-44 UDS public key (1312 bytes).
        creator_pub_key_mldsa_44: {
            algorithm: "mldsa-44",
            type: "byte-array",
            exact-size: 1312,
        },
        // Creator MLDSA-44 UDS public key ID (20-byte ID matching CDI_0_MLDSA's AKI).
        creator_pub_key_id: {
            type: "byte-array",
            exact-size: 20,
            tweak-msb: true,
        },
        // Authority key ID (20-byte ID of the endorsing ECDSA P-256 CDI_1 key).
        auth_key_key_id: {
            type: "byte-array",
            exact-size: 20,
            tweak-msb: true,
        },
        // Optional raw ASN.1 DER private extension(s) (e.g., dice_tcb_info copied
        // from the factory P-256 UDS certificate).
        raw_private_extensions: {
            type: "byte-array",
            range-size: [0, 512],
        },
        // ECDSA P-256 signature components (r, s) produced by CDI_1.
        cert_signature_r: {
            type: "integer",
            range-size: [24, 32],
        },
        cert_signature_s: {
            type: "integer",
            range-size: [24, 32],
        },
    },

    certificate: {
        serial_number: { var: "creator_pub_key_id", convert: "big-endian" },
        issuer: [
            { serial_number: { var: "auth_key_key_id", convert: "lowercase-hex" } },
        ],
        subject: [
            { serial_number: { var: "creator_pub_key_id", convert: "lowercase-hex" } },
        ],
        // From the Open Profile for DICE specification:
        // https://pigweed.googlesource.com/open-dice/+/refs/heads/main/docs/specification.md#x_509-cdi-certificates
        not_before: "20180322235959Z",
        not_after: "99991231235959Z",
        subject_public_key_info: {
            algorithm: "mldsa-44",
            public_key: { var: "creator_pub_key_mldsa_44" },
        },
        authority_key_identifier: { var: "auth_key_key_id" },
        subject_key_identifier: { var: "creator_pub_key_id" },
        basic_constraints: { ca: true },
        key_usage: { cert_sign: true },
        private_extensions: { var: "raw_private_extensions" },
        signature: {
            algorithm: "ecdsa-with-sha256",
            value: {
                r: { var: "cert_signature_r" },
                s: { var: "cert_signature_s" },
            },
        },
    },
}
