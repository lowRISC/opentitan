{
  "includes": ["/__builtin__/hyperdebug_chipwhisperer.json5"],
  "interface": "hyper340",
  "pins": [
    // The HyperDebug SPI2 pins sit on the OT_IOB0/IOB3/IOB1 nets, which the chip's SPI_HOST1
    // drives. So SPI2 is of no use and we release the pins by default.
    {
      "name": "CN9_25",
      "mode": "Input"
    },
    {
      "name": "CN9_27",
      "mode": "Input"
    },
    {
      "name": "CN9_8",
      "mode": "Input"
    },
    // The HyperDebug UART3 TX sits on the OT_IOB4 net. This is the D2 of the SPI_HOST1. It must
    // not be driven by default. Tests that want to use ot_uart2 can apply the UART2_HOST_TX
    // strapping.
    {
      "name": "CN10_14",
      "mode": "Input"
    },
    {
      "name": "RESET",
      "mode": "OpenDrain",
      "pull_mode": "PullUp",
      "alias_of": "CN10_29"
    },
    {
      "name": "SPI_DEV_SCK",
      "mode": "Alternate",
      "alias_of": "CN10_24"
    },
    {
      "name": "SPI_DEV_D0",
      "mode": "Alternate",
      "alias_of": "CN10_23"
    },
    {
      "name": "SPI_DEV_D1",
      "mode": "Alternate",
      "alias_of": "CN10_10"
    },
    {
      "name": "SPI_TPM_SCK",
      "mode": "Input",
      "alias_of": "CN7_15"
    },
    {
      "name": "SPI_TPM_MOSI",
      "mode": "Input",
      "alias_of": "CN7_14"
    },
    {
      "name": "SPI_TPM_MISO",
      "mode": "Input",
      "alias_of": "CN7_12"
    },
    {
      "name": "SPI_TPM_CSB",
      "mode": "Alternate",
      "pull_mode": "PullUp",
      "alias_of": "IOA7"
    },
    {
      "name": "I2C_SCL",
      "mode": "Alternate",
      "pull_mode": "PullUp",
      "alias_of": "IOA8"
    },
    // The chip i2c1 runs on IOB11/IOB12, the HyperDebug I2C2 port.
    // TODO: The HyperDebug internal pull-up is the only pull on these nets. There is no pull up on
    //       the CW340.
    {
      "name": "IOB11",
      "mode": "Alternate",
      "pull_mode": "PullUp"
    },
    {
      "name": "IOB12",
      "mode": "Alternate",
      "pull_mode": "PullUp"
    }
  ],
  "strappings": [
    // Strapping to enable the HyperDebug UART3 TX connecting to ot_uart2.
    {
      "name": "UART2_HOST_TX",
      "pins": [
        {
          "name": "CN10_14",
          "mode": "Alternate"
        }
      ]
    },
    {
      "name": "SPI_TPM",
      "pins": [
        {
          "name": "SPI_DEV_SCK",
          "mode": "Input"
        },
        {
          "name": "SPI_DEV_D0",
          "mode": "Input"
        },
        {
          "name": "SPI_DEV_D1",
          "mode": "Input"
        },
        {
          "name": "SPI_TPM_SCK",
          "mode": "Alternate"
        },
        {
          "name": "SPI_TPM_MOSI",
          "mode": "Alternate"
        },
        {
          "name": "SPI_TPM_MISO",
          "mode": "Alternate"
        },
        {
          "name": "SPI_TPM_CSB",
          "mode": "PushPull"
        }
      ]
    }
  ],
  "spi": [
    {
      "name": "BOOTSTRAP",
      // The current speed accounts for increased bus capacitance caused by the external
      // SPI_TPM wires. If these wires are not connected (e.g., when skipping TPM tests),
      // the SPI speed can safely be increased to 5MHz.
      "bits_per_sec": 4000000,
      "chip_select": "CN10_6",
      "alias_of": "QSPI"
    }
  ],
  "clock_freqs": {  // Hz
    "main": 24000000, // 24e6
    "io": 24000000, // 24e6
    "io_div2": 12000000,  //12e6
    "io_div4": 6000000, //6e6
    "usb": 48000000,  // 48e6
    "aon": 250000,  // 250e3
  }
}
